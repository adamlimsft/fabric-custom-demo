// Southern Grid Transmission (Energy & utilities) - Dataflow Gen2 queries for the energy pack. Generated by tools/build_df.py.
// Dataflow 1 df_energy_reference: the business workbook -> lh_mdf.silver.ref_work_order_target
// Dataflow 2 df_energy_gold: Silver + targets -> lh_mdf.gold.work_order_target_compliance
// For each block: Get data > Blank query > Advanced editor, paste the block (header lines included is fine),
// then rename the query to the QUERY name. Create the blocks in the order they appear.

// ==============================================================================================================
// DATAFLOW 1: df_energy_reference   QUERY: ReferenceFileName   (parameter, Text)
// ==============================================================================================================
"energy.xlsx" meta [IsParameterQuery = true, IsParameterQueryRequired = true, Type = "Text"]

// ==============================================================================================================
// DATAFLOW 1: df_energy_reference   QUERY: ReferenceWorkbook   (helper, no destination)
// ==============================================================================================================
// The business workbook, embedded as Base64 so this dataflow needs no SharePoint, OneDrive, gateway or connection.
// To use the live file instead, see dataflows/README.md ("Point it at the live Excel file").
let
    Source = Binary.FromText("", BinaryEncoding.Base64),
    Workbook = Excel.Workbook(Source, null, true)
in
    Workbook

// ==============================================================================================================
// DATAFLOW 1: df_energy_reference   QUERY: ref_work_order_target   (output)
// Data destination: lh_mdf > silver > ref_work_order_target (Replace)
// ==============================================================================================================
// Cleans the business sheet: title rows, friendly headers, a TBC cell, a duplicate row and a footnote.
let
    Sheet = ReferenceWorkbook{[Item = "Targets", Kind = "Sheet"]}[Data],
    SkipTitle = Table.Skip(Sheet, each [Column2] <> "Code"),
    Promoted = Table.PromoteHeaders(SkipTitle, [PromoteAllScalars = true]),
    DataRows = Table.SelectRows(Promoted, each [Code] <> null and Text.Trim(Text.From([Code])) <> ""),
    Codes = Table.TransformColumns(DataRows, {{"Code", each Text.Upper(Text.Trim(Text.From(_))), type text}}),
    Deduped = Table.Distinct(Codes, {"Code"}),
    Target = Table.AddColumn(Deduped, "target_hours", each try Number.From([#"Target (hours)"]) otherwise null, type nullable number),
    Renamed = Table.RenameColumns(Target, {{"Code", "wo_type"}, {"Category", "category"}, {"Owner team", "owner_team"}}),
    Trimmed = Table.TransformColumns(Renamed, {{"category", each Text.Trim(Text.From(_)), type text}, {"owner_team", each Text.Trim(Text.From(_)), type text}}),
    WithSource = Table.AddColumn(Trimmed, "_source_file", each ReferenceFileName, type text),
    WithLoaded = Table.AddColumn(WithSource, "_loaded_at", each DateTimeZone.RemoveZone(DateTimeZone.UtcNow()), type datetime),
    Selected = Table.SelectColumns(WithLoaded, {"wo_type", "category", "target_hours", "owner_team", "_source_file", "_loaded_at"})
in
    Selected

// ==============================================================================================================
// DATAFLOW 2: df_energy_gold   QUERY: WorkspaceId   (parameter, Text)
// ==============================================================================================================
"00000000-0000-0000-0000-000000000000" meta [IsParameterQuery = true, IsParameterQueryRequired = true, Type = "Text"]

// ==============================================================================================================
// DATAFLOW 2: df_energy_gold   QUERY: LakehouseId   (parameter, Text)
// ==============================================================================================================
"00000000-0000-0000-0000-000000000000" meta [IsParameterQuery = true, IsParameterQueryRequired = true, Type = "Text"]

// ==============================================================================================================
// DATAFLOW 2: df_energy_gold   QUERY: AsAtDate   (parameter, Text yyyy-MM-dd)
// ==============================================================================================================
"2026-11-04" meta [IsParameterQuery = true, IsParameterQueryRequired = true, Type = "Text"]

// ==============================================================================================================
// DATAFLOW 2: df_energy_gold   QUERY: fnLakehouseTable   (helper function, no destination)
// ==============================================================================================================
// Reads a table from lakehouse lh_mdf. Tries schema navigation first (silver.x / gold.x), then two fallbacks.
// If your tenant navigates differently, replace the body with the steps Get data > Lakehouse writes for you.
(schemaName as text, tableName as text) as table =>
    let
        Root = Lakehouse.Contents([HierarchicalNavigation = true]),
        LakehouseNav = Root{[workspaceId = WorkspaceId]}[Data]{[lakehouseId = LakehouseId]}[Data],
        BySchema = try LakehouseNav{[Id = schemaName, ItemKind = "Schema"]}[Data]{[Id = tableName, ItemKind = "Table"]}[Data] otherwise null,
        ByDottedId = try LakehouseNav{[Id = schemaName & "." & tableName, ItemKind = "Table"]}[Data] otherwise null,
        ByName = try Table.SelectRows(LakehouseNav, each [Name] = tableName){0}[Data] otherwise null,
        Result =
            if BySchema <> null then BySchema
            else if ByDottedId <> null then ByDottedId
            else if ByName <> null then ByName
            else error Error.Record("TableNotFound", "Lakehouse table not found - check WorkspaceId and LakehouseId, or re-pick the table with Get data", schemaName & "." & tableName)
    in
        Result

// ==============================================================================================================
// DATAFLOW 2: df_energy_gold   QUERY: work_order_target_compliance   (output)
// Data destination: lh_mdf > gold > work_order_target_compliance (Replace)
// ==============================================================================================================
// One row per work order with its target and status as at AsAtDate: met_target, breached, open_overdue,
// open_within_target or no_target. Cancelled and deleted work orders are left out.
let
    AsAt = Date.FromText(AsAtDate, [Format = "yyyy-MM-dd", Culture = "en-AU"]),
    AsAtEnd = DateTime.From(Date.AddDays(AsAt, 1)),
    Events = fnLakehouseTable("silver", "work_order"),
    Live = Table.SelectRows(Events, each [_is_deleted] = false and [status] <> "CANCELLED"),
    Columns = Table.SelectColumns(Live, {"wo_id", "asset_id", "wo_type", "priority", "status", "raised_ts", "completed_ts"}),
    Stamps = Table.TransformColumns(Columns, {{"raised_ts", each if _ = null then null else DateTime.From(_), type nullable datetime}, {"completed_ts", each if _ = null then null else DateTime.From(_), type nullable datetime}}),
    InScope = Table.SelectRows(Stamps, each [raised_ts] <> null and [raised_ts] < AsAtEnd),
    Register = Table.SelectRows(fnLakehouseTable("silver", "asset"), each [_is_current] = true),
    Entities = Table.SelectColumns(Register, {"asset_id", "asset_name", "region"}),
    WithEntity = Table.ExpandTableColumn(Table.NestedJoin(InScope, {"asset_id"}, Entities, {"asset_id"}, "e", JoinKind.LeftOuter), "e", {"asset_name", "region"}),
    Targets = Table.SelectColumns(fnLakehouseTable("silver", "ref_work_order_target"), {"wo_type", "category", "target_hours", "owner_team"}),
    WithTarget = Table.ExpandTableColumn(Table.NestedJoin(WithEntity, {"wo_type"}, Targets, {"wo_type"}, "t", JoinKind.LeftOuter), "t", {"category", "target_hours", "owner_team"}),
    OpenFlag = Table.AddColumn(WithTarget, "is_open", each [completed_ts] = null or [completed_ts] >= AsAtEnd, type logical),
    Hours = Table.AddColumn(OpenFlag, "hours_to_close", each Number.Round(Duration.TotalHours((if [is_open] then AsAtEnd else [completed_ts]) - [raised_ts]), 2), type number),
    Status = Table.AddColumn(Hours, "compliance_status", each
        if [target_hours] = null then "no_target"
        else if [is_open] then (if [hours_to_close] > [target_hours] then "open_overdue" else "open_within_target")
        else if [hours_to_close] <= [target_hours] then "met_target"
        else "breached", type text),
    Over = Table.AddColumn(Status, "hours_over_target", each if [target_hours] = null then null else Number.Round(List.Max({0, [hours_to_close] - [target_hours]}), 2), type nullable number),
    Stamped = Table.AddColumn(Over, "as_at_date", each AsAt, type date),
    Typed = Table.TransformColumnTypes(Stamped, {{"wo_id", Int64.Type}, {"asset_id", Int64.Type}, {"priority", Int64.Type}, {"target_hours", type nullable number}})
in
    Typed
