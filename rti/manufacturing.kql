// Kestrel Components (Manufacturing) - Real-Time Intelligence, pack 'manufacturing'
// Eventhouse eh_mdf_rt, KQL database eh_mdf_rt. Generated by tools/build_rti.py - edit the builder, not this file.
// Streams: machine_telemetry -> MachineTelemetry, machine_alarm -> MachineAlarm (both land in RawEvents first).
// Primary metric: vibration_mm_s (vibration, mm/s), threshold 7.1, fault value 999.9.
// Run the sections in order. Blocks are separated by blank lines: put the cursor in a block and Run
// (Shift+Enter). Every command is safe to re-run.

// 1. TABLES AND UPDATE POLICIES
// RawEvents is the streaming Bronze: every event as received, kept for 7 days (replayable from the stream).
// Update policies split it into typed tables at ingestion time - no pipeline, no notebook.

.create-merge table RawEvents (payload: dynamic)

.create-or-alter table RawEvents ingestion json mapping 'RawEventsMapping' '[{"column":"payload","Properties":{"Path":"$"}}]'

.alter-merge table RawEvents policy retention softdelete = 7d recoverability = disabled

.create-merge table MachineTelemetry (event_ts: datetime, machine_id: int, plant: string, vibration_mm_s: real, units_produced: real, motor_temp_c: real, ingested_at: datetime)

.alter table MachineTelemetry policy caching hot = 31d

.alter-merge table MachineTelemetry policy retention softdelete = 365d

.create-merge table MachineAlarm (event_ts: datetime, alert_id: string, machine_id: int, plant: string, alert_code: string, severity: string, message: string, ingested_at: datetime)

.alter table MachineAlarm policy caching hot = 31d

.alter-merge table MachineAlarm policy retention softdelete = 365d

.create-or-alter function with (folder = 'parse', docstring = 'RawEvents -> MachineTelemetry') ParseMachineTelemetry()
{
    RawEvents
    | where tostring(payload['event_type']) == 'machine_telemetry'
    | project event_ts = todatetime(payload['event_ts']),
        machine_id = toint(payload['machine_id']),
        plant = tostring(payload['plant']),
        vibration_mm_s = toreal(payload['vibration_mm_s']),
        units_produced = toreal(payload['units_produced']),
        motor_temp_c = toreal(payload['motor_temp_c']),
        ingested_at = now()
}

.alter table MachineTelemetry policy update @'[{"IsEnabled": true, "Source": "RawEvents", "Query": "ParseMachineTelemetry()", "IsTransactional": false, "PropagateIngestionProperties": false}]'

.create-or-alter function with (folder = 'parse', docstring = 'RawEvents -> MachineAlarm') ParseMachineAlarm()
{
    RawEvents
    | where tostring(payload['event_type']) == 'machine_alarm'
    | project event_ts = todatetime(payload['event_ts']),
        alert_id = tostring(payload['alert_id']),
        machine_id = toint(payload['machine_id']),
        plant = tostring(payload['plant']),
        alert_code = tostring(payload['alert_code']),
        severity = tostring(payload['severity']),
        message = tostring(payload['message']),
        ingested_at = now()
}

.alter table MachineAlarm policy update @'[{"IsEnabled": true, "Source": "RawEvents", "Query": "ParseMachineAlarm()", "IsTransactional": false, "PropagateIngestionProperties": false}]'

// 2. MATERIALIZED VIEWS
// Kept current by the engine. Backfill needs the async form; ifnotexists makes re-runs safe.
// MachineTelemetryLatest: the newest reading per machine - the 'where is everything now' table.
// MachineTelemetry5m: 5-minute aggregates (fault values excluded). MachineAlarm5m: alert counts per 5 minutes.

.create async ifnotexists materialized-view with (backfill = true, folder = 'views') MachineTelemetryLatest on table MachineTelemetry
{
    MachineTelemetry
    | summarize arg_max(event_ts, plant, vibration_mm_s, units_produced, motor_temp_c, ingested_at) by machine_id
}

.create async ifnotexists materialized-view with (backfill = true, folder = 'views') MachineTelemetry5m on table MachineTelemetry
{
    MachineTelemetry
    | where vibration_mm_s between (0.0 .. 50.0)
    | summarize readings = count(), avg_vibration_mm_s = avg(vibration_mm_s), max_vibration_mm_s = max(vibration_mm_s), min_vibration_mm_s = min(vibration_mm_s),
        avg_units_produced = avg(units_produced), avg_motor_temp_c = avg(motor_temp_c), breach_readings = countif(vibration_mm_s > 7.1)
        by machine_id, plant, window_start = bin(event_ts, 5m)
}

.create async ifnotexists materialized-view with (backfill = true, folder = 'views') MachineAlarm5m on table MachineAlarm
{
    MachineAlarm
    | summarize alerts = count(), critical = countif(severity == 'CRITICAL')
        by plant, alert_code, window_start = bin(event_ts, 5m)
}

// 3. DETECTION FUNCTIONS
// Every function anchors on the newest event, not now(), so it works on a live stream and on an uploaded
// sample file. For live operations call them with a short lookback, e.g. MachineTelemetryBreaches(30m).
// Fault values (999.9) and anything outside 0..50 mm/s are excluded from the breach, frozen and anomaly checks.

.create-or-alter function with (folder = 'detect', docstring = 'Vibration above the threshold') MachineTelemetryBreaches(lookback: timespan = 6h, threshold: real = real(7.1))
{
    let _end = toscalar(MachineTelemetry | summarize max(event_ts));
    MachineTelemetry
    | where event_ts > _end - lookback
    | where vibration_mm_s between (0.0 .. 50.0) and vibration_mm_s > threshold
    | summarize first_seen = min(event_ts), last_seen = max(event_ts), breach_readings = count(),
        peak_vibration_mm_s = max(vibration_mm_s) by machine_id, plant
    | order by peak_vibration_mm_s desc
}

.create-or-alter function with (folder = 'detect', docstring = 'Stuck sensors: no variation in vibration_mm_s across a window') MachineTelemetryFrozen(lookback: timespan = 6h, window: timespan = 30m)
{
    let _end = toscalar(MachineTelemetry | summarize max(event_ts));
    MachineTelemetry
    | where event_ts > _end - lookback
    | where vibration_mm_s between (0.0 .. 50.0)
    | summarize readings = count(), sd = stdev(vibration_mm_s), stuck_value = avg(vibration_mm_s)
        by machine_id, plant, window_start = bin(event_ts, window)
    | where readings >= toint(window / 1m * 2 / 3) and sd < 0.001
    | summarize first_window = min(window_start), last_window = max(window_start), frozen_windows = count(),
        stuck_value = take_any(stuck_value) by machine_id, plant
}

.create-or-alter function with (folder = 'detect', docstring = 'Bursts of machine alarms in one plant') MachineAlarmBursts(lookback: timespan = 6h, window: timespan = 10m, min_alerts: int = 5)
{
    let _end = toscalar(MachineAlarm | summarize max(event_ts));
    MachineAlarm
    | where event_ts > _end - lookback
    | summarize alerts = count(), machines = dcount(machine_id), codes = make_set(alert_code)
        by plant, window_start = bin(event_ts, window)
    | where alerts >= min_alerts
    | order by window_start desc
}

.create-or-alter function with (folder = 'detect', docstring = 'Spikes in vibration_mm_s against each machine baseline') MachineTelemetryAnomalies(lookback: timespan = 6h, sensitivity: real = 3.0)
{
    let _end = toscalar(MachineTelemetry | summarize max(event_ts));
    let _start = _end - lookback;
    MachineTelemetry
    | where event_ts between (_start .. _end)
    | where vibration_mm_s between (0.0 .. 50.0)
    | make-series v = avg(vibration_mm_s) default = real(null) on event_ts from bin(_start, 1m) to _end + 1m step 1m by machine_id
    | extend v = series_fill_linear(v)
    | extend (flag, score, baseline) = series_decompose_anomalies(v, sensitivity, -1, 'linefit')
    | mv-expand event_ts to typeof(datetime), v to typeof(real), flag to typeof(int), score to typeof(real),
        baseline to typeof(real)
    | where flag == 1
    | project machine_id, event_ts, vibration_mm_s = round(v, 2), baseline = round(baseline, 2), score = round(score, 2)
}

.create-or-alter function with (folder = 'detect', docstring = 'Fault values and out-of-range readings') MachineTelemetryFaults(lookback: timespan = 6h)
{
    let _end = toscalar(MachineTelemetry | summarize max(event_ts));
    MachineTelemetry
    | where event_ts > _end - lookback
    | where isnull(vibration_mm_s) or vibration_mm_s == real(999.9) or not(vibration_mm_s between (0.0 .. 50.0))
    | summarize fault_readings = count(), first_seen = min(event_ts), last_seen = max(event_ts),
        fault_values = make_set(vibration_mm_s) by machine_id, plant
}

.create-or-alter function with (folder = 'detect', docstring = 'No reading for longer than the gap') MachineTelemetrySilent(gap: timespan = 10m)
{
    let _end = toscalar(MachineTelemetry | summarize max(event_ts));
    MachineTelemetryLatest
    | where event_ts < _end - gap
    | project machine_id, plant, last_reading = event_ts, silent_for = _end - event_ts
}

// Optional: join to Gold. In the KQL database add a OneLake shortcut to lh_mdf > Tables > gold > dim_machine
// (keep the name). skipvalidation lets you create the function before the shortcut exists.

.create-or-alter function with (folder = 'detect', docstring = 'Breaches with machine details from Gold', skipvalidation = 'true') MachineTelemetryBreachesWithContext(lookback: timespan = 6h)
{
    MachineTelemetryBreaches(lookback)
    | lookup kind = leftouter (external_table('dim_machine')
        | project machine_id = toint(machine_id), machine_code, machine_name, machine_type, criticality) on machine_id
}

// 4. REAL-TIME DASHBOARD TILES
// One query per tile; the suggested visual is in brackets. Auto-refresh 30 s (or Continuous).
// Tiles anchor on the newest event so they also work on an uploaded sample file.
// The latency tile only shows data while events are streaming.

// ---- Tile: Machines now by status (table)
MachineTelemetryLatest
| extend status_now = case(not(vibration_mm_s between (0.0 .. 50.0)), 'FAULT', vibration_mm_s > 7.1, 'BREACH', vibration_mm_s > 5.54, 'WATCH', 'NORMAL')
| summarize machines = count() by status_now, plant
| order by status_now asc

// ---- Tile: Vibration, top 5 machines (line chart)
let _end = toscalar(MachineTelemetry | summarize max(event_ts));
let top5 = MachineTelemetry5m | where window_start > _end - 6h | summarize peak = max(max_vibration_mm_s) by machine_id | top 5 by peak | project machine_id;
MachineTelemetry5m
| where window_start > _end - 6h and machine_id in (top5)
| project window_start, machine_id = tostring(machine_id), max_vibration_mm_s

// ---- Tile: Threshold breaches - vibration above 7.1 mm/s (table)
MachineTelemetryBreaches()

// ---- Tile: Anomalies against baseline (table)
MachineTelemetryAnomalies()
| summarize first_seen = min(event_ts), last_seen = max(event_ts), peak = max(vibration_mm_s), points = count() by machine_id

// ---- Tile: Frozen sensors (table)
MachineTelemetryFrozen()

// ---- Tile: Fault values (table)
MachineTelemetryFaults()

// ---- Tile: Machine alarms by plant, 10-minute bins (column chart)
let _end = toscalar(MachineAlarm | summarize max(event_ts));
MachineAlarm5m
| where window_start > _end - 6h
| summarize alerts = sum(alerts) by plant, window_start = bin(window_start, 10m)

// ---- Tile: Alert bursts - line stoppage (table)
MachineAlarmBursts()

// ---- Tile: Average units produced by plant, 5 minutes (line chart)
let _end = toscalar(MachineTelemetry | summarize max(event_ts));
MachineTelemetry5m
| where window_start > _end - 6h
| summarize avg_units_produced = round(avg(avg_units_produced), 2) by plant, window_start

// ---- Tile: Ingestion latency p95, seconds (stat)
MachineTelemetry
| where ingested_at > ago(15m)
| summarize p95_latency_s = percentile((ingested_at - event_ts) / 1s, 95)

// 5. ACTIVATOR RULE SUGGESTIONS (create in Activator - not KQL commands)
// Create them from a dashboard tile (Set alert) or from an Eventstream destination.
//
// Rule: Vibration breach
//   Monitor:   MachineTelemetry (Eventstream route to Activator, or the MachineTelemetryBreaches dashboard tile)
//   Condition: vibration_mm_s > 7.1 for 3 consecutive readings per machine_id
//   Action:    Teams message to Manufacturing Engineering; optional Power Automate flow to log a follow-up
//
// Rule: Critical machine alarm
//   Monitor:   MachineAlarm
//   Condition: severity == 'CRITICAL' (codes: OVER_TEMP, E_STOP, JAM)
//   Action:    Email and Teams to the on-call lead for the plant
//
// Rule: Line stoppage
//   Monitor:   MachineAlarmBursts() dashboard tile (Set alert)
//   Condition: alerts >= 5 in 10 minutes for one plant
//   Action:    Teams post to the Manufacturing Engineering channel
//
// Rule: Stuck or faulty sensor
//   Monitor:   MachineTelemetryFrozen() and MachineTelemetryFaults() tiles
//   Condition: any row returned
//   Action:    Teams message to the telemetry support team
//
// Rule: Telemetry stopped
//   Monitor:   MachineTelemetryLatest (or MachineTelemetrySilent())
//   Condition: no new reading for 10 minutes per machine_id
//   Action:    Teams message to the telemetry support team
