// Wattle & Co (Retail) - Real-Time Intelligence, pack 'retail'
// Eventhouse eh_mdf_rt, KQL database eh_mdf_rt. Generated by tools/build_rti.py - edit the builder, not this file.
// Streams: store_trading -> StoreTrading, store_alert -> StoreAlert (both land in RawEvents first).
// Primary metric: out_of_stock_pct (out-of-stock lines, %), threshold 8, fault value 999.9.
// Run the sections in order. Blocks are separated by blank lines: put the cursor in a block and Run
// (Shift+Enter). Every command is safe to re-run.

// 1. TABLES AND UPDATE POLICIES
// RawEvents is the streaming Bronze: every event as received, kept for 7 days (replayable from the stream).
// Update policies split it into typed tables at ingestion time - no pipeline, no notebook.

.create-merge table RawEvents (payload: dynamic)

.create-or-alter table RawEvents ingestion json mapping 'RawEventsMapping' '[{"column":"payload","Properties":{"Path":"$"}}]'

.alter-merge table RawEvents policy retention softdelete = 7d recoverability = disabled

.create-merge table StoreTrading (event_ts: datetime, store_id: int, state: string, out_of_stock_pct: real, sales_aud: real, footfall: real, ingested_at: datetime)

.alter table StoreTrading policy caching hot = 31d

.alter-merge table StoreTrading policy retention softdelete = 365d

.create-merge table StoreAlert (event_ts: datetime, alert_id: string, store_id: int, state: string, alert_code: string, severity: string, message: string, ingested_at: datetime)

.alter table StoreAlert policy caching hot = 31d

.alter-merge table StoreAlert policy retention softdelete = 365d

.create-or-alter function with (folder = 'parse', docstring = 'RawEvents -> StoreTrading') ParseStoreTrading()
{
    RawEvents
    | where tostring(payload['event_type']) == 'store_trading'
    | project event_ts = todatetime(payload['event_ts']),
        store_id = toint(payload['store_id']),
        state = tostring(payload['state']),
        out_of_stock_pct = toreal(payload['out_of_stock_pct']),
        sales_aud = toreal(payload['sales_aud']),
        footfall = toreal(payload['footfall']),
        ingested_at = now()
}

.alter table StoreTrading policy update @'[{"IsEnabled": true, "Source": "RawEvents", "Query": "ParseStoreTrading()", "IsTransactional": false, "PropagateIngestionProperties": false}]'

.create-or-alter function with (folder = 'parse', docstring = 'RawEvents -> StoreAlert') ParseStoreAlert()
{
    RawEvents
    | where tostring(payload['event_type']) == 'store_alert'
    | project event_ts = todatetime(payload['event_ts']),
        alert_id = tostring(payload['alert_id']),
        store_id = toint(payload['store_id']),
        state = tostring(payload['state']),
        alert_code = tostring(payload['alert_code']),
        severity = tostring(payload['severity']),
        message = tostring(payload['message']),
        ingested_at = now()
}

.alter table StoreAlert policy update @'[{"IsEnabled": true, "Source": "RawEvents", "Query": "ParseStoreAlert()", "IsTransactional": false, "PropagateIngestionProperties": false}]'

// 2. MATERIALIZED VIEWS
// Kept current by the engine. Backfill needs the async form; ifnotexists makes re-runs safe.
// StoreTradingLatest: the newest reading per store - the 'where is everything now' table.
// StoreTrading5m: 5-minute aggregates (fault values excluded). StoreAlert5m: alert counts per 5 minutes.

.create async ifnotexists materialized-view with (backfill = true, folder = 'views') StoreTradingLatest on table StoreTrading
{
    StoreTrading
    | summarize arg_max(event_ts, state, out_of_stock_pct, sales_aud, footfall, ingested_at) by store_id
}

.create async ifnotexists materialized-view with (backfill = true, folder = 'views') StoreTrading5m on table StoreTrading
{
    StoreTrading
    | where out_of_stock_pct between (0.0 .. 100.0)
    | summarize readings = count(), avg_out_of_stock_pct = avg(out_of_stock_pct), max_out_of_stock_pct = max(out_of_stock_pct), min_out_of_stock_pct = min(out_of_stock_pct),
        avg_sales_aud = avg(sales_aud), avg_footfall = avg(footfall), breach_readings = countif(out_of_stock_pct > 8.0)
        by store_id, state, window_start = bin(event_ts, 5m)
}

.create async ifnotexists materialized-view with (backfill = true, folder = 'views') StoreAlert5m on table StoreAlert
{
    StoreAlert
    | summarize alerts = count(), critical = countif(severity == 'CRITICAL')
        by state, alert_code, window_start = bin(event_ts, 5m)
}

// 3. DETECTION FUNCTIONS
// Every function anchors on the newest event, not now(), so it works on a live stream and on an uploaded
// sample file. For live operations call them with a short lookback, e.g. StoreTradingBreaches(30m).
// Fault values (999.9) and anything outside 0..100 % are excluded from the breach, frozen and anomaly checks.

.create-or-alter function with (folder = 'detect', docstring = 'Out-of-stock lines above the threshold') StoreTradingBreaches(lookback: timespan = 6h, threshold: real = real(8.0))
{
    let _end = toscalar(StoreTrading | summarize max(event_ts));
    StoreTrading
    | where event_ts > _end - lookback
    | where out_of_stock_pct between (0.0 .. 100.0) and out_of_stock_pct > threshold
    | summarize first_seen = min(event_ts), last_seen = max(event_ts), breach_readings = count(),
        peak_out_of_stock_pct = max(out_of_stock_pct) by store_id, state
    | order by peak_out_of_stock_pct desc
}

.create-or-alter function with (folder = 'detect', docstring = 'Stuck sensors: no variation in out_of_stock_pct across a window') StoreTradingFrozen(lookback: timespan = 6h, window: timespan = 30m)
{
    let _end = toscalar(StoreTrading | summarize max(event_ts));
    StoreTrading
    | where event_ts > _end - lookback
    | where out_of_stock_pct between (0.0 .. 100.0)
    | summarize readings = count(), sd = stdev(out_of_stock_pct), stuck_value = avg(out_of_stock_pct)
        by store_id, state, window_start = bin(event_ts, window)
    | where readings >= toint(window / 1m * 2 / 3) and sd < 0.001
    | summarize first_window = min(window_start), last_window = max(window_start), frozen_windows = count(),
        stuck_value = take_any(stuck_value) by store_id, state
}

.create-or-alter function with (folder = 'detect', docstring = 'Bursts of store alerts in one state') StoreAlertBursts(lookback: timespan = 6h, window: timespan = 10m, min_alerts: int = 5)
{
    let _end = toscalar(StoreAlert | summarize max(event_ts));
    StoreAlert
    | where event_ts > _end - lookback
    | summarize alerts = count(), stores = dcount(store_id), codes = make_set(alert_code)
        by state, window_start = bin(event_ts, window)
    | where alerts >= min_alerts
    | order by window_start desc
}

.create-or-alter function with (folder = 'detect', docstring = 'Spikes in out_of_stock_pct against each store baseline') StoreTradingAnomalies(lookback: timespan = 6h, sensitivity: real = 3.0)
{
    let _end = toscalar(StoreTrading | summarize max(event_ts));
    let _start = _end - lookback;
    StoreTrading
    | where event_ts between (_start .. _end)
    | where out_of_stock_pct between (0.0 .. 100.0)
    | make-series v = avg(out_of_stock_pct) default = real(null) on event_ts from bin(_start, 1m) to _end + 1m step 1m by store_id
    | extend v = series_fill_linear(v)
    | extend (flag, score, baseline) = series_decompose_anomalies(v, sensitivity, -1, 'linefit')
    | mv-expand event_ts to typeof(datetime), v to typeof(real), flag to typeof(int), score to typeof(real),
        baseline to typeof(real)
    | where flag == 1
    | project store_id, event_ts, out_of_stock_pct = round(v, 2), baseline = round(baseline, 2), score = round(score, 2)
}

.create-or-alter function with (folder = 'detect', docstring = 'Fault values and out-of-range readings') StoreTradingFaults(lookback: timespan = 6h)
{
    let _end = toscalar(StoreTrading | summarize max(event_ts));
    StoreTrading
    | where event_ts > _end - lookback
    | where isnull(out_of_stock_pct) or out_of_stock_pct == real(999.9) or not(out_of_stock_pct between (0.0 .. 100.0))
    | summarize fault_readings = count(), first_seen = min(event_ts), last_seen = max(event_ts),
        fault_values = make_set(out_of_stock_pct) by store_id, state
}

.create-or-alter function with (folder = 'detect', docstring = 'No reading for longer than the gap') StoreTradingSilent(gap: timespan = 10m)
{
    let _end = toscalar(StoreTrading | summarize max(event_ts));
    StoreTradingLatest
    | where event_ts < _end - gap
    | project store_id, state, last_reading = event_ts, silent_for = _end - event_ts
}

// Optional: join to Gold. In the KQL database add a OneLake shortcut to lh_mdf > Tables > gold > dim_store
// (keep the name). skipvalidation lets you create the function before the shortcut exists.

.create-or-alter function with (folder = 'detect', docstring = 'Breaches with store details from Gold', skipvalidation = 'true') StoreTradingBreachesWithContext(lookback: timespan = 6h)
{
    StoreTradingBreaches(lookback)
    | lookup kind = leftouter (external_table('dim_store')
        | project store_id = toint(store_id), store_code, store_name, store_format, store_tier) on store_id
}

// 4. REAL-TIME DASHBOARD TILES
// One query per tile; the suggested visual is in brackets. Auto-refresh 30 s (or Continuous).
// Tiles anchor on the newest event so they also work on an uploaded sample file.
// The latency tile only shows data while events are streaming.

// ---- Tile: Stores now by status (table)
StoreTradingLatest
| extend status_now = case(not(out_of_stock_pct between (0.0 .. 100.0)), 'FAULT', out_of_stock_pct > 8.0, 'BREACH', out_of_stock_pct > 6.0, 'WATCH', 'NORMAL')
| summarize stores = count() by status_now, state
| order by status_now asc

// ---- Tile: Out-of-stock lines, top 5 stores (line chart)
let _end = toscalar(StoreTrading | summarize max(event_ts));
let top5 = StoreTrading5m | where window_start > _end - 6h | summarize peak = max(max_out_of_stock_pct) by store_id | top 5 by peak | project store_id;
StoreTrading5m
| where window_start > _end - 6h and store_id in (top5)
| project window_start, store_id = tostring(store_id), max_out_of_stock_pct

// ---- Tile: Threshold breaches - out-of-stock lines above 8 % (table)
StoreTradingBreaches()

// ---- Tile: Anomalies against baseline (table)
StoreTradingAnomalies()
| summarize first_seen = min(event_ts), last_seen = max(event_ts), peak = max(out_of_stock_pct), points = count() by store_id

// ---- Tile: Frozen sensors (table)
StoreTradingFrozen()

// ---- Tile: Fault values (table)
StoreTradingFaults()

// ---- Tile: Store alerts by state, 10-minute bins (column chart)
let _end = toscalar(StoreAlert | summarize max(event_ts));
StoreAlert5m
| where window_start > _end - 6h
| summarize alerts = sum(alerts) by state, window_start = bin(window_start, 10m)

// ---- Tile: Alert bursts - half-price promo rush (table)
StoreAlertBursts()

// ---- Tile: Average sales by state, 5 minutes (line chart)
let _end = toscalar(StoreTrading | summarize max(event_ts));
StoreTrading5m
| where window_start > _end - 6h
| summarize avg_sales_aud = round(avg(avg_sales_aud), 2) by state, window_start

// ---- Tile: Ingestion latency p95, seconds (stat)
StoreTrading
| where ingested_at > ago(15m)
| summarize p95_latency_s = percentile((ingested_at - event_ts) / 1s, 95)

// 5. ACTIVATOR RULE SUGGESTIONS (create in Activator - not KQL commands)
// Create them from a dashboard tile (Set alert) or from an Eventstream destination.
//
// Rule: Out-of-stock lines breach
//   Monitor:   StoreTrading (Eventstream route to Activator, or the StoreTradingBreaches dashboard tile)
//   Condition: out_of_stock_pct > 8 for 3 consecutive readings per store_id
//   Action:    Teams message to Store Operations; optional Power Automate flow to log a follow-up
//
// Rule: Critical store alert
//   Monitor:   StoreAlert
//   Condition: severity == 'CRITICAL' (codes: OUT_OF_STOCK_SPIKE, FREEZER_FAULT, TILL_OFFLINE)
//   Action:    Email and Teams to the on-call lead for the state
//
// Rule: Half-price promo rush
//   Monitor:   StoreAlertBursts() dashboard tile (Set alert)
//   Condition: alerts >= 5 in 10 minutes for one state
//   Action:    Teams post to the Store Operations channel
//
// Rule: Stuck or faulty sensor
//   Monitor:   StoreTradingFrozen() and StoreTradingFaults() tiles
//   Condition: any row returned
//   Action:    Teams message to the telemetry support team
//
// Rule: Telemetry stopped
//   Monitor:   StoreTradingLatest (or StoreTradingSilent())
//   Condition: no new reading for 10 minutes per store_id
//   Action:    Teams message to the telemetry support team
