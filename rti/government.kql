// Riverbend Regional Authority (Government) - Real-Time Intelligence, pack 'government'
// Eventhouse eh_mdf_rt, KQL database eh_mdf_rt. Generated by tools/build_rti.py - edit the builder, not this file.
// Streams: sensor_reading -> SensorReading, sensor_alert -> SensorAlert (both land in RawEvents first).
// Primary metric: water_level_cm (water level, cm), threshold 150, fault value 999.9.
// Run the sections in order. Blocks are separated by blank lines: put the cursor in a block and Run
// (Shift+Enter). Every command is safe to re-run.

// 1. TABLES AND UPDATE POLICIES
// RawEvents is the streaming Bronze: every event as received, kept for 7 days (replayable from the stream).
// Update policies split it into typed tables at ingestion time - no pipeline, no notebook.

.create-merge table RawEvents (payload: dynamic)

.create-or-alter table RawEvents ingestion json mapping 'RawEventsMapping' '[{"column":"payload","Properties":{"Path":"$"}}]'

.alter-merge table RawEvents policy retention softdelete = 7d recoverability = disabled

.create-merge table SensorReading (event_ts: datetime, asset_id: int, district: string, water_level_cm: real, traffic_count: real, pm25_ugm3: real, ingested_at: datetime)

.alter table SensorReading policy caching hot = 31d

.alter-merge table SensorReading policy retention softdelete = 365d

.create-merge table SensorAlert (event_ts: datetime, alert_id: string, asset_id: int, district: string, alert_code: string, severity: string, message: string, ingested_at: datetime)

.alter table SensorAlert policy caching hot = 31d

.alter-merge table SensorAlert policy retention softdelete = 365d

.create-or-alter function with (folder = 'parse', docstring = 'RawEvents -> SensorReading') ParseSensorReading()
{
    RawEvents
    | where tostring(payload['event_type']) == 'sensor_reading'
    | project event_ts = todatetime(payload['event_ts']),
        asset_id = toint(payload['asset_id']),
        district = tostring(payload['district']),
        water_level_cm = toreal(payload['water_level_cm']),
        traffic_count = toreal(payload['traffic_count']),
        pm25_ugm3 = toreal(payload['pm25_ugm3']),
        ingested_at = now()
}

.alter table SensorReading policy update @'[{"IsEnabled": true, "Source": "RawEvents", "Query": "ParseSensorReading()", "IsTransactional": false, "PropagateIngestionProperties": false}]'

.create-or-alter function with (folder = 'parse', docstring = 'RawEvents -> SensorAlert') ParseSensorAlert()
{
    RawEvents
    | where tostring(payload['event_type']) == 'sensor_alert'
    | project event_ts = todatetime(payload['event_ts']),
        alert_id = tostring(payload['alert_id']),
        asset_id = toint(payload['asset_id']),
        district = tostring(payload['district']),
        alert_code = tostring(payload['alert_code']),
        severity = tostring(payload['severity']),
        message = tostring(payload['message']),
        ingested_at = now()
}

.alter table SensorAlert policy update @'[{"IsEnabled": true, "Source": "RawEvents", "Query": "ParseSensorAlert()", "IsTransactional": false, "PropagateIngestionProperties": false}]'

// 2. MATERIALIZED VIEWS
// Kept current by the engine. Backfill needs the async form; ifnotexists makes re-runs safe.
// SensorReadingLatest: the newest reading per public asset - the 'where is everything now' table.
// SensorReading5m: 5-minute aggregates (fault values excluded). SensorAlert5m: alert counts per 5 minutes.

.create async ifnotexists materialized-view with (backfill = true, folder = 'views') SensorReadingLatest on table SensorReading
{
    SensorReading
    | summarize arg_max(event_ts, district, water_level_cm, traffic_count, pm25_ugm3, ingested_at) by asset_id
}

.create async ifnotexists materialized-view with (backfill = true, folder = 'views') SensorReading5m on table SensorReading
{
    SensorReading
    | where water_level_cm between (0.0 .. 500.0)
    | summarize readings = count(), avg_water_level_cm = avg(water_level_cm), max_water_level_cm = max(water_level_cm), min_water_level_cm = min(water_level_cm),
        avg_traffic_count = avg(traffic_count), avg_pm25_ugm3 = avg(pm25_ugm3), breach_readings = countif(water_level_cm > 150.0)
        by asset_id, district, window_start = bin(event_ts, 5m)
}

.create async ifnotexists materialized-view with (backfill = true, folder = 'views') SensorAlert5m on table SensorAlert
{
    SensorAlert
    | summarize alerts = count(), critical = countif(severity == 'CRITICAL')
        by district, alert_code, window_start = bin(event_ts, 5m)
}

// 3. DETECTION FUNCTIONS
// Every function anchors on the newest event, not now(), so it works on a live stream and on an uploaded
// sample file. For live operations call them with a short lookback, e.g. SensorReadingBreaches(30m).
// Fault values (999.9) and anything outside 0..500 cm are excluded from the breach, frozen and anomaly checks.

.create-or-alter function with (folder = 'detect', docstring = 'Water level above the threshold') SensorReadingBreaches(lookback: timespan = 6h, threshold: real = real(150.0))
{
    let _end = toscalar(SensorReading | summarize max(event_ts));
    SensorReading
    | where event_ts > _end - lookback
    | where water_level_cm between (0.0 .. 500.0) and water_level_cm > threshold
    | summarize first_seen = min(event_ts), last_seen = max(event_ts), breach_readings = count(),
        peak_water_level_cm = max(water_level_cm) by asset_id, district
    | order by peak_water_level_cm desc
}

.create-or-alter function with (folder = 'detect', docstring = 'Stuck sensors: no variation in water_level_cm across a window') SensorReadingFrozen(lookback: timespan = 6h, window: timespan = 30m)
{
    let _end = toscalar(SensorReading | summarize max(event_ts));
    SensorReading
    | where event_ts > _end - lookback
    | where water_level_cm between (0.0 .. 500.0)
    | summarize readings = count(), sd = stdev(water_level_cm), stuck_value = avg(water_level_cm)
        by asset_id, district, window_start = bin(event_ts, window)
    | where readings >= toint(window / 1m * 2 / 3) and sd < 0.001
    | summarize first_window = min(window_start), last_window = max(window_start), frozen_windows = count(),
        stuck_value = take_any(stuck_value) by asset_id, district
}

.create-or-alter function with (folder = 'detect', docstring = 'Bursts of sensor alerts in one district') SensorAlertBursts(lookback: timespan = 6h, window: timespan = 10m, min_alerts: int = 5)
{
    let _end = toscalar(SensorAlert | summarize max(event_ts));
    SensorAlert
    | where event_ts > _end - lookback
    | summarize alerts = count(), public_assets = dcount(asset_id), codes = make_set(alert_code)
        by district, window_start = bin(event_ts, window)
    | where alerts >= min_alerts
    | order by window_start desc
}

.create-or-alter function with (folder = 'detect', docstring = 'Spikes in water_level_cm against each public asset baseline') SensorReadingAnomalies(lookback: timespan = 6h, sensitivity: real = 3.0)
{
    let _end = toscalar(SensorReading | summarize max(event_ts));
    let _start = _end - lookback;
    SensorReading
    | where event_ts between (_start .. _end)
    | where water_level_cm between (0.0 .. 500.0)
    | make-series v = avg(water_level_cm) default = real(null) on event_ts from bin(_start, 1m) to _end + 1m step 1m by asset_id
    | extend v = series_fill_linear(v)
    | extend (flag, score, baseline) = series_decompose_anomalies(v, sensitivity, -1, 'linefit')
    | mv-expand event_ts to typeof(datetime), v to typeof(real), flag to typeof(int), score to typeof(real),
        baseline to typeof(real)
    | where flag == 1
    | project asset_id, event_ts, water_level_cm = round(v, 2), baseline = round(baseline, 2), score = round(score, 2)
}

.create-or-alter function with (folder = 'detect', docstring = 'Fault values and out-of-range readings') SensorReadingFaults(lookback: timespan = 6h)
{
    let _end = toscalar(SensorReading | summarize max(event_ts));
    SensorReading
    | where event_ts > _end - lookback
    | where isnull(water_level_cm) or water_level_cm == real(999.9) or not(water_level_cm between (0.0 .. 500.0))
    | summarize fault_readings = count(), first_seen = min(event_ts), last_seen = max(event_ts),
        fault_values = make_set(water_level_cm) by asset_id, district
}

.create-or-alter function with (folder = 'detect', docstring = 'No reading for longer than the gap') SensorReadingSilent(gap: timespan = 10m)
{
    let _end = toscalar(SensorReading | summarize max(event_ts));
    SensorReadingLatest
    | where event_ts < _end - gap
    | project asset_id, district, last_reading = event_ts, silent_for = _end - event_ts
}

// Optional: join to Gold. In the KQL database add a OneLake shortcut to lh_mdf > Tables > gold > dim_public_asset
// (keep the name). skipvalidation lets you create the function before the shortcut exists.

.create-or-alter function with (folder = 'detect', docstring = 'Breaches with public asset details from Gold', skipvalidation = 'true') SensorReadingBreachesWithContext(lookback: timespan = 6h)
{
    SensorReadingBreaches(lookback)
    | lookup kind = leftouter (external_table('dim_public_asset')
        | project asset_id = toint(asset_id), asset_ref, asset_name, asset_type, criticality) on asset_id
}

// 4. REAL-TIME DASHBOARD TILES
// One query per tile; the suggested visual is in brackets. Auto-refresh 30 s (or Continuous).
// Tiles anchor on the newest event so they also work on an uploaded sample file.
// The latency tile only shows data while events are streaming.

// ---- Tile: Public assets now by status (table)
SensorReadingLatest
| extend status_now = case(not(water_level_cm between (0.0 .. 500.0)), 'FAULT', water_level_cm > 150.0, 'BREACH', water_level_cm > 104.0, 'WATCH', 'NORMAL')
| summarize public_assets = count() by status_now, district
| order by status_now asc

// ---- Tile: Water level, top 5 public assets (line chart)
let _end = toscalar(SensorReading | summarize max(event_ts));
let top5 = SensorReading5m | where window_start > _end - 6h | summarize peak = max(max_water_level_cm) by asset_id | top 5 by peak | project asset_id;
SensorReading5m
| where window_start > _end - 6h and asset_id in (top5)
| project window_start, asset_id = tostring(asset_id), max_water_level_cm

// ---- Tile: Threshold breaches - water level above 150 cm (table)
SensorReadingBreaches()

// ---- Tile: Anomalies against baseline (table)
SensorReadingAnomalies()
| summarize first_seen = min(event_ts), last_seen = max(event_ts), peak = max(water_level_cm), points = count() by asset_id

// ---- Tile: Frozen sensors (table)
SensorReadingFrozen()

// ---- Tile: Fault values (table)
SensorReadingFaults()

// ---- Tile: Sensor alerts by district, 10-minute bins (column chart)
let _end = toscalar(SensorAlert | summarize max(event_ts));
SensorAlert5m
| where window_start > _end - 6h
| summarize alerts = sum(alerts) by district, window_start = bin(window_start, 10m)

// ---- Tile: Alert bursts - storm front (table)
SensorAlertBursts()

// ---- Tile: Average vehicle count by district, 5 minutes (line chart)
let _end = toscalar(SensorReading | summarize max(event_ts));
SensorReading5m
| where window_start > _end - 6h
| summarize avg_traffic_count = round(avg(avg_traffic_count), 2) by district, window_start

// ---- Tile: Ingestion latency p95, seconds (stat)
SensorReading
| where ingested_at > ago(15m)
| summarize p95_latency_s = percentile((ingested_at - event_ts) / 1s, 95)

// 5. ACTIVATOR RULE SUGGESTIONS (create in Activator - not KQL commands)
// Create them from a dashboard tile (Set alert) or from an Eventstream destination.
//
// Rule: Water level breach
//   Monitor:   SensorReading (Eventstream route to Activator, or the SensorReadingBreaches dashboard tile)
//   Condition: water_level_cm > 150 for 3 consecutive readings per asset_id
//   Action:    Teams message to Smart Infrastructure; optional Power Automate flow to log a follow-up
//
// Rule: Critical sensor alert
//   Monitor:   SensorAlert
//   Condition: severity == 'CRITICAL' (codes: FLOOD_LEVEL, LIGHT_FAULT, TAMPER)
//   Action:    Email and Teams to the on-call lead for the district
//
// Rule: Storm front
//   Monitor:   SensorAlertBursts() dashboard tile (Set alert)
//   Condition: alerts >= 5 in 10 minutes for one district
//   Action:    Teams post to the Smart Infrastructure channel
//
// Rule: Stuck or faulty sensor
//   Monitor:   SensorReadingFrozen() and SensorReadingFaults() tiles
//   Condition: any row returned
//   Action:    Teams message to the telemetry support team
//
// Rule: Telemetry stopped
//   Monitor:   SensorReadingLatest (or SensorReadingSilent())
//   Condition: no new reading for 10 minutes per asset_id
//   Action:    Teams message to the telemetry support team
