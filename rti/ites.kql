// Bluegum Digital Services (IT & ITeS) - Real-Time Intelligence, pack 'ites'
// Eventhouse eh_mdf_rt, KQL database eh_mdf_rt. Generated by tools/build_rti.py - edit the builder, not this file.
// Streams: service_metric -> ServiceMetric, sla_alert -> SlaAlert (both land in RawEvents first).
// Primary metric: p95_response_ms (p95 response time, ms), threshold 2500, fault value -1.
// Run the sections in order. Blocks are separated by blank lines: put the cursor in a block and Run
// (Shift+Enter). Every command is safe to re-run.

// 1. TABLES AND UPDATE POLICIES
// RawEvents is the streaming Bronze: every event as received, kept for 7 days (replayable from the stream).
// Update policies split it into typed tables at ingestion time - no pipeline, no notebook.

.create-merge table RawEvents (payload: dynamic)

.create-or-alter table RawEvents ingestion json mapping 'RawEventsMapping' '[{"column":"payload","Properties":{"Path":"$"}}]'

.alter-merge table RawEvents policy retention softdelete = 7d recoverability = disabled

.create-merge table ServiceMetric (event_ts: datetime, service_id: int, delivery_centre: string, p95_response_ms: real, availability_pct: real, ticket_backlog: real, ingested_at: datetime)

.alter table ServiceMetric policy caching hot = 31d

.alter-merge table ServiceMetric policy retention softdelete = 365d

.create-merge table SlaAlert (event_ts: datetime, alert_id: string, service_id: int, delivery_centre: string, alert_code: string, severity: string, message: string, ingested_at: datetime)

.alter table SlaAlert policy caching hot = 31d

.alter-merge table SlaAlert policy retention softdelete = 365d

.create-or-alter function with (folder = 'parse', docstring = 'RawEvents -> ServiceMetric') ParseServiceMetric()
{
    RawEvents
    | where tostring(payload['event_type']) == 'service_metric'
    | project event_ts = todatetime(payload['event_ts']),
        service_id = toint(payload['service_id']),
        delivery_centre = tostring(payload['delivery_centre']),
        p95_response_ms = toreal(payload['p95_response_ms']),
        availability_pct = toreal(payload['availability_pct']),
        ticket_backlog = toreal(payload['ticket_backlog']),
        ingested_at = now()
}

.alter table ServiceMetric policy update @'[{"IsEnabled": true, "Source": "RawEvents", "Query": "ParseServiceMetric()", "IsTransactional": false, "PropagateIngestionProperties": false}]'

.create-or-alter function with (folder = 'parse', docstring = 'RawEvents -> SlaAlert') ParseSlaAlert()
{
    RawEvents
    | where tostring(payload['event_type']) == 'sla_alert'
    | project event_ts = todatetime(payload['event_ts']),
        alert_id = tostring(payload['alert_id']),
        service_id = toint(payload['service_id']),
        delivery_centre = tostring(payload['delivery_centre']),
        alert_code = tostring(payload['alert_code']),
        severity = tostring(payload['severity']),
        message = tostring(payload['message']),
        ingested_at = now()
}

.alter table SlaAlert policy update @'[{"IsEnabled": true, "Source": "RawEvents", "Query": "ParseSlaAlert()", "IsTransactional": false, "PropagateIngestionProperties": false}]'

// 2. MATERIALIZED VIEWS
// Kept current by the engine. Backfill needs the async form; ifnotexists makes re-runs safe.
// ServiceMetricLatest: the newest reading per client service - the 'where is everything now' table.
// ServiceMetric5m: 5-minute aggregates (fault values excluded). SlaAlert5m: alert counts per 5 minutes.

.create async ifnotexists materialized-view with (backfill = true, folder = 'views') ServiceMetricLatest on table ServiceMetric
{
    ServiceMetric
    | summarize arg_max(event_ts, delivery_centre, p95_response_ms, availability_pct, ticket_backlog, ingested_at) by service_id
}

.create async ifnotexists materialized-view with (backfill = true, folder = 'views') ServiceMetric5m on table ServiceMetric
{
    ServiceMetric
    | where p95_response_ms between (0.0 .. 120000.0)
    | summarize readings = count(), avg_p95_response_ms = avg(p95_response_ms), max_p95_response_ms = max(p95_response_ms), min_p95_response_ms = min(p95_response_ms),
        avg_availability_pct = avg(availability_pct), avg_ticket_backlog = avg(ticket_backlog), breach_readings = countif(p95_response_ms > 2500.0)
        by service_id, delivery_centre, window_start = bin(event_ts, 5m)
}

.create async ifnotexists materialized-view with (backfill = true, folder = 'views') SlaAlert5m on table SlaAlert
{
    SlaAlert
    | summarize alerts = count(), critical = countif(severity == 'CRITICAL')
        by delivery_centre, alert_code, window_start = bin(event_ts, 5m)
}

// 3. DETECTION FUNCTIONS
// Every function anchors on the newest event, not now(), so it works on a live stream and on an uploaded
// sample file. For live operations call them with a short lookback, e.g. ServiceMetricBreaches(30m).
// Fault values (-1) and anything outside 0..120000 ms are excluded from the breach, frozen and anomaly checks.

.create-or-alter function with (folder = 'detect', docstring = 'P95 response time above the threshold') ServiceMetricBreaches(lookback: timespan = 6h, threshold: real = real(2500.0))
{
    let _end = toscalar(ServiceMetric | summarize max(event_ts));
    ServiceMetric
    | where event_ts > _end - lookback
    | where p95_response_ms between (0.0 .. 120000.0) and p95_response_ms > threshold
    | summarize first_seen = min(event_ts), last_seen = max(event_ts), breach_readings = count(),
        peak_p95_response_ms = max(p95_response_ms) by service_id, delivery_centre
    | order by peak_p95_response_ms desc
}

.create-or-alter function with (folder = 'detect', docstring = 'Stuck sensors: no variation in p95_response_ms across a window') ServiceMetricFrozen(lookback: timespan = 6h, window: timespan = 30m)
{
    let _end = toscalar(ServiceMetric | summarize max(event_ts));
    ServiceMetric
    | where event_ts > _end - lookback
    | where p95_response_ms between (0.0 .. 120000.0)
    | summarize readings = count(), sd = stdev(p95_response_ms), stuck_value = avg(p95_response_ms)
        by service_id, delivery_centre, window_start = bin(event_ts, window)
    | where readings >= toint(window / 1m * 2 / 3) and sd < 0.001
    | summarize first_window = min(window_start), last_window = max(window_start), frozen_windows = count(),
        stuck_value = take_any(stuck_value) by service_id, delivery_centre
}

.create-or-alter function with (folder = 'detect', docstring = 'Bursts of SLA alerts in one delivery centre') SlaAlertBursts(lookback: timespan = 6h, window: timespan = 10m, min_alerts: int = 5)
{
    let _end = toscalar(SlaAlert | summarize max(event_ts));
    SlaAlert
    | where event_ts > _end - lookback
    | summarize alerts = count(), client_services = dcount(service_id), codes = make_set(alert_code)
        by delivery_centre, window_start = bin(event_ts, window)
    | where alerts >= min_alerts
    | order by window_start desc
}

.create-or-alter function with (folder = 'detect', docstring = 'Spikes in p95_response_ms against each client service baseline') ServiceMetricAnomalies(lookback: timespan = 6h, sensitivity: real = 3.0)
{
    let _end = toscalar(ServiceMetric | summarize max(event_ts));
    let _start = _end - lookback;
    ServiceMetric
    | where event_ts between (_start .. _end)
    | where p95_response_ms between (0.0 .. 120000.0)
    | make-series v = avg(p95_response_ms) default = real(null) on event_ts from bin(_start, 1m) to _end + 1m step 1m by service_id
    | extend v = series_fill_linear(v)
    | extend (flag, score, baseline) = series_decompose_anomalies(v, sensitivity, -1, 'linefit')
    | mv-expand event_ts to typeof(datetime), v to typeof(real), flag to typeof(int), score to typeof(real),
        baseline to typeof(real)
    | where flag == 1
    | project service_id, event_ts, p95_response_ms = round(v, 2), baseline = round(baseline, 2), score = round(score, 2)
}

.create-or-alter function with (folder = 'detect', docstring = 'Fault values and out-of-range readings') ServiceMetricFaults(lookback: timespan = 6h)
{
    let _end = toscalar(ServiceMetric | summarize max(event_ts));
    ServiceMetric
    | where event_ts > _end - lookback
    | where isnull(p95_response_ms) or p95_response_ms == real(-1.0) or not(p95_response_ms between (0.0 .. 120000.0))
    | summarize fault_readings = count(), first_seen = min(event_ts), last_seen = max(event_ts),
        fault_values = make_set(p95_response_ms) by service_id, delivery_centre
}

.create-or-alter function with (folder = 'detect', docstring = 'No reading for longer than the gap') ServiceMetricSilent(gap: timespan = 10m)
{
    let _end = toscalar(ServiceMetric | summarize max(event_ts));
    ServiceMetricLatest
    | where event_ts < _end - gap
    | project service_id, delivery_centre, last_reading = event_ts, silent_for = _end - event_ts
}

// Optional: join to Gold. In the KQL database add a OneLake shortcut to lh_mdf > Tables > gold > dim_client_service
// (keep the name). skipvalidation lets you create the function before the shortcut exists.

.create-or-alter function with (folder = 'detect', docstring = 'Breaches with client service details from Gold', skipvalidation = 'true') ServiceMetricBreachesWithContext(lookback: timespan = 6h)
{
    ServiceMetricBreaches(lookback)
    | lookup kind = leftouter (external_table('dim_client_service')
        | project service_id = toint(service_id), contract_ref, service_name, service_line, sla_tier) on service_id
}

// 4. REAL-TIME DASHBOARD TILES
// One query per tile; the suggested visual is in brackets. Auto-refresh 30 s (or Continuous).
// Tiles anchor on the newest event so they also work on an uploaded sample file.
// The latency tile only shows data while events are streaming.

// ---- Tile: Client services now by status (table)
ServiceMetricLatest
| extend status_now = case(not(p95_response_ms between (0.0 .. 120000.0)), 'FAULT', p95_response_ms > 2500.0, 'BREACH', p95_response_ms > 1860.0, 'WATCH', 'NORMAL')
| summarize client_services = count() by status_now, delivery_centre
| order by status_now asc

// ---- Tile: P95 response time, top 5 client services (line chart)
let _end = toscalar(ServiceMetric | summarize max(event_ts));
let top5 = ServiceMetric5m | where window_start > _end - 6h | summarize peak = max(max_p95_response_ms) by service_id | top 5 by peak | project service_id;
ServiceMetric5m
| where window_start > _end - 6h and service_id in (top5)
| project window_start, service_id = tostring(service_id), max_p95_response_ms

// ---- Tile: Threshold breaches - p95 response time above 2500 ms (table)
ServiceMetricBreaches()

// ---- Tile: Anomalies against baseline (table)
ServiceMetricAnomalies()
| summarize first_seen = min(event_ts), last_seen = max(event_ts), peak = max(p95_response_ms), points = count() by service_id

// ---- Tile: Frozen sensors (table)
ServiceMetricFrozen()

// ---- Tile: Fault values (table)
ServiceMetricFaults()

// ---- Tile: SLA alerts by delivery centre, 10-minute bins (column chart)
let _end = toscalar(SlaAlert | summarize max(event_ts));
SlaAlert5m
| where window_start > _end - 6h
| summarize alerts = sum(alerts) by delivery_centre, window_start = bin(window_start, 10m)

// ---- Tile: Alert bursts - failed deployment (table)
SlaAlertBursts()

// ---- Tile: Average availability by delivery centre, 5 minutes (line chart)
let _end = toscalar(ServiceMetric | summarize max(event_ts));
ServiceMetric5m
| where window_start > _end - 6h
| summarize avg_availability_pct = round(avg(avg_availability_pct), 2) by delivery_centre, window_start

// ---- Tile: Ingestion latency p95, seconds (stat)
ServiceMetric
| where ingested_at > ago(15m)
| summarize p95_latency_s = percentile((ingested_at - event_ts) / 1s, 95)

// 5. ACTIVATOR RULE SUGGESTIONS (create in Activator - not KQL commands)
// Create them from a dashboard tile (Set alert) or from an Eventstream destination.
//
// Rule: P95 response time breach
//   Monitor:   ServiceMetric (Eventstream route to Activator, or the ServiceMetricBreaches dashboard tile)
//   Condition: p95_response_ms > 2500 for 3 consecutive readings per service_id
//   Action:    Teams message to Service Assurance; optional Power Automate flow to log a follow-up
//
// Rule: Critical SLA alert
//   Monitor:   SlaAlert
//   Condition: severity == 'CRITICAL' (codes: SLA_RESPONSE_BREACH, HOST_DOWN, CERT_EXPIRY)
//   Action:    Email and Teams to the on-call lead for the delivery centre
//
// Rule: Failed deployment
//   Monitor:   SlaAlertBursts() dashboard tile (Set alert)
//   Condition: alerts >= 5 in 10 minutes for one delivery_centre
//   Action:    Teams post to the Service Assurance channel
//
// Rule: Stuck or faulty sensor
//   Monitor:   ServiceMetricFrozen() and ServiceMetricFaults() tiles
//   Condition: any row returned
//   Action:    Teams message to the telemetry support team
//
// Rule: Telemetry stopped
//   Monitor:   ServiceMetricLatest (or ServiceMetricSilent())
//   Condition: no new reading for 10 minutes per service_id
//   Action:    Teams message to the telemetry support team
