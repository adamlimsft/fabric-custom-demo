// Southern Cross Telecom (Telecommunications) - Real-Time Intelligence, pack 'telco'
// Eventhouse eh_mdf_rt, KQL database eh_mdf_rt. Generated by tools/build_rti.py - edit the builder, not this file.
// Streams: cell_kpi -> CellKpi, network_alarm -> NetworkAlarm (both land in RawEvents first).
// Primary metric: prb_util_pct (PRB utilisation, %), threshold 90, fault value 999.9.
// Run the sections in order. Blocks are separated by blank lines: put the cursor in a block and Run
// (Shift+Enter). Every command is safe to re-run.

// 1. TABLES AND UPDATE POLICIES
// RawEvents is the streaming Bronze: every event as received, kept for 7 days (replayable from the stream).
// Update policies split it into typed tables at ingestion time - no pipeline, no notebook.

.create-merge table RawEvents (payload: dynamic)

.create-or-alter table RawEvents ingestion json mapping 'RawEventsMapping' '[{"column":"payload","Properties":{"Path":"$"}}]'

.alter-merge table RawEvents policy retention softdelete = 7d recoverability = disabled

.create-merge table CellKpi (event_ts: datetime, element_id: int, region: string, prb_util_pct: real, active_users: real, drop_rate_pct: real, ingested_at: datetime)

.alter table CellKpi policy caching hot = 31d

.alter-merge table CellKpi policy retention softdelete = 365d

.create-merge table NetworkAlarm (event_ts: datetime, alert_id: string, element_id: int, region: string, alert_code: string, severity: string, message: string, ingested_at: datetime)

.alter table NetworkAlarm policy caching hot = 31d

.alter-merge table NetworkAlarm policy retention softdelete = 365d

.create-or-alter function with (folder = 'parse', docstring = 'RawEvents -> CellKpi') ParseCellKpi()
{
    RawEvents
    | where tostring(payload['event_type']) == 'cell_kpi'
    | project event_ts = todatetime(payload['event_ts']),
        element_id = toint(payload['element_id']),
        region = tostring(payload['region']),
        prb_util_pct = toreal(payload['prb_util_pct']),
        active_users = toreal(payload['active_users']),
        drop_rate_pct = toreal(payload['drop_rate_pct']),
        ingested_at = now()
}

.alter table CellKpi policy update @'[{"IsEnabled": true, "Source": "RawEvents", "Query": "ParseCellKpi()", "IsTransactional": false, "PropagateIngestionProperties": false}]'

.create-or-alter function with (folder = 'parse', docstring = 'RawEvents -> NetworkAlarm') ParseNetworkAlarm()
{
    RawEvents
    | where tostring(payload['event_type']) == 'network_alarm'
    | project event_ts = todatetime(payload['event_ts']),
        alert_id = tostring(payload['alert_id']),
        element_id = toint(payload['element_id']),
        region = tostring(payload['region']),
        alert_code = tostring(payload['alert_code']),
        severity = tostring(payload['severity']),
        message = tostring(payload['message']),
        ingested_at = now()
}

.alter table NetworkAlarm policy update @'[{"IsEnabled": true, "Source": "RawEvents", "Query": "ParseNetworkAlarm()", "IsTransactional": false, "PropagateIngestionProperties": false}]'

// 2. MATERIALIZED VIEWS
// Kept current by the engine. Backfill needs the async form; ifnotexists makes re-runs safe.
// CellKpiLatest: the newest reading per network element - the 'where is everything now' table.
// CellKpi5m: 5-minute aggregates (fault values excluded). NetworkAlarm5m: alert counts per 5 minutes.

.create async ifnotexists materialized-view with (backfill = true, folder = 'views') CellKpiLatest on table CellKpi
{
    CellKpi
    | summarize arg_max(event_ts, region, prb_util_pct, active_users, drop_rate_pct, ingested_at) by element_id
}

.create async ifnotexists materialized-view with (backfill = true, folder = 'views') CellKpi5m on table CellKpi
{
    CellKpi
    | where prb_util_pct between (0.0 .. 100.0)
    | summarize readings = count(), avg_prb_util_pct = avg(prb_util_pct), max_prb_util_pct = max(prb_util_pct), min_prb_util_pct = min(prb_util_pct),
        avg_active_users = avg(active_users), avg_drop_rate_pct = avg(drop_rate_pct), breach_readings = countif(prb_util_pct > 90.0)
        by element_id, region, window_start = bin(event_ts, 5m)
}

.create async ifnotexists materialized-view with (backfill = true, folder = 'views') NetworkAlarm5m on table NetworkAlarm
{
    NetworkAlarm
    | summarize alerts = count(), critical = countif(severity == 'CRITICAL')
        by region, alert_code, window_start = bin(event_ts, 5m)
}

// 3. DETECTION FUNCTIONS
// Every function anchors on the newest event, not now(), so it works on a live stream and on an uploaded
// sample file. For live operations call them with a short lookback, e.g. CellKpiBreaches(30m).
// Fault values (999.9) and anything outside 0..100 % are excluded from the breach, frozen and anomaly checks.

.create-or-alter function with (folder = 'detect', docstring = 'PRB utilisation above the threshold') CellKpiBreaches(lookback: timespan = 6h, threshold: real = real(90.0))
{
    let _end = toscalar(CellKpi | summarize max(event_ts));
    CellKpi
    | where event_ts > _end - lookback
    | where prb_util_pct between (0.0 .. 100.0) and prb_util_pct > threshold
    | summarize first_seen = min(event_ts), last_seen = max(event_ts), breach_readings = count(),
        peak_prb_util_pct = max(prb_util_pct) by element_id, region
    | order by peak_prb_util_pct desc
}

.create-or-alter function with (folder = 'detect', docstring = 'Stuck sensors: no variation in prb_util_pct across a window') CellKpiFrozen(lookback: timespan = 6h, window: timespan = 30m)
{
    let _end = toscalar(CellKpi | summarize max(event_ts));
    CellKpi
    | where event_ts > _end - lookback
    | where prb_util_pct between (0.0 .. 100.0)
    | summarize readings = count(), sd = stdev(prb_util_pct), stuck_value = avg(prb_util_pct)
        by element_id, region, window_start = bin(event_ts, window)
    | where readings >= toint(window / 1m * 2 / 3) and sd < 0.001
    | summarize first_window = min(window_start), last_window = max(window_start), frozen_windows = count(),
        stuck_value = take_any(stuck_value) by element_id, region
}

.create-or-alter function with (folder = 'detect', docstring = 'Bursts of network alarms in one region') NetworkAlarmBursts(lookback: timespan = 6h, window: timespan = 10m, min_alerts: int = 5)
{
    let _end = toscalar(NetworkAlarm | summarize max(event_ts));
    NetworkAlarm
    | where event_ts > _end - lookback
    | summarize alerts = count(), network_elements = dcount(element_id), codes = make_set(alert_code)
        by region, window_start = bin(event_ts, window)
    | where alerts >= min_alerts
    | order by window_start desc
}

.create-or-alter function with (folder = 'detect', docstring = 'Spikes in prb_util_pct against each network element baseline') CellKpiAnomalies(lookback: timespan = 6h, sensitivity: real = 3.0)
{
    let _end = toscalar(CellKpi | summarize max(event_ts));
    let _start = _end - lookback;
    CellKpi
    | where event_ts between (_start .. _end)
    | where prb_util_pct between (0.0 .. 100.0)
    | make-series v = avg(prb_util_pct) default = real(null) on event_ts from bin(_start, 1m) to _end + 1m step 1m by element_id
    | extend v = series_fill_linear(v)
    | extend (flag, score, baseline) = series_decompose_anomalies(v, sensitivity, -1, 'linefit')
    | mv-expand event_ts to typeof(datetime), v to typeof(real), flag to typeof(int), score to typeof(real),
        baseline to typeof(real)
    | where flag == 1
    | project element_id, event_ts, prb_util_pct = round(v, 2), baseline = round(baseline, 2), score = round(score, 2)
}

.create-or-alter function with (folder = 'detect', docstring = 'Fault values and out-of-range readings') CellKpiFaults(lookback: timespan = 6h)
{
    let _end = toscalar(CellKpi | summarize max(event_ts));
    CellKpi
    | where event_ts > _end - lookback
    | where isnull(prb_util_pct) or prb_util_pct == real(999.9) or not(prb_util_pct between (0.0 .. 100.0))
    | summarize fault_readings = count(), first_seen = min(event_ts), last_seen = max(event_ts),
        fault_values = make_set(prb_util_pct) by element_id, region
}

.create-or-alter function with (folder = 'detect', docstring = 'No reading for longer than the gap') CellKpiSilent(gap: timespan = 10m)
{
    let _end = toscalar(CellKpi | summarize max(event_ts));
    CellKpiLatest
    | where event_ts < _end - gap
    | project element_id, region, last_reading = event_ts, silent_for = _end - event_ts
}

// Optional: join to Gold. In the KQL database add a OneLake shortcut to lh_mdf > Tables > gold > dim_network_element
// (keep the name). skipvalidation lets you create the function before the shortcut exists.

.create-or-alter function with (folder = 'detect', docstring = 'Breaches with network element details from Gold', skipvalidation = 'true') CellKpiBreachesWithContext(lookback: timespan = 6h)
{
    CellKpiBreaches(lookback)
    | lookup kind = leftouter (external_table('dim_network_element')
        | project element_id = toint(element_id), element_code, element_name, element_type, criticality) on element_id
}

// 4. REAL-TIME DASHBOARD TILES
// One query per tile; the suggested visual is in brackets. Auto-refresh 30 s (or Continuous).
// Tiles anchor on the newest event so they also work on an uploaded sample file.
// The latency tile only shows data while events are streaming.

// ---- Tile: Network elements now by status (table)
CellKpiLatest
| extend status_now = case(not(prb_util_pct between (0.0 .. 100.0)), 'FAULT', prb_util_pct > 90.0, 'BREACH', prb_util_pct > 76.0, 'WATCH', 'NORMAL')
| summarize network_elements = count() by status_now, region
| order by status_now asc

// ---- Tile: PRB utilisation, top 5 network elements (line chart)
let _end = toscalar(CellKpi | summarize max(event_ts));
let top5 = CellKpi5m | where window_start > _end - 6h | summarize peak = max(max_prb_util_pct) by element_id | top 5 by peak | project element_id;
CellKpi5m
| where window_start > _end - 6h and element_id in (top5)
| project window_start, element_id = tostring(element_id), max_prb_util_pct

// ---- Tile: Threshold breaches - PRB utilisation above 90 % (table)
CellKpiBreaches()

// ---- Tile: Anomalies against baseline (table)
CellKpiAnomalies()
| summarize first_seen = min(event_ts), last_seen = max(event_ts), peak = max(prb_util_pct), points = count() by element_id

// ---- Tile: Frozen sensors (table)
CellKpiFrozen()

// ---- Tile: Fault values (table)
CellKpiFaults()

// ---- Tile: Network alarms by region, 10-minute bins (column chart)
let _end = toscalar(NetworkAlarm | summarize max(event_ts));
NetworkAlarm5m
| where window_start > _end - 6h
| summarize alerts = sum(alerts) by region, window_start = bin(window_start, 10m)

// ---- Tile: Alert bursts - stadium surge (table)
NetworkAlarmBursts()

// ---- Tile: Average active users by region, 5 minutes (line chart)
let _end = toscalar(CellKpi | summarize max(event_ts));
CellKpi5m
| where window_start > _end - 6h
| summarize avg_active_users = round(avg(avg_active_users), 2) by region, window_start

// ---- Tile: Ingestion latency p95, seconds (stat)
CellKpi
| where ingested_at > ago(15m)
| summarize p95_latency_s = percentile((ingested_at - event_ts) / 1s, 95)

// 5. ACTIVATOR RULE SUGGESTIONS (create in Activator - not KQL commands)
// Create them from a dashboard tile (Set alert) or from an Eventstream destination.
//
// Rule: PRB utilisation breach
//   Monitor:   CellKpi (Eventstream route to Activator, or the CellKpiBreaches dashboard tile)
//   Condition: prb_util_pct > 90 for 3 consecutive readings per element_id
//   Action:    Teams message to Network Performance; optional Power Automate flow to log a follow-up
//
// Rule: Critical network alarm
//   Monitor:   NetworkAlarm
//   Condition: severity == 'CRITICAL' (codes: LINK_DOWN, HIGH_TEMP, POWER_FAIL)
//   Action:    Email and Teams to the on-call lead for the region
//
// Rule: Stadium surge
//   Monitor:   NetworkAlarmBursts() dashboard tile (Set alert)
//   Condition: alerts >= 5 in 10 minutes for one region
//   Action:    Teams post to the Network Performance channel
//
// Rule: Stuck or faulty sensor
//   Monitor:   CellKpiFrozen() and CellKpiFaults() tiles
//   Condition: any row returned
//   Action:    Teams message to the telemetry support team
//
// Rule: Telemetry stopped
//   Monitor:   CellKpiLatest (or CellKpiSilent())
//   Condition: no new reading for 10 minutes per element_id
//   Action:    Teams message to the telemetry support team
