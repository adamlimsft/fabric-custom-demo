// Southern Grid Transmission (Energy & utilities) - Real-Time Intelligence, pack 'energy'
// Eventhouse eh_mdf_rt, KQL database eh_mdf_rt. Generated by tools/build_rti.py - edit the builder, not this file.
// Streams: tx_telemetry -> TxTelemetry, breaker_trip -> BreakerTrip (both land in RawEvents first).
// Primary metric: oil_temp_c (oil temperature, °C), threshold 95, fault value 999.9.
// Run the sections in order. Blocks are separated by blank lines: put the cursor in a block and Run
// (Shift+Enter). Every command is safe to re-run.

// 1. TABLES AND UPDATE POLICIES
// RawEvents is the streaming Bronze: every event as received, kept for 7 days (replayable from the stream).
// Update policies split it into typed tables at ingestion time - no pipeline, no notebook.

.create-merge table RawEvents (payload: dynamic)

.create-or-alter table RawEvents ingestion json mapping 'RawEventsMapping' '[{"column":"payload","Properties":{"Path":"$"}}]'

.alter-merge table RawEvents policy retention softdelete = 7d recoverability = disabled

.create-merge table TxTelemetry (event_ts: datetime, asset_id: int, region: string, oil_temp_c: real, load_mw: real, ambient_temp_c: real, ingested_at: datetime)

.alter table TxTelemetry policy caching hot = 31d

.alter-merge table TxTelemetry policy retention softdelete = 365d

.create-merge table BreakerTrip (event_ts: datetime, alert_id: string, asset_id: int, region: string, alert_code: string, severity: string, message: string, ingested_at: datetime)

.alter table BreakerTrip policy caching hot = 31d

.alter-merge table BreakerTrip policy retention softdelete = 365d

.create-or-alter function with (folder = 'parse', docstring = 'RawEvents -> TxTelemetry') ParseTxTelemetry()
{
    RawEvents
    | where tostring(payload['event_type']) == 'tx_telemetry'
    | project event_ts = todatetime(payload['event_ts']),
        asset_id = toint(payload['asset_id']),
        region = tostring(payload['region']),
        oil_temp_c = toreal(payload['oil_temp_c']),
        load_mw = toreal(payload['load_mw']),
        ambient_temp_c = toreal(payload['ambient_temp_c']),
        ingested_at = now()
}

.alter table TxTelemetry policy update @'[{"IsEnabled": true, "Source": "RawEvents", "Query": "ParseTxTelemetry()", "IsTransactional": false, "PropagateIngestionProperties": false}]'

.create-or-alter function with (folder = 'parse', docstring = 'RawEvents -> BreakerTrip') ParseBreakerTrip()
{
    RawEvents
    | where tostring(payload['event_type']) == 'breaker_trip'
    | project event_ts = todatetime(payload['event_ts']),
        alert_id = tostring(payload['alert_id']),
        asset_id = toint(payload['asset_id']),
        region = tostring(payload['region']),
        alert_code = tostring(payload['alert_code']),
        severity = tostring(payload['severity']),
        message = tostring(payload['message']),
        ingested_at = now()
}

.alter table BreakerTrip policy update @'[{"IsEnabled": true, "Source": "RawEvents", "Query": "ParseBreakerTrip()", "IsTransactional": false, "PropagateIngestionProperties": false}]'

// 2. MATERIALIZED VIEWS
// Kept current by the engine. Backfill needs the async form; ifnotexists makes re-runs safe.
// TxTelemetryLatest: the newest reading per asset - the 'where is everything now' table.
// TxTelemetry5m: 5-minute aggregates (fault values excluded). BreakerTrip5m: alert counts per 5 minutes.

.create async ifnotexists materialized-view with (backfill = true, folder = 'views') TxTelemetryLatest on table TxTelemetry
{
    TxTelemetry
    | summarize arg_max(event_ts, region, oil_temp_c, load_mw, ambient_temp_c, ingested_at) by asset_id
}

.create async ifnotexists materialized-view with (backfill = true, folder = 'views') TxTelemetry5m on table TxTelemetry
{
    TxTelemetry
    | where oil_temp_c between (-10.0 .. 140.0)
    | summarize readings = count(), avg_oil_temp_c = avg(oil_temp_c), max_oil_temp_c = max(oil_temp_c), min_oil_temp_c = min(oil_temp_c),
        avg_load_mw = avg(load_mw), avg_ambient_temp_c = avg(ambient_temp_c), breach_readings = countif(oil_temp_c > 95.0)
        by asset_id, region, window_start = bin(event_ts, 5m)
}

.create async ifnotexists materialized-view with (backfill = true, folder = 'views') BreakerTrip5m on table BreakerTrip
{
    BreakerTrip
    | summarize alerts = count(), critical = countif(severity == 'CRITICAL')
        by region, alert_code, window_start = bin(event_ts, 5m)
}

// 3. DETECTION FUNCTIONS
// Every function anchors on the newest event, not now(), so it works on a live stream and on an uploaded
// sample file. For live operations call them with a short lookback, e.g. TxTelemetryBreaches(30m).
// Fault values (999.9) and anything outside -10..140 °C are excluded from the breach, frozen and anomaly checks.

.create-or-alter function with (folder = 'detect', docstring = 'Oil temperature above the threshold') TxTelemetryBreaches(lookback: timespan = 6h, threshold: real = real(95.0))
{
    let _end = toscalar(TxTelemetry | summarize max(event_ts));
    TxTelemetry
    | where event_ts > _end - lookback
    | where oil_temp_c between (-10.0 .. 140.0) and oil_temp_c > threshold
    | summarize first_seen = min(event_ts), last_seen = max(event_ts), breach_readings = count(),
        peak_oil_temp_c = max(oil_temp_c) by asset_id, region
    | order by peak_oil_temp_c desc
}

.create-or-alter function with (folder = 'detect', docstring = 'Stuck sensors: no variation in oil_temp_c across a window') TxTelemetryFrozen(lookback: timespan = 6h, window: timespan = 30m)
{
    let _end = toscalar(TxTelemetry | summarize max(event_ts));
    TxTelemetry
    | where event_ts > _end - lookback
    | where oil_temp_c between (-10.0 .. 140.0)
    | summarize readings = count(), sd = stdev(oil_temp_c), stuck_value = avg(oil_temp_c)
        by asset_id, region, window_start = bin(event_ts, window)
    | where readings >= toint(window / 1m * 2 / 3) and sd < 0.001
    | summarize first_window = min(window_start), last_window = max(window_start), frozen_windows = count(),
        stuck_value = take_any(stuck_value) by asset_id, region
}

.create-or-alter function with (folder = 'detect', docstring = 'Bursts of breaker trips in one region') BreakerTripBursts(lookback: timespan = 6h, window: timespan = 10m, min_alerts: int = 5)
{
    let _end = toscalar(BreakerTrip | summarize max(event_ts));
    BreakerTrip
    | where event_ts > _end - lookback
    | summarize alerts = count(), assets = dcount(asset_id), codes = make_set(alert_code)
        by region, window_start = bin(event_ts, window)
    | where alerts >= min_alerts
    | order by window_start desc
}

.create-or-alter function with (folder = 'detect', docstring = 'Spikes in oil_temp_c against each asset baseline') TxTelemetryAnomalies(lookback: timespan = 6h, sensitivity: real = 3.0)
{
    let _end = toscalar(TxTelemetry | summarize max(event_ts));
    let _start = _end - lookback;
    TxTelemetry
    | where event_ts between (_start .. _end)
    | where oil_temp_c between (-10.0 .. 140.0)
    | make-series v = avg(oil_temp_c) default = real(null) on event_ts from bin(_start, 1m) to _end + 1m step 1m by asset_id
    | extend v = series_fill_linear(v)
    | extend (flag, score, baseline) = series_decompose_anomalies(v, sensitivity, -1, 'linefit')
    | mv-expand event_ts to typeof(datetime), v to typeof(real), flag to typeof(int), score to typeof(real),
        baseline to typeof(real)
    | where flag == 1
    | project asset_id, event_ts, oil_temp_c = round(v, 2), baseline = round(baseline, 2), score = round(score, 2)
}

.create-or-alter function with (folder = 'detect', docstring = 'Fault values and out-of-range readings') TxTelemetryFaults(lookback: timespan = 6h)
{
    let _end = toscalar(TxTelemetry | summarize max(event_ts));
    TxTelemetry
    | where event_ts > _end - lookback
    | where isnull(oil_temp_c) or oil_temp_c == real(999.9) or not(oil_temp_c between (-10.0 .. 140.0))
    | summarize fault_readings = count(), first_seen = min(event_ts), last_seen = max(event_ts),
        fault_values = make_set(oil_temp_c) by asset_id, region
}

.create-or-alter function with (folder = 'detect', docstring = 'No reading for longer than the gap') TxTelemetrySilent(gap: timespan = 10m)
{
    let _end = toscalar(TxTelemetry | summarize max(event_ts));
    TxTelemetryLatest
    | where event_ts < _end - gap
    | project asset_id, region, last_reading = event_ts, silent_for = _end - event_ts
}

// Optional: join to Gold. In the KQL database add a OneLake shortcut to lh_mdf > Tables > gold > dim_asset
// (keep the name). skipvalidation lets you create the function before the shortcut exists.

.create-or-alter function with (folder = 'detect', docstring = 'Breaches with asset details from Gold', skipvalidation = 'true') TxTelemetryBreachesWithContext(lookback: timespan = 6h)
{
    TxTelemetryBreaches(lookback)
    | lookup kind = leftouter (external_table('dim_asset')
        | project asset_id = toint(asset_id), asset_tag, asset_name, asset_class, criticality) on asset_id
}

// 4. REAL-TIME DASHBOARD TILES
// One query per tile; the suggested visual is in brackets. Auto-refresh 30 s (or Continuous).
// Tiles anchor on the newest event so they also work on an uploaded sample file.
// The latency tile only shows data while events are streaming.

// ---- Tile: Assets now by status (table)
TxTelemetryLatest
| extend status_now = case(not(oil_temp_c between (-10.0 .. 140.0)), 'FAULT', oil_temp_c > 95.0, 'BREACH', oil_temp_c > 81.8, 'WATCH', 'NORMAL')
| summarize assets = count() by status_now, region
| order by status_now asc

// ---- Tile: Oil temperature, top 5 assets (line chart)
let _end = toscalar(TxTelemetry | summarize max(event_ts));
let top5 = TxTelemetry5m | where window_start > _end - 6h | summarize peak = max(max_oil_temp_c) by asset_id | top 5 by peak | project asset_id;
TxTelemetry5m
| where window_start > _end - 6h and asset_id in (top5)
| project window_start, asset_id = tostring(asset_id), max_oil_temp_c

// ---- Tile: Threshold breaches - oil temperature above 95 °C (table)
TxTelemetryBreaches()

// ---- Tile: Anomalies against baseline (table)
TxTelemetryAnomalies()
| summarize first_seen = min(event_ts), last_seen = max(event_ts), peak = max(oil_temp_c), points = count() by asset_id

// ---- Tile: Frozen sensors (table)
TxTelemetryFrozen()

// ---- Tile: Fault values (table)
TxTelemetryFaults()

// ---- Tile: Breaker trips by region, 10-minute bins (column chart)
let _end = toscalar(BreakerTrip | summarize max(event_ts));
BreakerTrip5m
| where window_start > _end - 6h
| summarize alerts = sum(alerts) by region, window_start = bin(window_start, 10m)

// ---- Tile: Alert bursts - storm cell (table)
BreakerTripBursts()

// ---- Tile: Average load by region, 5 minutes (line chart)
let _end = toscalar(TxTelemetry | summarize max(event_ts));
TxTelemetry5m
| where window_start > _end - 6h
| summarize avg_load_mw = round(avg(avg_load_mw), 2) by region, window_start

// ---- Tile: Ingestion latency p95, seconds (stat)
TxTelemetry
| where ingested_at > ago(15m)
| summarize p95_latency_s = percentile((ingested_at - event_ts) / 1s, 95)

// 5. ACTIVATOR RULE SUGGESTIONS (create in Activator - not KQL commands)
// Create them from a dashboard tile (Set alert) or from an Eventstream destination.
//
// Rule: Oil temperature breach
//   Monitor:   TxTelemetry (Eventstream route to Activator, or the TxTelemetryBreaches dashboard tile)
//   Condition: oil_temp_c > 95 for 3 consecutive readings per asset_id
//   Action:    Teams message to Network Operations; optional Power Automate flow to log a follow-up
//
// Rule: Critical breaker trip
//   Monitor:   BreakerTrip
//   Condition: severity == 'CRITICAL' (codes: PROTECTION_TRIP, AUTO_RECLOSE, LOCKOUT)
//   Action:    Email and Teams to the on-call lead for the region
//
// Rule: Storm cell
//   Monitor:   BreakerTripBursts() dashboard tile (Set alert)
//   Condition: alerts >= 5 in 10 minutes for one region
//   Action:    Teams post to the Network Operations channel
//
// Rule: Stuck or faulty sensor
//   Monitor:   TxTelemetryFrozen() and TxTelemetryFaults() tiles
//   Condition: any row returned
//   Action:    Teams message to the telemetry support team
//
// Rule: Telemetry stopped
//   Monitor:   TxTelemetryLatest (or TxTelemetrySilent())
//   Condition: no new reading for 10 minutes per asset_id
//   Action:    Teams message to the telemetry support team
