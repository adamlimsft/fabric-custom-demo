// Harbour Mutual Bank (Financial services) - Real-Time Intelligence, pack 'fsi'
// Eventhouse eh_mdf_rt, KQL database eh_mdf_rt. Generated by tools/build_rti.py - edit the builder, not this file.
// Streams: txn_monitor -> TxnMonitor, fraud_signal -> FraudSignal (both land in RawEvents first).
// Primary metric: decline_pct (declined transaction rate, %), threshold 30, fault value 999.9.
// Run the sections in order. Blocks are separated by blank lines: put the cursor in a block and Run
// (Shift+Enter). Every command is safe to re-run.

// 1. TABLES AND UPDATE POLICIES
// RawEvents is the streaming Bronze: every event as received, kept for 7 days (replayable from the stream).
// Update policies split it into typed tables at ingestion time - no pipeline, no notebook.

.create-merge table RawEvents (payload: dynamic)

.create-or-alter table RawEvents ingestion json mapping 'RawEventsMapping' '[{"column":"payload","Properties":{"Path":"$"}}]'

.alter-merge table RawEvents policy retention softdelete = 7d recoverability = disabled

.create-merge table TxnMonitor (event_ts: datetime, account_id: int, state: string, decline_pct: real, txn_value_aud: real, txn_count: real, ingested_at: datetime)

.alter table TxnMonitor policy caching hot = 31d

.alter-merge table TxnMonitor policy retention softdelete = 365d

.create-merge table FraudSignal (event_ts: datetime, alert_id: string, account_id: int, state: string, alert_code: string, severity: string, message: string, ingested_at: datetime)

.alter table FraudSignal policy caching hot = 31d

.alter-merge table FraudSignal policy retention softdelete = 365d

.create-or-alter function with (folder = 'parse', docstring = 'RawEvents -> TxnMonitor') ParseTxnMonitor()
{
    RawEvents
    | where tostring(payload['event_type']) == 'txn_monitor'
    | project event_ts = todatetime(payload['event_ts']),
        account_id = toint(payload['account_id']),
        state = tostring(payload['state']),
        decline_pct = toreal(payload['decline_pct']),
        txn_value_aud = toreal(payload['txn_value_aud']),
        txn_count = toreal(payload['txn_count']),
        ingested_at = now()
}

.alter table TxnMonitor policy update @'[{"IsEnabled": true, "Source": "RawEvents", "Query": "ParseTxnMonitor()", "IsTransactional": false, "PropagateIngestionProperties": false}]'

.create-or-alter function with (folder = 'parse', docstring = 'RawEvents -> FraudSignal') ParseFraudSignal()
{
    RawEvents
    | where tostring(payload['event_type']) == 'fraud_signal'
    | project event_ts = todatetime(payload['event_ts']),
        alert_id = tostring(payload['alert_id']),
        account_id = toint(payload['account_id']),
        state = tostring(payload['state']),
        alert_code = tostring(payload['alert_code']),
        severity = tostring(payload['severity']),
        message = tostring(payload['message']),
        ingested_at = now()
}

.alter table FraudSignal policy update @'[{"IsEnabled": true, "Source": "RawEvents", "Query": "ParseFraudSignal()", "IsTransactional": false, "PropagateIngestionProperties": false}]'

// 2. MATERIALIZED VIEWS
// Kept current by the engine. Backfill needs the async form; ifnotexists makes re-runs safe.
// TxnMonitorLatest: the newest reading per account - the 'where is everything now' table.
// TxnMonitor5m: 5-minute aggregates (fault values excluded). FraudSignal5m: alert counts per 5 minutes.

.create async ifnotexists materialized-view with (backfill = true, folder = 'views') TxnMonitorLatest on table TxnMonitor
{
    TxnMonitor
    | summarize arg_max(event_ts, state, decline_pct, txn_value_aud, txn_count, ingested_at) by account_id
}

.create async ifnotexists materialized-view with (backfill = true, folder = 'views') TxnMonitor5m on table TxnMonitor
{
    TxnMonitor
    | where decline_pct between (0.0 .. 100.0)
    | summarize readings = count(), avg_decline_pct = avg(decline_pct), max_decline_pct = max(decline_pct), min_decline_pct = min(decline_pct),
        avg_txn_value_aud = avg(txn_value_aud), avg_txn_count = avg(txn_count), breach_readings = countif(decline_pct > 30.0)
        by account_id, state, window_start = bin(event_ts, 5m)
}

.create async ifnotexists materialized-view with (backfill = true, folder = 'views') FraudSignal5m on table FraudSignal
{
    FraudSignal
    | summarize alerts = count(), critical = countif(severity == 'CRITICAL')
        by state, alert_code, window_start = bin(event_ts, 5m)
}

// 3. DETECTION FUNCTIONS
// Every function anchors on the newest event, not now(), so it works on a live stream and on an uploaded
// sample file. For live operations call them with a short lookback, e.g. TxnMonitorBreaches(30m).
// Fault values (999.9) and anything outside 0..100 % are excluded from the breach, frozen and anomaly checks.

.create-or-alter function with (folder = 'detect', docstring = 'Declined transaction rate above the threshold') TxnMonitorBreaches(lookback: timespan = 6h, threshold: real = real(30.0))
{
    let _end = toscalar(TxnMonitor | summarize max(event_ts));
    TxnMonitor
    | where event_ts > _end - lookback
    | where decline_pct between (0.0 .. 100.0) and decline_pct > threshold
    | summarize first_seen = min(event_ts), last_seen = max(event_ts), breach_readings = count(),
        peak_decline_pct = max(decline_pct) by account_id, state
    | order by peak_decline_pct desc
}

.create-or-alter function with (folder = 'detect', docstring = 'Stuck sensors: no variation in decline_pct across a window') TxnMonitorFrozen(lookback: timespan = 6h, window: timespan = 30m)
{
    let _end = toscalar(TxnMonitor | summarize max(event_ts));
    TxnMonitor
    | where event_ts > _end - lookback
    | where decline_pct between (0.0 .. 100.0)
    | summarize readings = count(), sd = stdev(decline_pct), stuck_value = avg(decline_pct)
        by account_id, state, window_start = bin(event_ts, window)
    | where readings >= toint(window / 1m * 2 / 3) and sd < 0.001
    | summarize first_window = min(window_start), last_window = max(window_start), frozen_windows = count(),
        stuck_value = take_any(stuck_value) by account_id, state
}

.create-or-alter function with (folder = 'detect', docstring = 'Bursts of fraud signals in one state') FraudSignalBursts(lookback: timespan = 6h, window: timespan = 10m, min_alerts: int = 5)
{
    let _end = toscalar(FraudSignal | summarize max(event_ts));
    FraudSignal
    | where event_ts > _end - lookback
    | summarize alerts = count(), accounts = dcount(account_id), codes = make_set(alert_code)
        by state, window_start = bin(event_ts, window)
    | where alerts >= min_alerts
    | order by window_start desc
}

.create-or-alter function with (folder = 'detect', docstring = 'Spikes in decline_pct against each account baseline') TxnMonitorAnomalies(lookback: timespan = 6h, sensitivity: real = 3.0)
{
    let _end = toscalar(TxnMonitor | summarize max(event_ts));
    let _start = _end - lookback;
    TxnMonitor
    | where event_ts between (_start .. _end)
    | where decline_pct between (0.0 .. 100.0)
    | make-series v = avg(decline_pct) default = real(null) on event_ts from bin(_start, 1m) to _end + 1m step 1m by account_id
    | extend v = series_fill_linear(v)
    | extend (flag, score, baseline) = series_decompose_anomalies(v, sensitivity, -1, 'linefit')
    | mv-expand event_ts to typeof(datetime), v to typeof(real), flag to typeof(int), score to typeof(real),
        baseline to typeof(real)
    | where flag == 1
    | project account_id, event_ts, decline_pct = round(v, 2), baseline = round(baseline, 2), score = round(score, 2)
}

.create-or-alter function with (folder = 'detect', docstring = 'Fault values and out-of-range readings') TxnMonitorFaults(lookback: timespan = 6h)
{
    let _end = toscalar(TxnMonitor | summarize max(event_ts));
    TxnMonitor
    | where event_ts > _end - lookback
    | where isnull(decline_pct) or decline_pct == real(999.9) or not(decline_pct between (0.0 .. 100.0))
    | summarize fault_readings = count(), first_seen = min(event_ts), last_seen = max(event_ts),
        fault_values = make_set(decline_pct) by account_id, state
}

.create-or-alter function with (folder = 'detect', docstring = 'No reading for longer than the gap') TxnMonitorSilent(gap: timespan = 10m)
{
    let _end = toscalar(TxnMonitor | summarize max(event_ts));
    TxnMonitorLatest
    | where event_ts < _end - gap
    | project account_id, state, last_reading = event_ts, silent_for = _end - event_ts
}

// Optional: join to Gold. In the KQL database add a OneLake shortcut to lh_mdf > Tables > gold > dim_account
// (keep the name). skipvalidation lets you create the function before the shortcut exists.

.create-or-alter function with (folder = 'detect', docstring = 'Breaches with account details from Gold', skipvalidation = 'true') TxnMonitorBreachesWithContext(lookback: timespan = 6h)
{
    TxnMonitorBreaches(lookback)
    | lookup kind = leftouter (external_table('dim_account')
        | project account_id = toint(account_id), account_number, account_name, product_type, risk_grade) on account_id
}

// 4. REAL-TIME DASHBOARD TILES
// One query per tile; the suggested visual is in brackets. Auto-refresh 30 s (or Continuous).
// Tiles anchor on the newest event so they also work on an uploaded sample file.
// The latency tile only shows data while events are streaming.

// ---- Tile: Accounts now by status (table)
TxnMonitorLatest
| extend status_now = case(not(decline_pct between (0.0 .. 100.0)), 'FAULT', decline_pct > 30.0, 'BREACH', decline_pct > 19.6, 'WATCH', 'NORMAL')
| summarize accounts = count() by status_now, state
| order by status_now asc

// ---- Tile: Declined transaction rate, top 5 accounts (line chart)
let _end = toscalar(TxnMonitor | summarize max(event_ts));
let top5 = TxnMonitor5m | where window_start > _end - 6h | summarize peak = max(max_decline_pct) by account_id | top 5 by peak | project account_id;
TxnMonitor5m
| where window_start > _end - 6h and account_id in (top5)
| project window_start, account_id = tostring(account_id), max_decline_pct

// ---- Tile: Threshold breaches - declined transaction rate above 30 % (table)
TxnMonitorBreaches()

// ---- Tile: Anomalies against baseline (table)
TxnMonitorAnomalies()
| summarize first_seen = min(event_ts), last_seen = max(event_ts), peak = max(decline_pct), points = count() by account_id

// ---- Tile: Frozen sensors (table)
TxnMonitorFrozen()

// ---- Tile: Fault values (table)
TxnMonitorFaults()

// ---- Tile: Fraud signals by state, 10-minute bins (column chart)
let _end = toscalar(FraudSignal | summarize max(event_ts));
FraudSignal5m
| where window_start > _end - 6h
| summarize alerts = sum(alerts) by state, window_start = bin(window_start, 10m)

// ---- Tile: Alert bursts - card testing burst (table)
FraudSignalBursts()

// ---- Tile: Average transaction value by state, 5 minutes (line chart)
let _end = toscalar(TxnMonitor | summarize max(event_ts));
TxnMonitor5m
| where window_start > _end - 6h
| summarize avg_txn_value_aud = round(avg(avg_txn_value_aud), 2) by state, window_start

// ---- Tile: Ingestion latency p95, seconds (stat)
TxnMonitor
| where ingested_at > ago(15m)
| summarize p95_latency_s = percentile((ingested_at - event_ts) / 1s, 95)

// 5. ACTIVATOR RULE SUGGESTIONS (create in Activator - not KQL commands)
// Create them from a dashboard tile (Set alert) or from an Eventstream destination.
//
// Rule: Declined transaction rate breach
//   Monitor:   TxnMonitor (Eventstream route to Activator, or the TxnMonitorBreaches dashboard tile)
//   Condition: decline_pct > 30 for 3 consecutive readings per account_id
//   Action:    Teams message to Payments; optional Power Automate flow to log a follow-up
//
// Rule: Critical fraud signal
//   Monitor:   FraudSignal
//   Condition: severity == 'CRITICAL' (codes: CARD_TESTING, IMPOSSIBLE_TRAVEL, HIGH_RISK_MCC)
//   Action:    Email and Teams to the on-call lead for the state
//
// Rule: Card testing burst
//   Monitor:   FraudSignalBursts() dashboard tile (Set alert)
//   Condition: alerts >= 5 in 10 minutes for one state
//   Action:    Teams post to the Payments channel
//
// Rule: Stuck or faulty sensor
//   Monitor:   TxnMonitorFrozen() and TxnMonitorFaults() tiles
//   Condition: any row returned
//   Action:    Teams message to the telemetry support team
//
// Rule: Telemetry stopped
//   Monitor:   TxnMonitorLatest (or TxnMonitorSilent())
//   Condition: no new reading for 10 minutes per account_id
//   Action:    Teams message to the telemetry support team
