// Lyrebird Apps (Digital natives) - Real-Time Intelligence, pack 'digital'
// Eventhouse eh_mdf_rt, KQL database eh_mdf_rt. Generated by tools/build_rti.py - edit the builder, not this file.
// Streams: usage_metric -> UsageMetric, platform_alert -> PlatformAlert (both land in RawEvents first).
// Primary metric: p95_latency_ms (p95 API latency, ms), threshold 800, fault value -1.
// Run the sections in order. Blocks are separated by blank lines: put the cursor in a block and Run
// (Shift+Enter). Every command is safe to re-run.

// 1. TABLES AND UPDATE POLICIES
// RawEvents is the streaming Bronze: every event as received, kept for 7 days (replayable from the stream).
// Update policies split it into typed tables at ingestion time - no pipeline, no notebook.

.create-merge table RawEvents (payload: dynamic)

.create-or-alter table RawEvents ingestion json mapping 'RawEventsMapping' '[{"column":"payload","Properties":{"Path":"$"}}]'

.alter-merge table RawEvents policy retention softdelete = 7d recoverability = disabled

.create-merge table UsageMetric (event_ts: datetime, tenant_id: int, cloud_region: string, p95_latency_ms: real, active_users: real, error_rate_pct: real, ingested_at: datetime)

.alter table UsageMetric policy caching hot = 31d

.alter-merge table UsageMetric policy retention softdelete = 365d

.create-merge table PlatformAlert (event_ts: datetime, alert_id: string, tenant_id: int, cloud_region: string, alert_code: string, severity: string, message: string, ingested_at: datetime)

.alter table PlatformAlert policy caching hot = 31d

.alter-merge table PlatformAlert policy retention softdelete = 365d

.create-or-alter function with (folder = 'parse', docstring = 'RawEvents -> UsageMetric') ParseUsageMetric()
{
    RawEvents
    | where tostring(payload['event_type']) == 'usage_metric'
    | project event_ts = todatetime(payload['event_ts']),
        tenant_id = toint(payload['tenant_id']),
        cloud_region = tostring(payload['cloud_region']),
        p95_latency_ms = toreal(payload['p95_latency_ms']),
        active_users = toreal(payload['active_users']),
        error_rate_pct = toreal(payload['error_rate_pct']),
        ingested_at = now()
}

.alter table UsageMetric policy update @'[{"IsEnabled": true, "Source": "RawEvents", "Query": "ParseUsageMetric()", "IsTransactional": false, "PropagateIngestionProperties": false}]'

.create-or-alter function with (folder = 'parse', docstring = 'RawEvents -> PlatformAlert') ParsePlatformAlert()
{
    RawEvents
    | where tostring(payload['event_type']) == 'platform_alert'
    | project event_ts = todatetime(payload['event_ts']),
        alert_id = tostring(payload['alert_id']),
        tenant_id = toint(payload['tenant_id']),
        cloud_region = tostring(payload['cloud_region']),
        alert_code = tostring(payload['alert_code']),
        severity = tostring(payload['severity']),
        message = tostring(payload['message']),
        ingested_at = now()
}

.alter table PlatformAlert policy update @'[{"IsEnabled": true, "Source": "RawEvents", "Query": "ParsePlatformAlert()", "IsTransactional": false, "PropagateIngestionProperties": false}]'

// 2. MATERIALIZED VIEWS
// Kept current by the engine. Backfill needs the async form; ifnotexists makes re-runs safe.
// UsageMetricLatest: the newest reading per tenant - the 'where is everything now' table.
// UsageMetric5m: 5-minute aggregates (fault values excluded). PlatformAlert5m: alert counts per 5 minutes.

.create async ifnotexists materialized-view with (backfill = true, folder = 'views') UsageMetricLatest on table UsageMetric
{
    UsageMetric
    | summarize arg_max(event_ts, cloud_region, p95_latency_ms, active_users, error_rate_pct, ingested_at) by tenant_id
}

.create async ifnotexists materialized-view with (backfill = true, folder = 'views') UsageMetric5m on table UsageMetric
{
    UsageMetric
    | where p95_latency_ms between (0.0 .. 60000.0)
    | summarize readings = count(), avg_p95_latency_ms = avg(p95_latency_ms), max_p95_latency_ms = max(p95_latency_ms), min_p95_latency_ms = min(p95_latency_ms),
        avg_active_users = avg(active_users), avg_error_rate_pct = avg(error_rate_pct), breach_readings = countif(p95_latency_ms > 800.0)
        by tenant_id, cloud_region, window_start = bin(event_ts, 5m)
}

.create async ifnotexists materialized-view with (backfill = true, folder = 'views') PlatformAlert5m on table PlatformAlert
{
    PlatformAlert
    | summarize alerts = count(), critical = countif(severity == 'CRITICAL')
        by cloud_region, alert_code, window_start = bin(event_ts, 5m)
}

// 3. DETECTION FUNCTIONS
// Every function anchors on the newest event, not now(), so it works on a live stream and on an uploaded
// sample file. For live operations call them with a short lookback, e.g. UsageMetricBreaches(30m).
// Fault values (-1) and anything outside 0..60000 ms are excluded from the breach, frozen and anomaly checks.

.create-or-alter function with (folder = 'detect', docstring = 'P95 API latency above the threshold') UsageMetricBreaches(lookback: timespan = 6h, threshold: real = real(800.0))
{
    let _end = toscalar(UsageMetric | summarize max(event_ts));
    UsageMetric
    | where event_ts > _end - lookback
    | where p95_latency_ms between (0.0 .. 60000.0) and p95_latency_ms > threshold
    | summarize first_seen = min(event_ts), last_seen = max(event_ts), breach_readings = count(),
        peak_p95_latency_ms = max(p95_latency_ms) by tenant_id, cloud_region
    | order by peak_p95_latency_ms desc
}

.create-or-alter function with (folder = 'detect', docstring = 'Stuck sensors: no variation in p95_latency_ms across a window') UsageMetricFrozen(lookback: timespan = 6h, window: timespan = 30m)
{
    let _end = toscalar(UsageMetric | summarize max(event_ts));
    UsageMetric
    | where event_ts > _end - lookback
    | where p95_latency_ms between (0.0 .. 60000.0)
    | summarize readings = count(), sd = stdev(p95_latency_ms), stuck_value = avg(p95_latency_ms)
        by tenant_id, cloud_region, window_start = bin(event_ts, window)
    | where readings >= toint(window / 1m * 2 / 3) and sd < 0.001
    | summarize first_window = min(window_start), last_window = max(window_start), frozen_windows = count(),
        stuck_value = take_any(stuck_value) by tenant_id, cloud_region
}

.create-or-alter function with (folder = 'detect', docstring = 'Bursts of platform alerts in one cloud region') PlatformAlertBursts(lookback: timespan = 6h, window: timespan = 10m, min_alerts: int = 5)
{
    let _end = toscalar(PlatformAlert | summarize max(event_ts));
    PlatformAlert
    | where event_ts > _end - lookback
    | summarize alerts = count(), tenants = dcount(tenant_id), codes = make_set(alert_code)
        by cloud_region, window_start = bin(event_ts, window)
    | where alerts >= min_alerts
    | order by window_start desc
}

.create-or-alter function with (folder = 'detect', docstring = 'Spikes in p95_latency_ms against each tenant baseline') UsageMetricAnomalies(lookback: timespan = 6h, sensitivity: real = 3.0)
{
    let _end = toscalar(UsageMetric | summarize max(event_ts));
    let _start = _end - lookback;
    UsageMetric
    | where event_ts between (_start .. _end)
    | where p95_latency_ms between (0.0 .. 60000.0)
    | make-series v = avg(p95_latency_ms) default = real(null) on event_ts from bin(_start, 1m) to _end + 1m step 1m by tenant_id
    | extend v = series_fill_linear(v)
    | extend (flag, score, baseline) = series_decompose_anomalies(v, sensitivity, -1, 'linefit')
    | mv-expand event_ts to typeof(datetime), v to typeof(real), flag to typeof(int), score to typeof(real),
        baseline to typeof(real)
    | where flag == 1
    | project tenant_id, event_ts, p95_latency_ms = round(v, 2), baseline = round(baseline, 2), score = round(score, 2)
}

.create-or-alter function with (folder = 'detect', docstring = 'Fault values and out-of-range readings') UsageMetricFaults(lookback: timespan = 6h)
{
    let _end = toscalar(UsageMetric | summarize max(event_ts));
    UsageMetric
    | where event_ts > _end - lookback
    | where isnull(p95_latency_ms) or p95_latency_ms == real(-1.0) or not(p95_latency_ms between (0.0 .. 60000.0))
    | summarize fault_readings = count(), first_seen = min(event_ts), last_seen = max(event_ts),
        fault_values = make_set(p95_latency_ms) by tenant_id, cloud_region
}

.create-or-alter function with (folder = 'detect', docstring = 'No reading for longer than the gap') UsageMetricSilent(gap: timespan = 10m)
{
    let _end = toscalar(UsageMetric | summarize max(event_ts));
    UsageMetricLatest
    | where event_ts < _end - gap
    | project tenant_id, cloud_region, last_reading = event_ts, silent_for = _end - event_ts
}

// Optional: join to Gold. In the KQL database add a OneLake shortcut to lh_mdf > Tables > gold > dim_tenant
// (keep the name). skipvalidation lets you create the function before the shortcut exists.

.create-or-alter function with (folder = 'detect', docstring = 'Breaches with tenant details from Gold', skipvalidation = 'true') UsageMetricBreachesWithContext(lookback: timespan = 6h)
{
    UsageMetricBreaches(lookback)
    | lookup kind = leftouter (external_table('dim_tenant')
        | project tenant_id = toint(tenant_id), tenant_slug, tenant_name, plan, account_tier) on tenant_id
}

// 4. REAL-TIME DASHBOARD TILES
// One query per tile; the suggested visual is in brackets. Auto-refresh 30 s (or Continuous).
// Tiles anchor on the newest event so they also work on an uploaded sample file.
// The latency tile only shows data while events are streaming.

// ---- Tile: Tenants now by status (table)
UsageMetricLatest
| extend status_now = case(not(p95_latency_ms between (0.0 .. 60000.0)), 'FAULT', p95_latency_ms > 800.0, 'BREACH', p95_latency_ms > 608.0, 'WATCH', 'NORMAL')
| summarize tenants = count() by status_now, cloud_region
| order by status_now asc

// ---- Tile: P95 API latency, top 5 tenants (line chart)
let _end = toscalar(UsageMetric | summarize max(event_ts));
let top5 = UsageMetric5m | where window_start > _end - 6h | summarize peak = max(max_p95_latency_ms) by tenant_id | top 5 by peak | project tenant_id;
UsageMetric5m
| where window_start > _end - 6h and tenant_id in (top5)
| project window_start, tenant_id = tostring(tenant_id), max_p95_latency_ms

// ---- Tile: Threshold breaches - p95 API latency above 800 ms (table)
UsageMetricBreaches()

// ---- Tile: Anomalies against baseline (table)
UsageMetricAnomalies()
| summarize first_seen = min(event_ts), last_seen = max(event_ts), peak = max(p95_latency_ms), points = count() by tenant_id

// ---- Tile: Frozen sensors (table)
UsageMetricFrozen()

// ---- Tile: Fault values (table)
UsageMetricFaults()

// ---- Tile: Platform alerts by cloud region, 10-minute bins (column chart)
let _end = toscalar(PlatformAlert | summarize max(event_ts));
PlatformAlert5m
| where window_start > _end - 6h
| summarize alerts = sum(alerts) by cloud_region, window_start = bin(window_start, 10m)

// ---- Tile: Alert bursts - bad release (table)
PlatformAlertBursts()

// ---- Tile: Average active users by cloud region, 5 minutes (line chart)
let _end = toscalar(UsageMetric | summarize max(event_ts));
UsageMetric5m
| where window_start > _end - 6h
| summarize avg_active_users = round(avg(avg_active_users), 2) by cloud_region, window_start

// ---- Tile: Ingestion latency p95, seconds (stat)
UsageMetric
| where ingested_at > ago(15m)
| summarize p95_latency_s = percentile((ingested_at - event_ts) / 1s, 95)

// 5. ACTIVATOR RULE SUGGESTIONS (create in Activator - not KQL commands)
// Create them from a dashboard tile (Set alert) or from an Eventstream destination.
//
// Rule: P95 API latency breach
//   Monitor:   UsageMetric (Eventstream route to Activator, or the UsageMetricBreaches dashboard tile)
//   Condition: p95_latency_ms > 800 for 3 consecutive readings per tenant_id
//   Action:    Teams message to Data Platform; optional Power Automate flow to log a follow-up
//
// Rule: Critical platform alert
//   Monitor:   PlatformAlert
//   Condition: severity == 'CRITICAL' (codes: API_5XX_SPIKE, LOGIN_FAILURES, PAYMENT_FAILED)
//   Action:    Email and Teams to the on-call lead for the cloud region
//
// Rule: Bad release
//   Monitor:   PlatformAlertBursts() dashboard tile (Set alert)
//   Condition: alerts >= 5 in 10 minutes for one cloud_region
//   Action:    Teams post to the Data Platform channel
//
// Rule: Stuck or faulty sensor
//   Monitor:   UsageMetricFrozen() and UsageMetricFaults() tiles
//   Condition: any row returned
//   Action:    Teams message to the telemetry support team
//
// Rule: Telemetry stopped
//   Monitor:   UsageMetricLatest (or UsageMetricSilent())
//   Condition: no new reading for 10 minutes per tenant_id
//   Action:    Teams message to the telemetry support team
