// Coastal Health Network (Healthcare) - Real-Time Intelligence, pack 'healthcare'
// Eventhouse eh_mdf_rt, KQL database eh_mdf_rt. Generated by tools/build_rti.py - edit the builder, not this file.
// Streams: ward_occupancy -> WardOccupancy, bed_alert -> BedAlert (both land in RawEvents first).
// Primary metric: occupancy_pct (bed occupancy, %), threshold 95, fault value 999.9.
// Run the sections in order. Blocks are separated by blank lines: put the cursor in a block and Run
// (Shift+Enter). Every command is safe to re-run.

// 1. TABLES AND UPDATE POLICIES
// RawEvents is the streaming Bronze: every event as received, kept for 7 days (replayable from the stream).
// Update policies split it into typed tables at ingestion time - no pipeline, no notebook.

.create-merge table RawEvents (payload: dynamic)

.create-or-alter table RawEvents ingestion json mapping 'RawEventsMapping' '[{"column":"payload","Properties":{"Path":"$"}}]'

.alter-merge table RawEvents policy retention softdelete = 7d recoverability = disabled

.create-merge table WardOccupancy (event_ts: datetime, ward_id: int, hospital: string, occupancy_pct: real, patients_waiting: real, nurses_on_shift: real, ingested_at: datetime)

.alter table WardOccupancy policy caching hot = 31d

.alter-merge table WardOccupancy policy retention softdelete = 365d

.create-merge table BedAlert (event_ts: datetime, alert_id: string, ward_id: int, hospital: string, alert_code: string, severity: string, message: string, ingested_at: datetime)

.alter table BedAlert policy caching hot = 31d

.alter-merge table BedAlert policy retention softdelete = 365d

.create-or-alter function with (folder = 'parse', docstring = 'RawEvents -> WardOccupancy') ParseWardOccupancy()
{
    RawEvents
    | where tostring(payload['event_type']) == 'ward_occupancy'
    | project event_ts = todatetime(payload['event_ts']),
        ward_id = toint(payload['ward_id']),
        hospital = tostring(payload['hospital']),
        occupancy_pct = toreal(payload['occupancy_pct']),
        patients_waiting = toreal(payload['patients_waiting']),
        nurses_on_shift = toreal(payload['nurses_on_shift']),
        ingested_at = now()
}

.alter table WardOccupancy policy update @'[{"IsEnabled": true, "Source": "RawEvents", "Query": "ParseWardOccupancy()", "IsTransactional": false, "PropagateIngestionProperties": false}]'

.create-or-alter function with (folder = 'parse', docstring = 'RawEvents -> BedAlert') ParseBedAlert()
{
    RawEvents
    | where tostring(payload['event_type']) == 'bed_alert'
    | project event_ts = todatetime(payload['event_ts']),
        alert_id = tostring(payload['alert_id']),
        ward_id = toint(payload['ward_id']),
        hospital = tostring(payload['hospital']),
        alert_code = tostring(payload['alert_code']),
        severity = tostring(payload['severity']),
        message = tostring(payload['message']),
        ingested_at = now()
}

.alter table BedAlert policy update @'[{"IsEnabled": true, "Source": "RawEvents", "Query": "ParseBedAlert()", "IsTransactional": false, "PropagateIngestionProperties": false}]'

// 2. MATERIALIZED VIEWS
// Kept current by the engine. Backfill needs the async form; ifnotexists makes re-runs safe.
// WardOccupancyLatest: the newest reading per ward - the 'where is everything now' table.
// WardOccupancy5m: 5-minute aggregates (fault values excluded). BedAlert5m: alert counts per 5 minutes.

.create async ifnotexists materialized-view with (backfill = true, folder = 'views') WardOccupancyLatest on table WardOccupancy
{
    WardOccupancy
    | summarize arg_max(event_ts, hospital, occupancy_pct, patients_waiting, nurses_on_shift, ingested_at) by ward_id
}

.create async ifnotexists materialized-view with (backfill = true, folder = 'views') WardOccupancy5m on table WardOccupancy
{
    WardOccupancy
    | where occupancy_pct between (0.0 .. 120.0)
    | summarize readings = count(), avg_occupancy_pct = avg(occupancy_pct), max_occupancy_pct = max(occupancy_pct), min_occupancy_pct = min(occupancy_pct),
        avg_patients_waiting = avg(patients_waiting), avg_nurses_on_shift = avg(nurses_on_shift), breach_readings = countif(occupancy_pct > 95.0)
        by ward_id, hospital, window_start = bin(event_ts, 5m)
}

.create async ifnotexists materialized-view with (backfill = true, folder = 'views') BedAlert5m on table BedAlert
{
    BedAlert
    | summarize alerts = count(), critical = countif(severity == 'CRITICAL')
        by hospital, alert_code, window_start = bin(event_ts, 5m)
}

// 3. DETECTION FUNCTIONS
// Every function anchors on the newest event, not now(), so it works on a live stream and on an uploaded
// sample file. For live operations call them with a short lookback, e.g. WardOccupancyBreaches(30m).
// Fault values (999.9) and anything outside 0..120 % are excluded from the breach, frozen and anomaly checks.

.create-or-alter function with (folder = 'detect', docstring = 'Bed occupancy above the threshold') WardOccupancyBreaches(lookback: timespan = 6h, threshold: real = real(95.0))
{
    let _end = toscalar(WardOccupancy | summarize max(event_ts));
    WardOccupancy
    | where event_ts > _end - lookback
    | where occupancy_pct between (0.0 .. 120.0) and occupancy_pct > threshold
    | summarize first_seen = min(event_ts), last_seen = max(event_ts), breach_readings = count(),
        peak_occupancy_pct = max(occupancy_pct) by ward_id, hospital
    | order by peak_occupancy_pct desc
}

.create-or-alter function with (folder = 'detect', docstring = 'Stuck sensors: no variation in occupancy_pct across a window') WardOccupancyFrozen(lookback: timespan = 6h, window: timespan = 30m)
{
    let _end = toscalar(WardOccupancy | summarize max(event_ts));
    WardOccupancy
    | where event_ts > _end - lookback
    | where occupancy_pct between (0.0 .. 120.0)
    | summarize readings = count(), sd = stdev(occupancy_pct), stuck_value = avg(occupancy_pct)
        by ward_id, hospital, window_start = bin(event_ts, window)
    | where readings >= toint(window / 1m * 2 / 3) and sd < 0.001
    | summarize first_window = min(window_start), last_window = max(window_start), frozen_windows = count(),
        stuck_value = take_any(stuck_value) by ward_id, hospital
}

.create-or-alter function with (folder = 'detect', docstring = 'Bursts of bed alerts in one hospital') BedAlertBursts(lookback: timespan = 6h, window: timespan = 10m, min_alerts: int = 5)
{
    let _end = toscalar(BedAlert | summarize max(event_ts));
    BedAlert
    | where event_ts > _end - lookback
    | summarize alerts = count(), wards = dcount(ward_id), codes = make_set(alert_code)
        by hospital, window_start = bin(event_ts, window)
    | where alerts >= min_alerts
    | order by window_start desc
}

.create-or-alter function with (folder = 'detect', docstring = 'Spikes in occupancy_pct against each ward baseline') WardOccupancyAnomalies(lookback: timespan = 6h, sensitivity: real = 3.0)
{
    let _end = toscalar(WardOccupancy | summarize max(event_ts));
    let _start = _end - lookback;
    WardOccupancy
    | where event_ts between (_start .. _end)
    | where occupancy_pct between (0.0 .. 120.0)
    | make-series v = avg(occupancy_pct) default = real(null) on event_ts from bin(_start, 1m) to _end + 1m step 1m by ward_id
    | extend v = series_fill_linear(v)
    | extend (flag, score, baseline) = series_decompose_anomalies(v, sensitivity, -1, 'linefit')
    | mv-expand event_ts to typeof(datetime), v to typeof(real), flag to typeof(int), score to typeof(real),
        baseline to typeof(real)
    | where flag == 1
    | project ward_id, event_ts, occupancy_pct = round(v, 2), baseline = round(baseline, 2), score = round(score, 2)
}

.create-or-alter function with (folder = 'detect', docstring = 'Fault values and out-of-range readings') WardOccupancyFaults(lookback: timespan = 6h)
{
    let _end = toscalar(WardOccupancy | summarize max(event_ts));
    WardOccupancy
    | where event_ts > _end - lookback
    | where isnull(occupancy_pct) or occupancy_pct == real(999.9) or not(occupancy_pct between (0.0 .. 120.0))
    | summarize fault_readings = count(), first_seen = min(event_ts), last_seen = max(event_ts),
        fault_values = make_set(occupancy_pct) by ward_id, hospital
}

.create-or-alter function with (folder = 'detect', docstring = 'No reading for longer than the gap') WardOccupancySilent(gap: timespan = 10m)
{
    let _end = toscalar(WardOccupancy | summarize max(event_ts));
    WardOccupancyLatest
    | where event_ts < _end - gap
    | project ward_id, hospital, last_reading = event_ts, silent_for = _end - event_ts
}

// Optional: join to Gold. In the KQL database add a OneLake shortcut to lh_mdf > Tables > gold > dim_ward
// (keep the name). skipvalidation lets you create the function before the shortcut exists.

.create-or-alter function with (folder = 'detect', docstring = 'Breaches with ward details from Gold', skipvalidation = 'true') WardOccupancyBreachesWithContext(lookback: timespan = 6h)
{
    WardOccupancyBreaches(lookback)
    | lookup kind = leftouter (external_table('dim_ward')
        | project ward_id = toint(ward_id), ward_code, ward_name, ward_type, acuity_level) on ward_id
}

// 4. REAL-TIME DASHBOARD TILES
// One query per tile; the suggested visual is in brackets. Auto-refresh 30 s (or Continuous).
// Tiles anchor on the newest event so they also work on an uploaded sample file.
// The latency tile only shows data while events are streaming.

// ---- Tile: Wards now by status (table)
WardOccupancyLatest
| extend status_now = case(not(occupancy_pct between (0.0 .. 120.0)), 'FAULT', occupancy_pct > 95.0, 'BREACH', occupancy_pct > 89.8, 'WATCH', 'NORMAL')
| summarize wards = count() by status_now, hospital
| order by status_now asc

// ---- Tile: Bed occupancy, top 5 wards (line chart)
let _end = toscalar(WardOccupancy | summarize max(event_ts));
let top5 = WardOccupancy5m | where window_start > _end - 6h | summarize peak = max(max_occupancy_pct) by ward_id | top 5 by peak | project ward_id;
WardOccupancy5m
| where window_start > _end - 6h and ward_id in (top5)
| project window_start, ward_id = tostring(ward_id), max_occupancy_pct

// ---- Tile: Threshold breaches - bed occupancy above 95 % (table)
WardOccupancyBreaches()

// ---- Tile: Anomalies against baseline (table)
WardOccupancyAnomalies()
| summarize first_seen = min(event_ts), last_seen = max(event_ts), peak = max(occupancy_pct), points = count() by ward_id

// ---- Tile: Frozen sensors (table)
WardOccupancyFrozen()

// ---- Tile: Fault values (table)
WardOccupancyFaults()

// ---- Tile: Bed alerts by hospital, 10-minute bins (column chart)
let _end = toscalar(BedAlert | summarize max(event_ts));
BedAlert5m
| where window_start > _end - 6h
| summarize alerts = sum(alerts) by hospital, window_start = bin(window_start, 10m)

// ---- Tile: Alert bursts - ED surge (table)
BedAlertBursts()

// ---- Tile: Average patients waiting for a bed by hospital, 5 minutes (line chart)
let _end = toscalar(WardOccupancy | summarize max(event_ts));
WardOccupancy5m
| where window_start > _end - 6h
| summarize avg_patients_waiting = round(avg(avg_patients_waiting), 2) by hospital, window_start

// ---- Tile: Ingestion latency p95, seconds (stat)
WardOccupancy
| where ingested_at > ago(15m)
| summarize p95_latency_s = percentile((ingested_at - event_ts) / 1s, 95)

// 5. ACTIVATOR RULE SUGGESTIONS (create in Activator - not KQL commands)
// Create them from a dashboard tile (Set alert) or from an Eventstream destination.
//
// Rule: Bed occupancy breach
//   Monitor:   WardOccupancy (Eventstream route to Activator, or the WardOccupancyBreaches dashboard tile)
//   Condition: occupancy_pct > 95 for 3 consecutive readings per ward_id
//   Action:    Teams message to Patient Flow; optional Power Automate flow to log a follow-up
//
// Rule: Critical bed alert
//   Monitor:   BedAlert
//   Condition: severity == 'CRITICAL' (codes: ED_OVERCAPACITY, BED_BLOCK, CODE_BLUE)
//   Action:    Email and Teams to the on-call lead for the hospital
//
// Rule: ED surge
//   Monitor:   BedAlertBursts() dashboard tile (Set alert)
//   Condition: alerts >= 5 in 10 minutes for one hospital
//   Action:    Teams post to the Patient Flow channel
//
// Rule: Stuck or faulty sensor
//   Monitor:   WardOccupancyFrozen() and WardOccupancyFaults() tiles
//   Condition: any row returned
//   Action:    Teams message to the telemetry support team
//
// Rule: Telemetry stopped
//   Monitor:   WardOccupancyLatest (or WardOccupancySilent())
//   Condition: no new reading for 10 minutes per ward_id
//   Action:    Teams message to the telemetry support team
