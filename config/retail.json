 "gold_transform": [
  {
   "transform_id": "RT-G01",
   "industry": "retail",
   "gold_table": "dim_date",
   "run_order": 100,
   "sql_text": "SELECT CAST(date_format(d, 'yyyyMMdd') AS INT) AS date_key, d AS calendar_date, year(d) AS calendar_year, quarter(d) AS calendar_quarter, month(d) AS month_number, date_format(d, 'MMM') AS month_name, date_format(d, 'yyyy-MM') AS year_month, dayofmonth(d) AS day_of_month, date_format(d, 'EEE') AS day_name, CASE WHEN month(d) >= 7 THEN year(d) + 1 ELSE year(d) END AS fy_year, concat('FY', substring(CAST(CASE WHEN month(d) >= 7 THEN year(d) + 1 ELSE year(d) END AS STRING), 3, 2)) AS fy_label, CASE WHEN dayofweek(d) IN (1, 7) THEN true ELSE false END AS is_weekend FROM (SELECT explode(sequence(to_date('2020-01-01'), to_date('2028-12-31'), interval 1 day)) AS d) dates",
   "description": "Calendar with Australian financial year",
   "business_owner": "Data engineering",
   "consumers": "Power BI / Direct Lake, data agent",
   "active": true
  },
  {
   "transform_id": "RT-G02",
   "industry": "retail",
   "gold_table": "dim_store",
   "run_order": 110,
   "sql_text": "SELECT store_id, store_code, store_name, store_format, state, status, store_tier, weekly_sales_kaud, open_date, CAST(floor(months_between(current_date(), open_date) / 12) AS INT) AS age_years, _valid_from AS version_valid_from FROM silver.store WHERE _is_current = true",
   "description": "Current view of the store register (history stays in Silver SCD2)",
   "business_owner": "Store Operations",
   "consumers": "Power BI / Direct Lake, data agent",
   "active": true
  },
  {
   "transform_id": "RT-G03",
   "industry": "retail",
   "gold_table": "fact_stock_issue",
   "run_order": 120,
   "sql_text": "SELECT v.issue_id, v.store_id, v.issue_type, v.priority, v.status, v.raised_ts, v.resolved_ts, to_date(v.raised_ts) AS opened_date, CAST(date_format(v.raised_ts, 'yyyyMMdd') AS INT) AS opened_date_key, ROUND((unix_timestamp(v.resolved_ts) - unix_timestamp(v.raised_ts)) / 3600.0, 2) AS hours_to_close, CASE WHEN v.status IN ('RAISED', 'ACTIONING') THEN 1 ELSE 0 END AS is_open, v.lost_sales_aud, v.units_affected, d.state, d.store_format, d.store_tier FROM silver.stock_issue v LEFT JOIN silver.store d ON d.store_id = v.store_id AND d._is_current = true WHERE v._is_deleted = false",
   "description": "Stock issues with duration and store attributes",
   "business_owner": "Supply Chain",
   "consumers": "Power BI / Direct Lake, data agent",
   "active": true
  },
  {
   "transform_id": "RT-G04",
   "industry": "retail",
   "gold_table": "fact_store_trading_hourly",
   "run_order": 130,
   "sql_text": "SELECT store_id, date_trunc('HOUR', reading_ts) AS reading_hour, to_date(reading_ts) AS reading_date, CAST(date_format(reading_ts, 'yyyyMMdd') AS INT) AS reading_date_key, COUNT(*) AS readings, ROUND(AVG(out_of_stock_pct), 2) AS avg_out_of_stock_pct, ROUND(MAX(out_of_stock_pct), 2) AS max_out_of_stock_pct, ROUND(AVG(sales_aud), 2) AS avg_sales_aud, ROUND(AVG(footfall), 2) AS avg_footfall, SUM(CASE WHEN out_of_stock_pct > 8 THEN 1 ELSE 0 END) AS breach_readings FROM silver.store_trading GROUP BY store_id, date_trunc('HOUR', reading_ts), to_date(reading_ts), CAST(date_format(reading_ts, 'yyyyMMdd') AS INT)",
   "description": "Hourly store trading and availability (15-min) with threshold breaches",
   "business_owner": "Store Operations",
   "consumers": "Power BI / Direct Lake, data agent",
   "active": true
  },
  {
   "transform_id": "RT-G05",
   "industry": "retail",
   "gold_table": "store_health_scorecard",
   "run_order": 200,
   "sql_text": "WITH asat AS (SELECT MAX(to_date(raised_ts)) AS as_at FROM silver.stock_issue), ev AS (SELECT v.store_id, COUNT(*) AS stock_issues_12m, SUM(CASE WHEN v.status IN ('RAISED', 'ACTIONING') THEN 1 ELSE 0 END) AS open_stock_issues, SUM(CASE WHEN v.issue_type = 'OUT_OF_STOCK' THEN 1 ELSE 0 END) AS urgent_stock_issues_12m, ROUND(SUM(v.lost_sales_aud), 2) AS lost_sales_aud_12m FROM silver.stock_issue v CROSS JOIN asat WHERE v._is_deleted = false AND to_date(v.raised_ts) > add_months(asat.as_at, -12) GROUP BY v.store_id), rd AS (SELECT store_id, MAX(out_of_stock_pct) AS max_out_of_stock_pct, SUM(CASE WHEN out_of_stock_pct > 8 THEN 1 ELSE 0 END) AS breach_readings FROM silver.store_trading GROUP BY store_id), s AS (SELECT d.store_id, d.store_code, d.store_name, d.store_format, d.state, d.status, d.store_tier, COALESCE(ev.stock_issues_12m, 0) AS stock_issues_12m, COALESCE(ev.open_stock_issues, 0) AS open_stock_issues, COALESCE(ev.urgent_stock_issues_12m, 0) AS urgent_stock_issues_12m, COALESCE(ev.lost_sales_aud_12m, 0) AS lost_sales_aud_12m, rd.max_out_of_stock_pct, COALESCE(rd.breach_readings, 0) AS breach_readings, d.weekly_sales_kaud FROM silver.store d LEFT JOIN ev ON ev.store_id = d.store_id LEFT JOIN rd ON rd.store_id = d.store_id WHERE d._is_current = true) SELECT s.*, ROUND(LEAST(100, COALESCE(s.store_tier, 1) * 8 + s.open_stock_issues * 6 + s.urgent_stock_issues_12m * 4 + LEAST(s.breach_readings, 20) * 1.5), 1) AS risk_score, CASE WHEN LEAST(100, COALESCE(s.store_tier, 1) * 8 + s.open_stock_issues * 6 + s.urgent_stock_issues_12m * 4 + LEAST(s.breach_readings, 20) * 1.5) >= 60 THEN 'High' WHEN LEAST(100, COALESCE(s.store_tier, 1) * 8 + s.open_stock_issues * 6 + s.urgent_stock_issues_12m * 4 + LEAST(s.breach_readings, 20) * 1.5) >= 35 THEN 'Medium' ELSE 'Low' END AS risk_band, ROUND(s.open_stock_issues * 1800 + LEAST(s.breach_readings, 20) * 900 + COALESCE(s.weekly_sales_kaud, 0) * COALESCE(s.store_tier, 1) * 1, 0) AS lost_sales_at_risk_aud FROM s",
   "description": "Store risk score - stock issues, urgent work and out-of-stock lines breaches, plus lost sales at risk in AUD (weights and dollar rates are illustrative: $1,800 per open stock issue + $900 per 15-min window above 8% out-of-stock + weekly sales (k) x store tier x $1)",
   "business_owner": "Store Operations",
   "consumers": "Power BI / Direct Lake, data agent",
   "active": true
  },
  {
   "transform_id": "RT-G06",
   "industry": "retail",
   "gold_table": "loyalty_member_summary",
   "run_order": 210,
   "sql_text": "SELECT state, tier, COUNT(*) AS loyalty_members, SUM(CASE WHEN status = 'Active' THEN 1 ELSE 0 END) AS active_loyalty_members, ROUND(AVG(year(current_date()) - birth_year), 1) AS avg_age, COUNT(DISTINCT store_id) AS linked_stores FROM silver.loyalty_member WHERE _is_deleted = false GROUP BY state, tier",
   "description": "Loyalty members by state and tier",
   "business_owner": "Loyalty & Marketing",
   "consumers": "Power BI / Direct Lake, data agent",
   "active": true
  }
 ],
