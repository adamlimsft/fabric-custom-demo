 "gold_transform": [
  {
   "transform_id": "GV-G01",
   "industry": "government",
   "gold_table": "dim_date",
   "run_order": 100,
   "sql_text": "SELECT CAST(date_format(d, 'yyyyMMdd') AS INT) AS date_key, d AS calendar_date, year(d) AS calendar_year, quarter(d) AS calendar_quarter, month(d) AS month_number, date_format(d, 'MMM') AS month_name, date_format(d, 'yyyy-MM') AS year_month, dayofmonth(d) AS day_of_month, date_format(d, 'EEE') AS day_name, CASE WHEN month(d) >= 7 THEN year(d) + 1 ELSE year(d) END AS fy_year, concat('FY', substring(CAST(CASE WHEN month(d) >= 7 THEN year(d) + 1 ELSE year(d) END AS STRING), 3, 2)) AS fy_label, CASE WHEN dayofweek(d) IN (1, 7) THEN true ELSE false END AS is_weekend FROM (SELECT explode(sequence(to_date('2020-01-01'), to_date('2028-12-31'), interval 1 day)) AS d) dates",
   "description": "Calendar with Australian financial year",
   "business_owner": "Data engineering",
   "consumers": "Power BI / Direct Lake, data agent",
   "active": true
  },
  {
   "transform_id": "GV-G02",
   "industry": "government",
   "gold_table": "dim_public_asset",
   "run_order": 110,
   "sql_text": "SELECT asset_id, asset_ref, asset_name, asset_type, district, status, criticality, replacement_value_kaud, constructed_date, CAST(floor(months_between(current_date(), constructed_date) / 12) AS INT) AS age_years, _valid_from AS version_valid_from FROM silver.public_asset WHERE _is_current = true",
   "description": "Current view of the public asset register (history stays in Silver SCD2)",
   "business_owner": "Infrastructure Services",
   "consumers": "Power BI / Direct Lake, data agent",
   "active": true
  },
  {
   "transform_id": "GV-G03",
   "industry": "government",
   "gold_table": "fact_citizen_case",
   "run_order": 120,
   "sql_text": "SELECT v.case_id, v.asset_id, v.case_type, v.priority, v.status, v.lodged_ts, v.completed_ts, to_date(v.lodged_ts) AS opened_date, CAST(date_format(v.lodged_ts, 'yyyyMMdd') AS INT) AS opened_date_key, ROUND((unix_timestamp(v.completed_ts) - unix_timestamp(v.lodged_ts)) / 3600.0, 2) AS hours_to_close, CASE WHEN v.status IN ('LODGED', 'ASSIGNED') THEN 1 ELSE 0 END AS is_open, v.cost_aud, v.crew_hours, d.district, d.asset_type, d.criticality FROM silver.citizen_case v LEFT JOIN silver.public_asset d ON d.asset_id = v.asset_id AND d._is_current = true WHERE v._is_deleted = false",
   "description": "Citizen cases with duration and public asset attributes",
   "business_owner": "Citizen Services",
   "consumers": "Power BI / Direct Lake, data agent",
   "active": true
  },
  {
   "transform_id": "GV-G04",
   "industry": "government",
   "gold_table": "fact_sensor_hourly",
   "run_order": 130,
   "sql_text": "SELECT asset_id, date_trunc('HOUR', reading_ts) AS reading_hour, to_date(reading_ts) AS reading_date, CAST(date_format(reading_ts, 'yyyyMMdd') AS INT) AS reading_date_key, COUNT(*) AS readings, ROUND(AVG(water_level_cm), 2) AS avg_water_level_cm, ROUND(MAX(water_level_cm), 2) AS max_water_level_cm, ROUND(AVG(traffic_count), 2) AS avg_traffic_count, ROUND(AVG(pm25_ugm3), 2) AS avg_pm25_ugm3, SUM(CASE WHEN water_level_cm > 150 THEN 1 ELSE 0 END) AS breach_readings FROM silver.sensor_reading GROUP BY asset_id, date_trunc('HOUR', reading_ts), to_date(reading_ts), CAST(date_format(reading_ts, 'yyyyMMdd') AS INT)",
   "description": "Hourly smart infrastructure sensor readings with threshold breaches",
   "business_owner": "Smart Infrastructure",
   "consumers": "Power BI / Direct Lake, data agent",
   "active": true
  },
  {
   "transform_id": "GV-G05",
   "industry": "government",
   "gold_table": "public_asset_health_scorecard",
   "run_order": 200,
   "sql_text": "WITH asat AS (SELECT MAX(to_date(lodged_ts)) AS as_at FROM silver.citizen_case), ev AS (SELECT v.asset_id, COUNT(*) AS citizen_cases_12m, SUM(CASE WHEN v.status IN ('LODGED', 'ASSIGNED') THEN 1 ELSE 0 END) AS open_citizen_cases, SUM(CASE WHEN v.case_type = 'FLOOD_DRAINAGE' THEN 1 ELSE 0 END) AS urgent_citizen_cases_12m, ROUND(SUM(v.cost_aud), 2) AS cost_aud_12m FROM silver.citizen_case v CROSS JOIN asat WHERE v._is_deleted = false AND to_date(v.lodged_ts) > add_months(asat.as_at, -12) GROUP BY v.asset_id), rd AS (SELECT asset_id, MAX(water_level_cm) AS max_water_level_cm, SUM(CASE WHEN water_level_cm > 150 THEN 1 ELSE 0 END) AS breach_readings FROM silver.sensor_reading GROUP BY asset_id), s AS (SELECT d.asset_id, d.asset_ref, d.asset_name, d.asset_type, d.district, d.status, d.criticality, COALESCE(ev.citizen_cases_12m, 0) AS citizen_cases_12m, COALESCE(ev.open_citizen_cases, 0) AS open_citizen_cases, COALESCE(ev.urgent_citizen_cases_12m, 0) AS urgent_citizen_cases_12m, COALESCE(ev.cost_aud_12m, 0) AS cost_aud_12m, rd.max_water_level_cm, COALESCE(rd.breach_readings, 0) AS breach_readings, d.replacement_value_kaud FROM silver.public_asset d LEFT JOIN ev ON ev.asset_id = d.asset_id LEFT JOIN rd ON rd.asset_id = d.asset_id WHERE d._is_current = true) SELECT s.*, ROUND(LEAST(100, COALESCE(s.criticality, 1) * 8 + s.open_citizen_cases * 6 + s.urgent_citizen_cases_12m * 4 + LEAST(s.breach_readings, 20) * 1.5), 1) AS risk_score, CASE WHEN LEAST(100, COALESCE(s.criticality, 1) * 8 + s.open_citizen_cases * 6 + s.urgent_citizen_cases_12m * 4 + LEAST(s.breach_readings, 20) * 1.5) >= 60 THEN 'High' WHEN LEAST(100, COALESCE(s.criticality, 1) * 8 + s.open_citizen_cases * 6 + s.urgent_citizen_cases_12m * 4 + LEAST(s.breach_readings, 20) * 1.5) >= 35 THEN 'Medium' ELSE 'Low' END AS risk_band, ROUND(s.open_citizen_cases * 2500 + LEAST(s.breach_readings, 20) * 1200 + COALESCE(s.replacement_value_kaud, 0) * COALESCE(s.criticality, 1) * 0.5, 0) AS cost_at_risk_aud FROM s",
   "description": "Public asset risk score - citizen cases, urgent work and water level breaches, plus cost at risk in AUD (weights and dollar rates are illustrative: $2,500 per open case + $1,200 per 15-min window above the water-level threshold + replacement value (k) x criticality x $0.50)",
   "business_owner": "Infrastructure Services",
   "consumers": "Power BI / Direct Lake, data agent",
   "active": true
  },
  {
   "transform_id": "GV-G06",
   "industry": "government",
   "gold_table": "citizen_summary",
   "run_order": 210,
   "sql_text": "SELECT district, citizen_type, COUNT(*) AS citizens, SUM(CASE WHEN status = 'Active' THEN 1 ELSE 0 END) AS active_citizens, ROUND(AVG(year(current_date()) - birth_year), 1) AS avg_age, COUNT(DISTINCT asset_id) AS linked_public_assets FROM silver.citizen WHERE _is_deleted = false GROUP BY district, citizen_type",
   "description": "Citizens by district and citizen_type",
   "business_owner": "Citizen Services",
   "consumers": "Power BI / Direct Lake, data agent",
   "active": true
  }
 ],
