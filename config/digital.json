   "params": "{}",
   "severity": "fail",
   "fail_threshold_pct": 0,
   "rule_owner": "Data engineering",
   "description": "Primary key must never be null",
   "active": true
  },
  {
   "rule_id": "DN-ENT-02",
   "object_id": "DN_APP_TENANTS",
   "rule_name": "Known plan",
   "rule_category": "technical",
   "check_type": "allowed_values",
   "column_name": "plan",
   "params": "{\"values\": [\"FREE\", \"STARTER\", \"PRO\", \"BUSINESS\", \"ENTERPRISE\"]}",
   "severity": "warn",
   "fail_threshold_pct": null,
   "rule_owner": "Data engineering",
   "description": "Unknown classes are kept but flagged for the data owner",
   "active": true
  },
  {
   "rule_id": "DN-ENT-03",
   "object_id": "DN_APP_TENANTS",
   "rule_name": "account_tier between 1 and 5",
   "rule_category": "technical",
   "check_type": "range",
   "column_name": "account_tier",
   "params": "{\"min\": 1, \"max\": 5}",
   "severity": "warn",
   "fail_threshold_pct": null,
   "rule_owner": "Data engineering",
   "description": "Out-of-range ratings usually mean a keying error in the source",
   "active": true
  },
  {
   "rule_id": "DN-ENT-04",
   "object_id": "DN_APP_TENANTS",
   "rule_name": "Known status",
   "rule_category": "business",
   "check_type": "allowed_values",
   "column_name": "status",
   "params": "{\"values\": [\"ACTIVE\", \"TRIAL\", \"PAST_DUE\", \"CHURNED\"]}",
   "severity": "warn",
   "fail_threshold_pct": null,
   "rule_owner": "Customer Success",
   "description": "Status list agreed with Customer Success",
   "active": true
  },
  {
   "rule_id": "DN-EVT-01",
   "object_id": "DN_APP_SUPPORT_TICKETS",
   "rule_name": "Support ticket id present",
   "rule_category": "technical",
   "check_type": "not_null",
   "column_name": "ticket_id",
   "params": "{}",
   "severity": "fail",
   "fail_threshold_pct": 0,
   "rule_owner": "Data engineering",
   "description": "Primary key must never be null",
   "active": true
  },
  {
   "rule_id": "DN-EVT-02",
   "object_id": "DN_APP_SUPPORT_TICKETS",
   "rule_name": "Tenant exists",
   "rule_category": "technical",
   "check_type": "referential",
   "column_name": "tenant_id",
   "params": "{\"ref_table\": \"silver.tenant\", \"ref_column\": \"tenant_id\"}",
   "severity": "quarantine",
   "fail_threshold_pct": null,
   "rule_owner": "Data engineering",
   "description": "Held until the tenant arrives (late-arriving reference data), then merged automatically",
   "active": true
  },
  {
   "rule_id": "DN-EVT-03",
   "object_id": "DN_APP_SUPPORT_TICKETS",
   "rule_name": "Solved after opened",
   "rule_category": "business",
   "check_type": "expression",
   "column_name": null,
   "params": "{\"expr\": \"solved_ts IS NULL OR solved_ts >= opened_ts\"}",
   "severity": "quarantine",
   "fail_threshold_pct": null,
   "rule_owner": "Customer Support",
