 "gold_transform": [
  {
   "transform_id": "DN-G01",
   "industry": "digital",
   "gold_table": "dim_date",
   "run_order": 100,
   "sql_text": "SELECT CAST(date_format(d, 'yyyyMMdd') AS INT) AS date_key, d AS calendar_date, year(d) AS calendar_year, quarter(d) AS calendar_quarter, month(d) AS month_number, date_format(d, 'MMM') AS month_name, date_format(d, 'yyyy-MM') AS year_month, dayofmonth(d) AS day_of_month, date_format(d, 'EEE') AS day_name, CASE WHEN month(d) >= 7 THEN year(d) + 1 ELSE year(d) END AS fy_year, concat('FY', substring(CAST(CASE WHEN month(d) >= 7 THEN year(d) + 1 ELSE year(d) END AS STRING), 3, 2)) AS fy_label, CASE WHEN dayofweek(d) IN (1, 7) THEN true ELSE false END AS is_weekend FROM (SELECT explode(sequence(to_date('2020-01-01'), to_date('2028-12-31'), interval 1 day)) AS d) dates",
   "description": "Calendar with Australian financial year",
   "business_owner": "Data engineering",
   "consumers": "Power BI / Direct Lake, data agent",
   "active": true
  },
  {
   "transform_id": "DN-G02",
   "industry": "digital",
   "gold_table": "dim_tenant",
   "run_order": 110,
   "sql_text": "SELECT tenant_id, tenant_slug, tenant_name, plan, cloud_region, status, account_tier, seats, signup_date, CAST(floor(months_between(current_date(), signup_date) / 12) AS INT) AS age_years, _valid_from AS version_valid_from FROM silver.tenant WHERE _is_current = true",
   "description": "Current view of the tenant register (history stays in Silver SCD2)",
   "business_owner": "Customer Success",
   "consumers": "Power BI / Direct Lake, data agent",
   "active": true
  },
  {
   "transform_id": "DN-G03",
   "industry": "digital",
   "gold_table": "fact_support_ticket",
   "run_order": 120,
   "sql_text": "SELECT v.ticket_id, v.tenant_id, v.ticket_type, v.priority, v.status, v.opened_ts, v.solved_ts, to_date(v.opened_ts) AS opened_date, CAST(date_format(v.opened_ts, 'yyyyMMdd') AS INT) AS opened_date_key, ROUND((unix_timestamp(v.solved_ts) - unix_timestamp(v.opened_ts)) / 3600.0, 2) AS hours_to_close, CASE WHEN v.status IN ('OPEN', 'PENDING') THEN 1 ELSE 0 END AS is_open, v.credit_aud, v.agent_hours, d.cloud_region, d.plan, d.account_tier FROM silver.support_ticket v LEFT JOIN silver.tenant d ON d.tenant_id = v.tenant_id AND d._is_current = true WHERE v._is_deleted = false",
   "description": "Support tickets with duration and tenant attributes",
   "business_owner": "Customer Support",
   "consumers": "Power BI / Direct Lake, data agent",
   "active": true
  },
  {
   "transform_id": "DN-G04",
   "industry": "digital",
   "gold_table": "fact_usage_hourly",
   "run_order": 130,
   "sql_text": "SELECT tenant_id, date_trunc('HOUR', reading_ts) AS reading_hour, to_date(reading_ts) AS reading_date, CAST(date_format(reading_ts, 'yyyyMMdd') AS INT) AS reading_date_key, COUNT(*) AS readings, ROUND(AVG(p95_latency_ms), 2) AS avg_p95_latency_ms, ROUND(MAX(p95_latency_ms), 2) AS max_p95_latency_ms, ROUND(AVG(active_users), 2) AS avg_active_users, ROUND(AVG(error_rate_pct), 2) AS avg_error_rate_pct, SUM(CASE WHEN p95_latency_ms > 800 THEN 1 ELSE 0 END) AS breach_readings FROM silver.usage_metric GROUP BY tenant_id, date_trunc('HOUR', reading_ts), to_date(reading_ts), CAST(date_format(reading_ts, 'yyyyMMdd') AS INT)",
   "description": "Hourly product usage metrics with threshold breaches",
   "business_owner": "Data Platform",
   "consumers": "Power BI / Direct Lake, data agent",
   "active": true
  },
  {
   "transform_id": "DN-G05",
   "industry": "digital",
   "gold_table": "tenant_health_scorecard",
   "run_order": 200,
   "sql_text": "WITH asat AS (SELECT MAX(to_date(opened_ts)) AS as_at FROM silver.support_ticket), ev AS (SELECT v.tenant_id, COUNT(*) AS support_tickets_12m, SUM(CASE WHEN v.status IN ('OPEN', 'PENDING') THEN 1 ELSE 0 END) AS open_support_tickets, SUM(CASE WHEN v.ticket_type = 'OUTAGE' THEN 1 ELSE 0 END) AS urgent_support_tickets_12m, ROUND(SUM(v.credit_aud), 2) AS credit_aud_12m FROM silver.support_ticket v CROSS JOIN asat WHERE v._is_deleted = false AND to_date(v.opened_ts) > add_months(asat.as_at, -12) GROUP BY v.tenant_id), rd AS (SELECT tenant_id, MAX(p95_latency_ms) AS max_p95_latency_ms, SUM(CASE WHEN p95_latency_ms > 800 THEN 1 ELSE 0 END) AS breach_readings FROM silver.usage_metric GROUP BY tenant_id), s AS (SELECT d.tenant_id, d.tenant_slug, d.tenant_name, d.plan, d.cloud_region, d.status, d.account_tier, COALESCE(ev.support_tickets_12m, 0) AS support_tickets_12m, COALESCE(ev.open_support_tickets, 0) AS open_support_tickets, COALESCE(ev.urgent_support_tickets_12m, 0) AS urgent_support_tickets_12m, COALESCE(ev.credit_aud_12m, 0) AS credit_aud_12m, rd.max_p95_latency_ms, COALESCE(rd.breach_readings, 0) AS breach_readings, d.seats FROM silver.tenant d LEFT JOIN ev ON ev.tenant_id = d.tenant_id LEFT JOIN rd ON rd.tenant_id = d.tenant_id WHERE d._is_current = true) SELECT s.*, ROUND(LEAST(100, COALESCE(s.account_tier, 1) * 8 + s.open_support_tickets * 6 + s.urgent_support_tickets_12m * 4 + LEAST(s.breach_readings, 20) * 1.5), 1) AS risk_score, CASE WHEN LEAST(100, COALESCE(s.account_tier, 1) * 8 + s.open_support_tickets * 6 + s.urgent_support_tickets_12m * 4 + LEAST(s.breach_readings, 20) * 1.5) >= 60 THEN 'High' WHEN LEAST(100, COALESCE(s.account_tier, 1) * 8 + s.open_support_tickets * 6 + s.urgent_support_tickets_12m * 4 + LEAST(s.breach_readings, 20) * 1.5) >= 35 THEN 'Medium' ELSE 'Low' END AS risk_band, ROUND(s.open_support_tickets * 1500 + LEAST(s.breach_readings, 20) * 400 + COALESCE(s.seats, 0) * COALESCE(s.account_tier, 1) * 12, 0) AS arr_at_risk_aud FROM s",
   "description": "Tenant risk score - support tickets, urgent work and p95 API latency breaches, plus ARR at risk in AUD (weights and dollar rates are illustrative: $1,500 per open ticket + $400 per slow 15-min window + seats x account tier x $12)",
   "business_owner": "Customer Success",
   "consumers": "Power BI / Direct Lake, data agent",
   "active": true
  },
  {
   "transform_id": "DN-G06",
   "industry": "digital",
   "gold_table": "app_user_summary",
   "run_order": 210,
   "sql_text": "SELECT cloud_region, user_role, COUNT(*) AS app_users, SUM(CASE WHEN status = 'Active' THEN 1 ELSE 0 END) AS active_app_users, ROUND(AVG(year(current_date()) - birth_year), 1) AS avg_age, COUNT(DISTINCT tenant_id) AS linked_tenants FROM silver.app_user WHERE _is_deleted = false GROUP BY cloud_region, user_role",
   "description": "App users by cloud region and user_role",
   "business_owner": "Growth",
   "consumers": "Power BI / Direct Lake, data agent",
   "active": true
  }
 ],
