   "active": true
  },
  {
   "rule_id": "DN-EVT-05",
   "object_id": "DN_APP_SUPPORT_TICKETS",
   "rule_name": "OUTAGE is priority 1",
   "rule_category": "business",
   "check_type": "expression",
   "column_name": null,
   "params": "{\"expr\": \"ticket_type <> 'OUTAGE' OR priority = 1\"}",
   "severity": "warn",
   "fail_threshold_pct": null,
   "rule_owner": "Customer Support",
   "description": "Outage support tickets must be raised as priority 1",
   "active": true
  },
  {
   "rule_id": "DN-EVT-06",
   "object_id": "DN_APP_SUPPORT_TICKETS",
   "rule_name": "opened_ts parses",
   "rule_category": "technical",
   "check_type": "not_null",
   "column_name": "opened_ts",
