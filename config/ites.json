 "gold_transform": [
  {
   "transform_id": "IT-G01",
   "industry": "ites",
   "gold_table": "dim_date",
   "run_order": 100,
   "sql_text": "SELECT CAST(date_format(d, 'yyyyMMdd') AS INT) AS date_key, d AS calendar_date, year(d) AS calendar_year, quarter(d) AS calendar_quarter, month(d) AS month_number, date_format(d, 'MMM') AS month_name, date_format(d, 'yyyy-MM') AS year_month, dayofmonth(d) AS day_of_month, date_format(d, 'EEE') AS day_name, CASE WHEN month(d) >= 7 THEN year(d) + 1 ELSE year(d) END AS fy_year, concat('FY', substring(CAST(CASE WHEN month(d) >= 7 THEN year(d) + 1 ELSE year(d) END AS STRING), 3, 2)) AS fy_label, CASE WHEN dayofweek(d) IN (1, 7) THEN true ELSE false END AS is_weekend FROM (SELECT explode(sequence(to_date('2020-01-01'), to_date('2028-12-31'), interval 1 day)) AS d) dates",
   "description": "Calendar with Australian financial year",
   "business_owner": "Data engineering",
   "consumers": "Power BI / Direct Lake, data agent",
   "active": true
  },
  {
   "transform_id": "IT-G02",
   "industry": "ites",
   "gold_table": "dim_client_service",
   "run_order": 110,
   "sql_text": "SELECT service_id, contract_ref, service_name, service_line, delivery_centre, status, sla_tier, monthly_fee_aud, contract_start, CAST(floor(months_between(current_date(), contract_start) / 12) AS INT) AS age_years, _valid_from AS version_valid_from FROM silver.client_service WHERE _is_current = true",
   "description": "Current view of the client service register (history stays in Silver SCD2)",
   "business_owner": "Service Delivery",
   "consumers": "Power BI / Direct Lake, data agent",
   "active": true
  },
  {
   "transform_id": "IT-G03",
   "industry": "ites",
   "gold_table": "fact_incident",
   "run_order": 120,
   "sql_text": "SELECT v.incident_id, v.service_id, v.category, v.priority, v.status, v.opened_ts, v.resolved_ts, to_date(v.opened_ts) AS opened_date, CAST(date_format(v.opened_ts, 'yyyyMMdd') AS INT) AS opened_date_key, ROUND((unix_timestamp(v.resolved_ts) - unix_timestamp(v.opened_ts)) / 3600.0, 2) AS hours_to_close, CASE WHEN v.status IN ('NEW', 'IN_PROGRESS') THEN 1 ELSE 0 END AS is_open, v.sla_penalty_aud, v.effort_hours, d.delivery_centre, d.service_line, d.sla_tier FROM silver.incident v LEFT JOIN silver.client_service d ON d.service_id = v.service_id AND d._is_current = true WHERE v._is_deleted = false",
   "description": "Incidents with duration and client service attributes",
   "business_owner": "Service Delivery",
   "consumers": "Power BI / Direct Lake, data agent",
   "active": true
  },
  {
   "transform_id": "IT-G04",
   "industry": "ites",
   "gold_table": "fact_service_perf_hourly",
   "run_order": 130,
   "sql_text": "SELECT service_id, date_trunc('HOUR', reading_ts) AS reading_hour, to_date(reading_ts) AS reading_date, CAST(date_format(reading_ts, 'yyyyMMdd') AS INT) AS reading_date_key, COUNT(*) AS readings, ROUND(AVG(p95_response_ms), 2) AS avg_p95_response_ms, ROUND(MAX(p95_response_ms), 2) AS max_p95_response_ms, ROUND(AVG(availability_pct), 2) AS avg_availability_pct, ROUND(AVG(ticket_backlog), 2) AS avg_ticket_backlog, SUM(CASE WHEN p95_response_ms > 2500 THEN 1 ELSE 0 END) AS breach_readings FROM silver.service_metric GROUP BY service_id, date_trunc('HOUR', reading_ts), to_date(reading_ts), CAST(date_format(reading_ts, 'yyyyMMdd') AS INT)",
   "description": "Hourly service performance (15-min) with threshold breaches",
   "business_owner": "Service Assurance",
   "consumers": "Power BI / Direct Lake, data agent",
   "active": true
  },
  {
   "transform_id": "IT-G05",
   "industry": "ites",
   "gold_table": "client_service_health_scorecard",
   "run_order": 200,
   "sql_text": "WITH asat AS (SELECT MAX(to_date(opened_ts)) AS as_at FROM silver.incident), ev AS (SELECT v.service_id, COUNT(*) AS incidents_12m, SUM(CASE WHEN v.status IN ('NEW', 'IN_PROGRESS') THEN 1 ELSE 0 END) AS open_incidents, SUM(CASE WHEN v.category = 'OUTAGE' THEN 1 ELSE 0 END) AS urgent_incidents_12m, ROUND(SUM(v.sla_penalty_aud), 2) AS sla_penalty_aud_12m FROM silver.incident v CROSS JOIN asat WHERE v._is_deleted = false AND to_date(v.opened_ts) > add_months(asat.as_at, -12) GROUP BY v.service_id), rd AS (SELECT service_id, MAX(p95_response_ms) AS max_p95_response_ms, SUM(CASE WHEN p95_response_ms > 2500 THEN 1 ELSE 0 END) AS breach_readings FROM silver.service_metric GROUP BY service_id), s AS (SELECT d.service_id, d.contract_ref, d.service_name, d.service_line, d.delivery_centre, d.status, d.sla_tier, COALESCE(ev.incidents_12m, 0) AS incidents_12m, COALESCE(ev.open_incidents, 0) AS open_incidents, COALESCE(ev.urgent_incidents_12m, 0) AS urgent_incidents_12m, COALESCE(ev.sla_penalty_aud_12m, 0) AS sla_penalty_aud_12m, rd.max_p95_response_ms, COALESCE(rd.breach_readings, 0) AS breach_readings, d.monthly_fee_aud FROM silver.client_service d LEFT JOIN ev ON ev.service_id = d.service_id LEFT JOIN rd ON rd.service_id = d.service_id WHERE d._is_current = true) SELECT s.*, ROUND(LEAST(100, COALESCE(s.sla_tier, 1) * 8 + s.open_incidents * 6 + s.urgent_incidents_12m * 4 + LEAST(s.breach_readings, 20) * 1.5), 1) AS risk_score, CASE WHEN LEAST(100, COALESCE(s.sla_tier, 1) * 8 + s.open_incidents * 6 + s.urgent_incidents_12m * 4 + LEAST(s.breach_readings, 20) * 1.5) >= 60 THEN 'High' WHEN LEAST(100, COALESCE(s.sla_tier, 1) * 8 + s.open_incidents * 6 + s.urgent_incidents_12m * 4 + LEAST(s.breach_readings, 20) * 1.5) >= 35 THEN 'Medium' ELSE 'Low' END AS risk_band, ROUND(s.open_incidents * 2000 + LEAST(s.breach_readings, 20) * 500 + COALESCE(s.monthly_fee_aud, 0) * COALESCE(s.sla_tier, 1) * 0.01, 0) AS revenue_at_risk_aud FROM s",
   "description": "Client service risk score - incidents, urgent work and p95 response time breaches, plus contract revenue at risk in AUD (weights and dollar rates are illustrative: $2,000 SLA penalty exposure per open incident + $500 per slow 15-min window + monthly fee x SLA tier x 1%)",
   "business_owner": "Service Delivery",
   "consumers": "Power BI / Direct Lake, data agent",
   "active": true
  },
  {
   "transform_id": "IT-G06",
   "industry": "ites",
   "gold_table": "client_contact_summary",
   "run_order": 210,
   "sql_text": "SELECT delivery_centre, contact_role, COUNT(*) AS client_contacts, SUM(CASE WHEN status = 'Active' THEN 1 ELSE 0 END) AS active_client_contacts, ROUND(AVG(year(current_date()) - birth_year), 1) AS avg_age, COUNT(DISTINCT service_id) AS linked_client_services FROM silver.client_contact WHERE _is_deleted = false GROUP BY delivery_centre, contact_role",
   "description": "Client contacts by delivery centre and contact_role",
   "business_owner": "Client Services",
   "consumers": "Power BI / Direct Lake, data agent",
   "active": true
  }
 ],
