   "sql_text": "WITH ev AS (SELECT d.delivery_centre, to_date(v.opened_ts) AS obs_date, COUNT(*) AS incidents, SUM(CASE WHEN v.category = 'OUTAGE' THEN 1 ELSE 0 END) AS urgent_incidents FROM silver.incident v JOIN silver.client_service d ON d.service_id = v.service_id AND d._is_current = true WHERE v._is_deleted = false GROUP BY d.delivery_centre, to_date(v.opened_ts)) SELECT x.delivery_centre, x.obs_date, x.changes_scheduled, x.emergency_changes, x.patching_hours, x.change_risk, COALESCE(ev.incidents, 0) AS incidents, COALESCE(ev.urgent_incidents, 0) AS urgent_incidents FROM silver.change_window x LEFT JOIN ev ON ev.delivery_centre = x.delivery_centre AND ev.obs_date = x.obs_date WHERE x._is_deleted = false",
