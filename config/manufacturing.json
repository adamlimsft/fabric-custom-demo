   "sql_text": "WITH ev AS (SELECT d.plant, to_date(v.reported_ts) AS obs_date, COUNT(*) AS maintenance_orders, SUM(CASE WHEN v.mo_type = 'BREAKDOWN' THEN 1 ELSE 0 END) AS urgent_maintenance_orders FROM silver.maintenance_order v JOIN silver.machine d ON d.machine_id = v.machine_id AND d._is_current = true WHERE v._is_deleted = false GROUP BY d.plant, to_date(v.reported_ts)) SELECT x.plant, x.obs_date, x.avg_price_mwh, x.peak_price_mwh, x.max_temp_c, x.price_band, COALESCE(ev.maintenance_orders, 0) AS maintenance_orders, COALESCE(ev.urgent_maintenance_orders, 0) AS urgent_maintenance_orders FROM silver.energy_price x LEFT JOIN ev ON ev.plant = x.plant AND ev.obs_date = x.obs_date WHERE x._is_deleted = false",
