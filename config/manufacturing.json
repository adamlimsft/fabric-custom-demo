 "gold_transform": [
  {
   "transform_id": "MF-G01",
   "industry": "manufacturing",
   "gold_table": "dim_date",
   "run_order": 100,
   "sql_text": "SELECT CAST(date_format(d, 'yyyyMMdd') AS INT) AS date_key, d AS calendar_date, year(d) AS calendar_year, quarter(d) AS calendar_quarter, month(d) AS month_number, date_format(d, 'MMM') AS month_name, date_format(d, 'yyyy-MM') AS year_month, dayofmonth(d) AS day_of_month, date_format(d, 'EEE') AS day_name, CASE WHEN month(d) >= 7 THEN year(d) + 1 ELSE year(d) END AS fy_year, concat('FY', substring(CAST(CASE WHEN month(d) >= 7 THEN year(d) + 1 ELSE year(d) END AS STRING), 3, 2)) AS fy_label, CASE WHEN dayofweek(d) IN (1, 7) THEN true ELSE false END AS is_weekend FROM (SELECT explode(sequence(to_date('2020-01-01'), to_date('2028-12-31'), interval 1 day)) AS d) dates",
   "description": "Calendar with Australian financial year",
   "business_owner": "Data engineering",
   "consumers": "Power BI / Direct Lake, data agent",
   "active": true
  },
  {
   "transform_id": "MF-G02",
   "industry": "manufacturing",
   "gold_table": "dim_machine",
   "run_order": 110,
   "sql_text": "SELECT machine_id, machine_code, machine_name, machine_type, plant, status, criticality, rated_units_per_hour, commissioned_date, CAST(floor(months_between(current_date(), commissioned_date) / 12) AS INT) AS age_years, _valid_from AS version_valid_from FROM silver.machine WHERE _is_current = true",
   "description": "Current view of the machine register (history stays in Silver SCD2)",
   "business_owner": "Manufacturing Engineering",
   "consumers": "Power BI / Direct Lake, data agent",
   "active": true
  },
  {
   "transform_id": "MF-G03",
   "industry": "manufacturing",
   "gold_table": "fact_maintenance_order",
   "run_order": 120,
   "sql_text": "SELECT v.mo_id, v.machine_id, v.mo_type, v.priority, v.status, v.reported_ts, v.finished_ts, to_date(v.reported_ts) AS opened_date, CAST(date_format(v.reported_ts, 'yyyyMMdd') AS INT) AS opened_date_key, ROUND((unix_timestamp(v.finished_ts) - unix_timestamp(v.reported_ts)) / 3600.0, 2) AS hours_to_close, CASE WHEN v.status IN ('OPEN', 'IN_PROGRESS') THEN 1 ELSE 0 END AS is_open, v.parts_cost_aud, v.downtime_hours, d.plant, d.machine_type, d.criticality FROM silver.maintenance_order v LEFT JOIN silver.machine d ON d.machine_id = v.machine_id AND d._is_current = true WHERE v._is_deleted = false",
   "description": "Maintenance orders with duration and machine attributes",
   "business_owner": "Maintenance",
   "consumers": "Power BI / Direct Lake, data agent",
   "active": true
  },
  {
   "transform_id": "MF-G04",
   "industry": "manufacturing",
   "gold_table": "fact_machine_telemetry_hourly",
   "run_order": 130,
   "sql_text": "SELECT machine_id, date_trunc('HOUR', reading_ts) AS reading_hour, to_date(reading_ts) AS reading_date, CAST(date_format(reading_ts, 'yyyyMMdd') AS INT) AS reading_date_key, COUNT(*) AS readings, ROUND(AVG(vibration_mm_s), 2) AS avg_vibration_mm_s, ROUND(MAX(vibration_mm_s), 2) AS max_vibration_mm_s, ROUND(AVG(units_produced), 2) AS avg_units_produced, ROUND(AVG(motor_temp_c), 2) AS avg_motor_temp_c, SUM(CASE WHEN vibration_mm_s > 7.1 THEN 1 ELSE 0 END) AS breach_readings FROM silver.machine_telemetry GROUP BY machine_id, date_trunc('HOUR', reading_ts), to_date(reading_ts), CAST(date_format(reading_ts, 'yyyyMMdd') AS INT)",
   "description": "Hourly machine telemetry with threshold breaches",
   "business_owner": "Manufacturing Engineering",
   "consumers": "Power BI / Direct Lake, data agent",
   "active": true
  },
  {
   "transform_id": "MF-G05",
   "industry": "manufacturing",
   "gold_table": "machine_health_scorecard",
   "run_order": 200,
   "sql_text": "WITH asat AS (SELECT MAX(to_date(reported_ts)) AS as_at FROM silver.maintenance_order), ev AS (SELECT v.machine_id, COUNT(*) AS maintenance_orders_12m, SUM(CASE WHEN v.status IN ('OPEN', 'IN_PROGRESS') THEN 1 ELSE 0 END) AS open_maintenance_orders, SUM(CASE WHEN v.mo_type = 'BREAKDOWN' THEN 1 ELSE 0 END) AS urgent_maintenance_orders_12m, ROUND(SUM(v.parts_cost_aud), 2) AS parts_cost_aud_12m FROM silver.maintenance_order v CROSS JOIN asat WHERE v._is_deleted = false AND to_date(v.reported_ts) > add_months(asat.as_at, -12) GROUP BY v.machine_id), rd AS (SELECT machine_id, MAX(vibration_mm_s) AS max_vibration_mm_s, SUM(CASE WHEN vibration_mm_s > 7.1 THEN 1 ELSE 0 END) AS breach_readings FROM silver.machine_telemetry GROUP BY machine_id), s AS (SELECT d.machine_id, d.machine_code, d.machine_name, d.machine_type, d.plant, d.status, d.criticality, COALESCE(ev.maintenance_orders_12m, 0) AS maintenance_orders_12m, COALESCE(ev.open_maintenance_orders, 0) AS open_maintenance_orders, COALESCE(ev.urgent_maintenance_orders_12m, 0) AS urgent_maintenance_orders_12m, COALESCE(ev.parts_cost_aud_12m, 0) AS parts_cost_aud_12m, rd.max_vibration_mm_s, COALESCE(rd.breach_readings, 0) AS breach_readings, d.rated_units_per_hour FROM silver.machine d LEFT JOIN ev ON ev.machine_id = d.machine_id LEFT JOIN rd ON rd.machine_id = d.machine_id WHERE d._is_current = true) SELECT s.*, ROUND(LEAST(100, COALESCE(s.criticality, 1) * 8 + s.open_maintenance_orders * 6 + s.urgent_maintenance_orders_12m * 4 + LEAST(s.breach_readings, 20) * 1.5), 1) AS risk_score, CASE WHEN LEAST(100, COALESCE(s.criticality, 1) * 8 + s.open_maintenance_orders * 6 + s.urgent_maintenance_orders_12m * 4 + LEAST(s.breach_readings, 20) * 1.5) >= 60 THEN 'High' WHEN LEAST(100, COALESCE(s.criticality, 1) * 8 + s.open_maintenance_orders * 6 + s.urgent_maintenance_orders_12m * 4 + LEAST(s.breach_readings, 20) * 1.5) >= 35 THEN 'Medium' ELSE 'Low' END AS risk_band, ROUND(s.open_maintenance_orders * 5000 + LEAST(s.breach_readings, 20) * 3000 + COALESCE(s.rated_units_per_hour, 0) * COALESCE(s.criticality, 1) * 2, 0) AS downtime_cost_at_risk_aud FROM s",
   "description": "Machine risk score - maintenance orders, urgent work and vibration breaches, plus downtime cost at risk in AUD (weights and dollar rates are illustrative: $5,000 per open maintenance order + $3,000 per 15-min window above the vibration limit + rated units/hour x criticality x $2)",
   "business_owner": "Manufacturing Engineering",
   "consumers": "Power BI / Direct Lake, data agent",
   "active": true
  },
  {
   "transform_id": "MF-G06",
   "industry": "manufacturing",
   "gold_table": "distributor_contact_summary",
   "run_order": 210,
   "sql_text": "SELECT plant, channel, COUNT(*) AS distributor_contacts, SUM(CASE WHEN status = 'Active' THEN 1 ELSE 0 END) AS active_distributor_contacts, ROUND(AVG(year(current_date()) - birth_year), 1) AS avg_age, COUNT(DISTINCT machine_id) AS linked_machines FROM silver.distributor_contact WHERE _is_deleted = false GROUP BY plant, channel",
   "description": "Distributor contacts by plant and channel",
   "business_owner": "Sales Operations",
   "consumers": "Power BI / Direct Lake, data agent",
   "active": true
  }
 ],
