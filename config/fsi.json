 "gold_transform": [
  {
   "transform_id": "FS-G01",
   "industry": "fsi",
   "gold_table": "dim_date",
   "run_order": 100,
   "sql_text": "SELECT CAST(date_format(d, 'yyyyMMdd') AS INT) AS date_key, d AS calendar_date, year(d) AS calendar_year, quarter(d) AS calendar_quarter, month(d) AS month_number, date_format(d, 'MMM') AS month_name, date_format(d, 'yyyy-MM') AS year_month, dayofmonth(d) AS day_of_month, date_format(d, 'EEE') AS day_name, CASE WHEN month(d) >= 7 THEN year(d) + 1 ELSE year(d) END AS fy_year, concat('FY', substring(CAST(CASE WHEN month(d) >= 7 THEN year(d) + 1 ELSE year(d) END AS STRING), 3, 2)) AS fy_label, CASE WHEN dayofweek(d) IN (1, 7) THEN true ELSE false END AS is_weekend FROM (SELECT explode(sequence(to_date('2020-01-01'), to_date('2028-12-31'), interval 1 day)) AS d) dates",
   "description": "Calendar with Australian financial year",
   "business_owner": "Data engineering",
   "consumers": "Power BI / Direct Lake, data agent",
   "active": true
  },
  {
   "transform_id": "FS-G02",
   "industry": "fsi",
   "gold_table": "dim_account",
   "run_order": 110,
   "sql_text": "SELECT account_id, account_number, account_name, product_type, state, status, risk_grade, balance_aud, open_date, CAST(floor(months_between(current_date(), open_date) / 12) AS INT) AS age_years, _valid_from AS version_valid_from FROM silver.account WHERE _is_current = true",
   "description": "Current view of the account register (history stays in Silver SCD2)",
   "business_owner": "Retail Credit Risk",
   "consumers": "Power BI / Direct Lake, data agent",
   "active": true
  },
  {
   "transform_id": "FS-G03",
   "industry": "fsi",
   "gold_table": "fact_risk_case",
   "run_order": 120,
   "sql_text": "SELECT v.case_id, v.account_id, v.case_type, v.priority, v.status, v.raised_ts, v.closed_ts, to_date(v.raised_ts) AS opened_date, CAST(date_format(v.raised_ts, 'yyyyMMdd') AS INT) AS opened_date_key, ROUND((unix_timestamp(v.closed_ts) - unix_timestamp(v.raised_ts)) / 3600.0, 2) AS hours_to_close, CASE WHEN v.status IN ('OPEN', 'INVESTIGATING') THEN 1 ELSE 0 END AS is_open, v.case_amount_aud, v.analyst_hours, d.state, d.product_type, d.risk_grade FROM silver.risk_case v LEFT JOIN silver.account d ON d.account_id = v.account_id AND d._is_current = true WHERE v._is_deleted = false",
   "description": "Risk cases with duration and account attributes",
   "business_owner": "Fraud & Collections",
   "consumers": "Power BI / Direct Lake, data agent",
   "active": true
  },
  {
   "transform_id": "FS-G04",
   "industry": "fsi",
   "gold_table": "fact_txn_monitor_hourly",
   "run_order": 130,
   "sql_text": "SELECT account_id, date_trunc('HOUR', reading_ts) AS reading_hour, to_date(reading_ts) AS reading_date, CAST(date_format(reading_ts, 'yyyyMMdd') AS INT) AS reading_date_key, COUNT(*) AS readings, ROUND(AVG(decline_pct), 2) AS avg_decline_pct, ROUND(MAX(decline_pct), 2) AS max_decline_pct, ROUND(AVG(txn_value_aud), 2) AS avg_txn_value_aud, ROUND(AVG(txn_count), 2) AS avg_txn_count, SUM(CASE WHEN decline_pct > 30 THEN 1 ELSE 0 END) AS breach_readings FROM silver.txn_monitor GROUP BY account_id, date_trunc('HOUR', reading_ts), to_date(reading_ts), CAST(date_format(reading_ts, 'yyyyMMdd') AS INT)",
   "description": "Hourly account transaction monitoring (15-min windows) with threshold breaches",
   "business_owner": "Payments",
   "consumers": "Power BI / Direct Lake, data agent",
   "active": true
  },
  {
   "transform_id": "FS-G05",
   "industry": "fsi",
   "gold_table": "account_health_scorecard",
   "run_order": 200,
   "sql_text": "WITH asat AS (SELECT MAX(to_date(raised_ts)) AS as_at FROM silver.risk_case), ev AS (SELECT v.account_id, COUNT(*) AS risk_cases_12m, SUM(CASE WHEN v.status IN ('OPEN', 'INVESTIGATING') THEN 1 ELSE 0 END) AS open_risk_cases, SUM(CASE WHEN v.case_type = 'ACCOUNT_TAKEOVER' THEN 1 ELSE 0 END) AS urgent_risk_cases_12m, ROUND(SUM(v.case_amount_aud), 2) AS case_amount_aud_12m FROM silver.risk_case v CROSS JOIN asat WHERE v._is_deleted = false AND to_date(v.raised_ts) > add_months(asat.as_at, -12) GROUP BY v.account_id), rd AS (SELECT account_id, MAX(decline_pct) AS max_decline_pct, SUM(CASE WHEN decline_pct > 30 THEN 1 ELSE 0 END) AS breach_readings FROM silver.txn_monitor GROUP BY account_id), s AS (SELECT d.account_id, d.account_number, d.account_name, d.product_type, d.state, d.status, d.risk_grade, COALESCE(ev.risk_cases_12m, 0) AS risk_cases_12m, COALESCE(ev.open_risk_cases, 0) AS open_risk_cases, COALESCE(ev.urgent_risk_cases_12m, 0) AS urgent_risk_cases_12m, COALESCE(ev.case_amount_aud_12m, 0) AS case_amount_aud_12m, rd.max_decline_pct, COALESCE(rd.breach_readings, 0) AS breach_readings, d.balance_aud FROM silver.account d LEFT JOIN ev ON ev.account_id = d.account_id LEFT JOIN rd ON rd.account_id = d.account_id WHERE d._is_current = true) SELECT s.*, ROUND(LEAST(100, COALESCE(s.risk_grade, 1) * 8 + s.open_risk_cases * 6 + s.urgent_risk_cases_12m * 4 + LEAST(s.breach_readings, 20) * 1.5), 1) AS risk_score, CASE WHEN LEAST(100, COALESCE(s.risk_grade, 1) * 8 + s.open_risk_cases * 6 + s.urgent_risk_cases_12m * 4 + LEAST(s.breach_readings, 20) * 1.5) >= 60 THEN 'High' WHEN LEAST(100, COALESCE(s.risk_grade, 1) * 8 + s.open_risk_cases * 6 + s.urgent_risk_cases_12m * 4 + LEAST(s.breach_readings, 20) * 1.5) >= 35 THEN 'Medium' ELSE 'Low' END AS risk_band, ROUND(s.open_risk_cases * 3500 + LEAST(s.breach_readings, 20) * 250 + COALESCE(s.balance_aud, 0) * COALESCE(s.risk_grade, 1) * 0.002, 0) AS expected_loss_aud FROM s",
   "description": "Account risk score - risk cases, urgent work and declined transaction rate breaches, plus expected loss in AUD (weights and dollar rates are illustrative: $3,500 per open case + $250 per suspicious 15-min window + balance x risk grade x 0.2%)",
   "business_owner": "Retail Credit Risk",
   "consumers": "Power BI / Direct Lake, data agent",
   "active": true
  },
  {
   "transform_id": "FS-G06",
   "industry": "fsi",
   "gold_table": "customer_summary",
   "run_order": 210,
   "sql_text": "SELECT state, segment, COUNT(*) AS customers, SUM(CASE WHEN status = 'Active' THEN 1 ELSE 0 END) AS active_customers, ROUND(AVG(year(current_date()) - birth_year), 1) AS avg_age, COUNT(DISTINCT account_id) AS linked_accounts FROM silver.customer WHERE _is_deleted = false GROUP BY state, segment",
   "description": "Customers by state and segment",
   "business_owner": "Customer Experience",
   "consumers": "Power BI / Direct Lake, data agent",
   "active": true
  }
 ],
