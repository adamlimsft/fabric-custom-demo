 "gold_transform": [
  {
   "transform_id": "HC-G01",
   "industry": "healthcare",
   "gold_table": "dim_date",
   "run_order": 100,
   "sql_text": "SELECT CAST(date_format(d, 'yyyyMMdd') AS INT) AS date_key, d AS calendar_date, year(d) AS calendar_year, quarter(d) AS calendar_quarter, month(d) AS month_number, date_format(d, 'MMM') AS month_name, date_format(d, 'yyyy-MM') AS year_month, dayofmonth(d) AS day_of_month, date_format(d, 'EEE') AS day_name, CASE WHEN month(d) >= 7 THEN year(d) + 1 ELSE year(d) END AS fy_year, concat('FY', substring(CAST(CASE WHEN month(d) >= 7 THEN year(d) + 1 ELSE year(d) END AS STRING), 3, 2)) AS fy_label, CASE WHEN dayofweek(d) IN (1, 7) THEN true ELSE false END AS is_weekend FROM (SELECT explode(sequence(to_date('2020-01-01'), to_date('2028-12-31'), interval 1 day)) AS d) dates",
   "description": "Calendar with Australian financial year",
   "business_owner": "Data engineering",
   "consumers": "Power BI / Direct Lake, data agent",
   "active": true
  },
  {
   "transform_id": "HC-G02",
   "industry": "healthcare",
   "gold_table": "dim_ward",
   "run_order": 110,
   "sql_text": "SELECT ward_id, ward_code, ward_name, ward_type, hospital, status, acuity_level, bed_count, opened_date, CAST(floor(months_between(current_date(), opened_date) / 12) AS INT) AS age_years, _valid_from AS version_valid_from FROM silver.ward WHERE _is_current = true",
   "description": "Current view of the ward register (history stays in Silver SCD2)",
   "business_owner": "Clinical Operations",
   "consumers": "Power BI / Direct Lake, data agent",
   "active": true
  },
  {
   "transform_id": "HC-G03",
   "industry": "healthcare",
   "gold_table": "fact_admission",
   "run_order": 120,
   "sql_text": "SELECT v.admission_id, v.ward_id, v.admission_type, v.priority, v.status, v.admit_ts, v.discharge_ts, to_date(v.admit_ts) AS opened_date, CAST(date_format(v.admit_ts, 'yyyyMMdd') AS INT) AS opened_date_key, ROUND((unix_timestamp(v.discharge_ts) - unix_timestamp(v.admit_ts)) / 3600.0, 2) AS hours_to_close, CASE WHEN v.status IN ('ADMITTED', 'IN_TREATMENT') THEN 1 ELSE 0 END AS is_open, v.episode_cost_aud, v.nursing_hours, d.hospital, d.ward_type, d.acuity_level FROM silver.admission v LEFT JOIN silver.ward d ON d.ward_id = v.ward_id AND d._is_current = true WHERE v._is_deleted = false",
   "description": "Admissions with duration and ward attributes",
   "business_owner": "Clinical Operations",
   "consumers": "Power BI / Direct Lake, data agent",
   "active": true
  },
  {
   "transform_id": "HC-G04",
   "industry": "healthcare",
   "gold_table": "fact_ward_occupancy_hourly",
   "run_order": 130,
   "sql_text": "SELECT ward_id, date_trunc('HOUR', reading_ts) AS reading_hour, to_date(reading_ts) AS reading_date, CAST(date_format(reading_ts, 'yyyyMMdd') AS INT) AS reading_date_key, COUNT(*) AS readings, ROUND(AVG(occupancy_pct), 2) AS avg_occupancy_pct, ROUND(MAX(occupancy_pct), 2) AS max_occupancy_pct, ROUND(AVG(patients_waiting), 2) AS avg_patients_waiting, ROUND(AVG(nurses_on_shift), 2) AS avg_nurses_on_shift, SUM(CASE WHEN occupancy_pct > 95 THEN 1 ELSE 0 END) AS breach_readings FROM silver.ward_occupancy GROUP BY ward_id, date_trunc('HOUR', reading_ts), to_date(reading_ts), CAST(date_format(reading_ts, 'yyyyMMdd') AS INT)",
   "description": "Hourly ward occupancy (15-min) with threshold breaches",
   "business_owner": "Patient Flow",
   "consumers": "Power BI / Direct Lake, data agent",
   "active": true
  },
  {
   "transform_id": "HC-G05",
   "industry": "healthcare",
   "gold_table": "ward_health_scorecard",
   "run_order": 200,
   "sql_text": "WITH asat AS (SELECT MAX(to_date(admit_ts)) AS as_at FROM silver.admission), ev AS (SELECT v.ward_id, COUNT(*) AS admissions_12m, SUM(CASE WHEN v.status IN ('ADMITTED', 'IN_TREATMENT') THEN 1 ELSE 0 END) AS open_admissions, SUM(CASE WHEN v.admission_type = 'EMERGENCY' THEN 1 ELSE 0 END) AS urgent_admissions_12m, ROUND(SUM(v.episode_cost_aud), 2) AS episode_cost_aud_12m FROM silver.admission v CROSS JOIN asat WHERE v._is_deleted = false AND to_date(v.admit_ts) > add_months(asat.as_at, -12) GROUP BY v.ward_id), rd AS (SELECT ward_id, MAX(occupancy_pct) AS max_occupancy_pct, SUM(CASE WHEN occupancy_pct > 95 THEN 1 ELSE 0 END) AS breach_readings FROM silver.ward_occupancy GROUP BY ward_id), s AS (SELECT d.ward_id, d.ward_code, d.ward_name, d.ward_type, d.hospital, d.status, d.acuity_level, COALESCE(ev.admissions_12m, 0) AS admissions_12m, COALESCE(ev.open_admissions, 0) AS open_admissions, COALESCE(ev.urgent_admissions_12m, 0) AS urgent_admissions_12m, COALESCE(ev.episode_cost_aud_12m, 0) AS episode_cost_aud_12m, rd.max_occupancy_pct, COALESCE(rd.breach_readings, 0) AS breach_readings, d.bed_count FROM silver.ward d LEFT JOIN ev ON ev.ward_id = d.ward_id LEFT JOIN rd ON rd.ward_id = d.ward_id WHERE d._is_current = true) SELECT s.*, ROUND(LEAST(100, COALESCE(s.acuity_level, 1) * 8 + s.open_admissions * 6 + s.urgent_admissions_12m * 4 + LEAST(s.breach_readings, 20) * 1.5), 1) AS risk_score, CASE WHEN LEAST(100, COALESCE(s.acuity_level, 1) * 8 + s.open_admissions * 6 + s.urgent_admissions_12m * 4 + LEAST(s.breach_readings, 20) * 1.5) >= 60 THEN 'High' WHEN LEAST(100, COALESCE(s.acuity_level, 1) * 8 + s.open_admissions * 6 + s.urgent_admissions_12m * 4 + LEAST(s.breach_readings, 20) * 1.5) >= 35 THEN 'Medium' ELSE 'Low' END AS risk_band, ROUND(s.open_admissions * 1500 + LEAST(s.breach_readings, 20) * 2000 + COALESCE(s.bed_count, 0) * COALESCE(s.acuity_level, 1) * 500, 0) AS access_block_cost_aud FROM s",
   "description": "Ward risk score - admissions, urgent work and bed occupancy breaches, plus access-block cost at risk in AUD (weights and dollar rates are illustrative: $1,500 per open admission + $2,000 per 15-min window above 95% occupancy + beds x acuity x $500)",
   "business_owner": "Clinical Operations",
   "consumers": "Power BI / Direct Lake, data agent",
   "active": true
  },
  {
   "transform_id": "HC-G06",
   "industry": "healthcare",
   "gold_table": "patient_summary",
   "run_order": 210,
   "sql_text": "SELECT hospital, funding_type, COUNT(*) AS patients, SUM(CASE WHEN status = 'Active' THEN 1 ELSE 0 END) AS active_patients, ROUND(AVG(year(current_date()) - birth_year), 1) AS avg_age, COUNT(DISTINCT ward_id) AS linked_wards FROM silver.patient WHERE _is_deleted = false GROUP BY hospital, funding_type",
   "description": "Patients by hospital and funding_type",
   "business_owner": "Patient Experience",
   "consumers": "Power BI / Direct Lake, data agent",
   "active": true
  }
 ],
