 "gold_transform": [
  {
   "transform_id": "TC-G01",
   "industry": "telco",
   "gold_table": "dim_date",
   "run_order": 100,
   "sql_text": "SELECT CAST(date_format(d, 'yyyyMMdd') AS INT) AS date_key, d AS calendar_date, year(d) AS calendar_year, quarter(d) AS calendar_quarter, month(d) AS month_number, date_format(d, 'MMM') AS month_name, date_format(d, 'yyyy-MM') AS year_month, dayofmonth(d) AS day_of_month, date_format(d, 'EEE') AS day_name, CASE WHEN month(d) >= 7 THEN year(d) + 1 ELSE year(d) END AS fy_year, concat('FY', substring(CAST(CASE WHEN month(d) >= 7 THEN year(d) + 1 ELSE year(d) END AS STRING), 3, 2)) AS fy_label, CASE WHEN dayofweek(d) IN (1, 7) THEN true ELSE false END AS is_weekend FROM (SELECT explode(sequence(to_date('2020-01-01'), to_date('2028-12-31'), interval 1 day)) AS d) dates",
   "description": "Calendar with Australian financial year",
   "business_owner": "Data engineering",
   "consumers": "Power BI / Direct Lake, data agent",
   "active": true
  },
  {
   "transform_id": "TC-G02",
   "industry": "telco",
   "gold_table": "dim_network_element",
   "run_order": 110,
   "sql_text": "SELECT element_id, element_code, element_name, element_type, region, status, criticality, capacity_users, install_date, CAST(floor(months_between(current_date(), install_date) / 12) AS INT) AS age_years, _valid_from AS version_valid_from FROM silver.network_element WHERE _is_current = true",
   "description": "Current view of the network element register (history stays in Silver SCD2)",
   "business_owner": "Network Engineering",
   "consumers": "Power BI / Direct Lake, data agent",
   "active": true
  },
  {
   "transform_id": "TC-G03",
   "industry": "telco",
   "gold_table": "fact_fault_ticket",
   "run_order": 120,
   "sql_text": "SELECT v.ticket_id, v.element_id, v.fault_category, v.priority, v.status, v.opened_ts, v.resolved_ts, to_date(v.opened_ts) AS opened_date, CAST(date_format(v.opened_ts, 'yyyyMMdd') AS INT) AS opened_date_key, ROUND((unix_timestamp(v.resolved_ts) - unix_timestamp(v.opened_ts)) / 3600.0, 2) AS hours_to_close, CASE WHEN v.status IN ('NEW', 'IN_PROGRESS') THEN 1 ELSE 0 END AS is_open, v.field_cost_aud, v.engineer_hours, d.region, d.element_type, d.criticality FROM silver.fault_ticket v LEFT JOIN silver.network_element d ON d.element_id = v.element_id AND d._is_current = true WHERE v._is_deleted = false",
   "description": "Fault tickets with duration and network element attributes",
   "business_owner": "Service Assurance",
   "consumers": "Power BI / Direct Lake, data agent",
   "active": true
  },
  {
   "transform_id": "TC-G04",
   "industry": "telco",
   "gold_table": "fact_cell_kpi_hourly",
   "run_order": 130,
   "sql_text": "SELECT element_id, date_trunc('HOUR', reading_ts) AS reading_hour, to_date(reading_ts) AS reading_date, CAST(date_format(reading_ts, 'yyyyMMdd') AS INT) AS reading_date_key, COUNT(*) AS readings, ROUND(AVG(prb_util_pct), 2) AS avg_prb_util_pct, ROUND(MAX(prb_util_pct), 2) AS max_prb_util_pct, ROUND(AVG(active_users), 2) AS avg_active_users, ROUND(AVG(drop_rate_pct), 2) AS avg_drop_rate_pct, SUM(CASE WHEN prb_util_pct > 90 THEN 1 ELSE 0 END) AS breach_readings FROM silver.cell_kpi GROUP BY element_id, date_trunc('HOUR', reading_ts), to_date(reading_ts), CAST(date_format(reading_ts, 'yyyyMMdd') AS INT)",
   "description": "Hourly cell KPI counters with threshold breaches",
   "business_owner": "Network Performance",
   "consumers": "Power BI / Direct Lake, data agent",
   "active": true
  },
  {
   "transform_id": "TC-G05",
   "industry": "telco",
   "gold_table": "network_element_health_scorecard",
   "run_order": 200,
   "sql_text": "WITH asat AS (SELECT MAX(to_date(opened_ts)) AS as_at FROM silver.fault_ticket), ev AS (SELECT v.element_id, COUNT(*) AS fault_tickets_12m, SUM(CASE WHEN v.status IN ('NEW', 'IN_PROGRESS') THEN 1 ELSE 0 END) AS open_fault_tickets, SUM(CASE WHEN v.fault_category = 'OUTAGE' THEN 1 ELSE 0 END) AS urgent_fault_tickets_12m, ROUND(SUM(v.field_cost_aud), 2) AS field_cost_aud_12m FROM silver.fault_ticket v CROSS JOIN asat WHERE v._is_deleted = false AND to_date(v.opened_ts) > add_months(asat.as_at, -12) GROUP BY v.element_id), rd AS (SELECT element_id, MAX(prb_util_pct) AS max_prb_util_pct, SUM(CASE WHEN prb_util_pct > 90 THEN 1 ELSE 0 END) AS breach_readings FROM silver.cell_kpi GROUP BY element_id), s AS (SELECT d.element_id, d.element_code, d.element_name, d.element_type, d.region, d.status, d.criticality, COALESCE(ev.fault_tickets_12m, 0) AS fault_tickets_12m, COALESCE(ev.open_fault_tickets, 0) AS open_fault_tickets, COALESCE(ev.urgent_fault_tickets_12m, 0) AS urgent_fault_tickets_12m, COALESCE(ev.field_cost_aud_12m, 0) AS field_cost_aud_12m, rd.max_prb_util_pct, COALESCE(rd.breach_readings, 0) AS breach_readings, d.capacity_users FROM silver.network_element d LEFT JOIN ev ON ev.element_id = d.element_id LEFT JOIN rd ON rd.element_id = d.element_id WHERE d._is_current = true) SELECT s.*, ROUND(LEAST(100, COALESCE(s.criticality, 1) * 8 + s.open_fault_tickets * 6 + s.urgent_fault_tickets_12m * 4 + LEAST(s.breach_readings, 20) * 1.5), 1) AS risk_score, CASE WHEN LEAST(100, COALESCE(s.criticality, 1) * 8 + s.open_fault_tickets * 6 + s.urgent_fault_tickets_12m * 4 + LEAST(s.breach_readings, 20) * 1.5) >= 60 THEN 'High' WHEN LEAST(100, COALESCE(s.criticality, 1) * 8 + s.open_fault_tickets * 6 + s.urgent_fault_tickets_12m * 4 + LEAST(s.breach_readings, 20) * 1.5) >= 35 THEN 'Medium' ELSE 'Low' END AS risk_band, ROUND(s.open_fault_tickets * 4000 + LEAST(s.breach_readings, 20) * 600 + COALESCE(s.capacity_users, 0) * COALESCE(s.criticality, 1) * 0.5, 0) AS revenue_at_risk_aud FROM s",
   "description": "Network element risk score - fault tickets, urgent work and PRB utilisation breaches, plus revenue at risk in AUD (weights and dollar rates are illustrative: $4,000 per open fault + $600 per congested 15-min window + capacity (users) x criticality x $0.50)",
   "business_owner": "Network Engineering",
   "consumers": "Power BI / Direct Lake, data agent",
   "active": true
  },
  {
   "transform_id": "TC-G06",
   "industry": "telco",
   "gold_table": "customer_summary",
   "run_order": 210,
   "sql_text": "SELECT region, segment, COUNT(*) AS customers, SUM(CASE WHEN status = 'Active' THEN 1 ELSE 0 END) AS active_customers, ROUND(AVG(year(current_date()) - birth_year), 1) AS avg_age, COUNT(DISTINCT element_id) AS linked_network_elements FROM silver.customer WHERE _is_deleted = false GROUP BY region, segment",
   "description": "Customers by region and segment",
   "business_owner": "Customer Operations",
   "consumers": "Power BI / Direct Lake, data agent",
   "active": true
  }
 ],
