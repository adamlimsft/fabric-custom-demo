   "active": true
  },
  {
   "rule_id": "TC-PTY-03",
   "object_id": "TC_DYN_CUSTOMERS",
   "rule_name": "Australian postcode",
   "rule_category": "technical",
   "check_type": "regex",
   "column_name": "postcode",
   "params": "{\"pattern\": \"^\\\\d{4}$\"}",
   "severity": "warn",
