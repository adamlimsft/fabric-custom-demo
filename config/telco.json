   "sql_text": "WITH ev AS (SELECT d.region, to_date(v.opened_ts) AS obs_date, COUNT(*) AS fault_tickets, SUM(CASE WHEN v.fault_category = 'OUTAGE' THEN 1 ELSE 0 END) AS urgent_fault_tickets FROM silver.fault_ticket v JOIN silver.network_element d ON d.element_id = v.element_id AND d._is_current = true WHERE v._is_deleted = false GROUP BY d.region, to_date(v.opened_ts)) SELECT x.region, x.obs_date, x.expected_crowd, x.event_hours, x.temp_sites, x.event_kind, COALESCE(ev.fault_tickets, 0) AS fault_tickets, COALESCE(ev.urgent_fault_tickets, 0) AS urgent_fault_tickets FROM silver.major_event x LEFT JOIN ev ON ev.region = x.region AND ev.obs_date = x.obs_date WHERE x._is_deleted = false",
