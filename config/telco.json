 "dq_rule": [
  {
   "rule_id": "TC-ENT-01",
   "object_id": "TC_NIMS_NETWORK_ELEMENTS",
   "rule_name": "Network element id present",
   "rule_category": "technical",
   "check_type": "not_null",
   "column_name": "element_id",
   "params": "{}",
   "severity": "fail",
   "fail_threshold_pct": 0,
   "rule_owner": "Data engineering",
   "description": "Primary key must never be null",
   "active": true
  },
  {
   "rule_id": "TC-ENT-02",
   "object_id": "TC_NIMS_NETWORK_ELEMENTS",
   "rule_name": "Known element_type",
   "rule_category": "technical",
   "check_type": "allowed_values",
   "column_name": "element_type",
   "params": "{\"values\": [\"RAN_4G\", \"RAN_5G\", \"CORE_ROUTER\", \"OLT\", \"MICROWAVE\"]}",
   "severity": "warn",
   "fail_threshold_pct": null,
   "rule_owner": "Data engineering",
   "description": "Unknown classes are kept but flagged for the data owner",
   "active": true
  },
  {
   "rule_id": "TC-ENT-03",
   "object_id": "TC_NIMS_NETWORK_ELEMENTS",
   "rule_name": "criticality between 1 and 5",
   "rule_category": "technical",
   "check_type": "range",
   "column_name": "criticality",
   "params": "{\"min\": 1, \"max\": 5}",
   "severity": "warn",
   "fail_threshold_pct": null,
   "rule_owner": "Data engineering",
   "description": "Out-of-range ratings usually mean a keying error in the source",
   "active": true
  },
  {
   "rule_id": "TC-ENT-04",
   "object_id": "TC_NIMS_NETWORK_ELEMENTS",
   "rule_name": "Known status",
   "rule_category": "business",
   "check_type": "allowed_values",
   "column_name": "status",
   "params": "{\"values\": [\"ACTIVE\", \"MAINTENANCE\", \"FAULTY\", \"DECOMMISSIONED\"]}",
   "severity": "warn",
   "fail_threshold_pct": null,
   "rule_owner": "Network Engineering",
   "description": "Status list agreed with Network Engineering",
   "active": true
  },
  {
   "rule_id": "TC-EVT-01",
   "object_id": "TC_NIMS_FAULT_TICKETS",
   "rule_name": "Fault ticket id present",
   "rule_category": "technical",
   "check_type": "not_null",
   "column_name": "ticket_id",
   "params": "{}",
   "severity": "fail",
   "fail_threshold_pct": 0,
   "rule_owner": "Data engineering",
   "description": "Primary key must never be null",
   "active": true
  },
  {
   "rule_id": "TC-EVT-02",
   "object_id": "TC_NIMS_FAULT_TICKETS",
   "rule_name": "Network element exists",
   "rule_category": "technical",
   "check_type": "referential",
   "column_name": "element_id",
   "params": "{\"ref_table\": \"silver.network_element\", \"ref_column\": \"element_id\"}",
   "severity": "quarantine",
   "fail_threshold_pct": null,
   "rule_owner": "Data engineering",
   "description": "Held until the network element arrives (late-arriving reference data), then merged automatically",
   "active": true
  },
  {
   "rule_id": "TC-EVT-03",
   "object_id": "TC_NIMS_FAULT_TICKETS",
   "rule_name": "Resolved after opened",
   "rule_category": "business",
   "check_type": "expression",
   "column_name": null,
   "params": "{\"expr\": \"resolved_ts IS NULL OR resolved_ts >= opened_ts\"}",
   "severity": "quarantine",
   "fail_threshold_pct": null,
   "rule_owner": "Service Assurance",
   "description": "A fault ticket can't be resolved before it was opened",
   "active": true
  },
  {
   "rule_id": "TC-EVT-04",
   "object_id": "TC_NIMS_FAULT_TICKETS",
   "rule_name": "field_cost_aud not negative",
   "rule_category": "technical",
   "check_type": "range",
   "column_name": "field_cost_aud",
   "params": "{\"min\": 0}",
   "severity": "warn",
   "fail_threshold_pct": null,
   "rule_owner": "Data engineering",
   "description": "Negative values are sign errors in the source extract",
   "active": true
  },
  {
   "rule_id": "TC-EVT-05",
   "object_id": "TC_NIMS_FAULT_TICKETS",
   "rule_name": "OUTAGE is priority 1",
   "rule_category": "business",
   "check_type": "expression",
   "column_name": null,
   "params": "{\"expr\": \"fault_category <> 'OUTAGE' OR priority = 1\"}",
   "severity": "warn",
   "fail_threshold_pct": null,
   "rule_owner": "Service Assurance",
   "description": "Service outage fault tickets must be raised as priority 1",
   "active": true
  },
  {
   "rule_id": "TC-EVT-06",
   "object_id": "TC_NIMS_FAULT_TICKETS",
   "rule_name": "opened_ts parses",
   "rule_category": "technical",
   "check_type": "not_null",
   "column_name": "opened_ts",
   "params": "{}",
   "severity": "fail",
   "fail_threshold_pct": 5,
   "rule_owner": "Data engineering",
   "description": "If more than 5% of timestamps fail to parse, the extract format has changed - stop the load",
   "active": true
  },
  {
   "rule_id": "TC-RDG-01",
   "object_id": "TC_OSS_CELL_KPI",
   "rule_name": "Prb utilisation plausible",
   "rule_category": "technical",
   "check_type": "range",
   "column_name": "prb_util_pct",
   "params": "{\"min\": 0, \"max\": 100}",
   "severity": "quarantine",
   "fail_threshold_pct": null,
   "rule_owner": "Data engineering",
   "description": "Sensor fault values (e.g. 999.9) are quarantined, never averaged into Gold",
   "active": true
  },
  {
   "rule_id": "TC-RDG-02",
   "object_id": "TC_OSS_CELL_KPI",
   "rule_name": "Network element known",
   "rule_category": "technical",
   "check_type": "referential",
   "column_name": "element_id",
   "params": "{\"ref_table\": \"silver.network_element\", \"ref_column\": \"element_id\"}",
   "severity": "warn",
   "fail_threshold_pct": null,
   "rule_owner": "Data engineering",
   "description": "Readings for unknown tags are flagged",
   "active": true
  },
  {
   "rule_id": "TC-RDG-03",
   "object_id": "TC_OSS_CELL_KPI",
   "rule_name": "Reading time parses",
   "rule_category": "technical",
   "check_type": "not_null",
   "column_name": "reading_ts",
   "params": "{}",
   "severity": "fail",
   "fail_threshold_pct": 5,
   "rule_owner": "Data engineering",
   "description": "Timestamp format change stops the load",
   "active": true
  },
  {
   "rule_id": "TC-PTY-01",
   "object_id": "TC_DYN_CUSTOMERS",
   "rule_name": "Customer id present",
   "rule_category": "technical",
   "check_type": "not_null",
   "column_name": "customer_id",
   "params": "{}",
   "severity": "fail",
   "fail_threshold_pct": 0,
   "rule_owner": "Data engineering",
   "description": "Primary key must never be null",
   "active": true
  },
  {
   "rule_id": "TC-PTY-02",
   "object_id": "TC_DYN_CUSTOMERS",
   "rule_name": "Email looks valid",
   "rule_category": "technical",
   "check_type": "regex",
   "column_name": "email_masked",
   "params": "{\"pattern\": \"^[^@\\\\s]+@[^@\\\\s]+\\\\.[^@\\\\s]+$\"}",
   "severity": "warn",
   "fail_threshold_pct": null,
   "rule_owner": "Data engineering",
