 "dq_rule": [
  {
   "rule_id": "EN-ENT-01",
   "object_id": "EN_EAM_ASSETS",
   "rule_name": "Asset id present",
   "rule_category": "technical",
   "check_type": "not_null",
   "column_name": "asset_id",
   "params": "{}",
   "severity": "fail",
   "fail_threshold_pct": 0,
   "rule_owner": "Data engineering",
   "description": "Primary key must never be null",
   "active": true
  },
  {
   "rule_id": "EN-ENT-02",
   "object_id": "EN_EAM_ASSETS",
   "rule_name": "Known asset_class",
   "rule_category": "technical",
   "check_type": "allowed_values",
   "column_name": "asset_class",
   "params": "{\"values\": [\"SUBSTATION\", \"TRANSFORMER\", \"CIRCUIT_BREAKER\", \"CAPACITOR_BANK\", \"TRANSMISSION_LINE\"]}",
   "severity": "warn",
   "fail_threshold_pct": null,
   "rule_owner": "Data engineering",
   "description": "Unknown classes are kept but flagged for the data owner",
   "active": true
  },
  {
   "rule_id": "EN-ENT-03",
   "object_id": "EN_EAM_ASSETS",
   "rule_name": "criticality between 1 and 5",
   "rule_category": "technical",
   "check_type": "range",
   "column_name": "criticality",
   "params": "{\"min\": 1, \"max\": 5}",
   "severity": "warn",
   "fail_threshold_pct": null,
   "rule_owner": "Data engineering",
   "description": "Out-of-range ratings usually mean a keying error in the source",
   "active": true
  },
  {
   "rule_id": "EN-ENT-04",
   "object_id": "EN_EAM_ASSETS",
   "rule_name": "Known status",
   "rule_category": "business",
   "check_type": "allowed_values",
   "column_name": "status",
   "params": "{\"values\": [\"IN_SERVICE\", \"STANDBY\", \"OUT_OF_SERVICE\", \"DECOMMISSIONED\"]}",
   "severity": "warn",
   "fail_threshold_pct": null,
   "rule_owner": "Asset Management",
   "description": "Status list agreed with Asset Management",
   "active": true
  },
  {
   "rule_id": "EN-EVT-01",
   "object_id": "EN_EAM_WORK_ORDERS",
   "rule_name": "Work order id present",
   "rule_category": "technical",
   "check_type": "not_null",
   "column_name": "wo_id",
   "params": "{}",
   "severity": "fail",
   "fail_threshold_pct": 0,
   "rule_owner": "Data engineering",
   "description": "Primary key must never be null",
   "active": true
  },
  {
   "rule_id": "EN-EVT-02",
   "object_id": "EN_EAM_WORK_ORDERS",
   "rule_name": "Asset exists",
   "rule_category": "technical",
   "check_type": "referential",
   "column_name": "asset_id",
   "params": "{\"ref_table\": \"silver.asset\", \"ref_column\": \"asset_id\"}",
   "severity": "quarantine",
   "fail_threshold_pct": null,
   "rule_owner": "Data engineering",
   "description": "Held until the asset arrives (late-arriving reference data), then merged automatically",
   "active": true
  },
  {
   "rule_id": "EN-EVT-03",
   "object_id": "EN_EAM_WORK_ORDERS",
   "rule_name": "Completed after raised",
   "rule_category": "business",
   "check_type": "expression",
   "column_name": null,
   "params": "{\"expr\": \"completed_ts IS NULL OR completed_ts >= raised_ts\"}",
   "severity": "quarantine",
   "fail_threshold_pct": null,
   "rule_owner": "Asset Management",
   "description": "A work order can't be completed before it was raised",
   "active": true
  },
  {
   "rule_id": "EN-EVT-04",
   "object_id": "EN_EAM_WORK_ORDERS",
   "rule_name": "cost_aud not negative",
   "rule_category": "technical",
   "check_type": "range",
   "column_name": "cost_aud",
   "params": "{\"min\": 0}",
   "severity": "warn",
   "fail_threshold_pct": null,
   "rule_owner": "Data engineering",
   "description": "Negative values are sign errors in the source extract",
   "active": true
  },
  {
   "rule_id": "EN-EVT-05",
   "object_id": "EN_EAM_WORK_ORDERS",
   "rule_name": "EMERG is priority 1",
   "rule_category": "business",
   "check_type": "expression",
   "column_name": null,
   "params": "{\"expr\": \"wo_type <> 'EMERG' OR priority = 1\"}",
   "severity": "warn",
   "fail_threshold_pct": null,
   "rule_owner": "Asset Management",
   "description": "Emergency work orders must be raised as priority 1",
   "active": true
  },
  {
   "rule_id": "EN-EVT-06",
   "object_id": "EN_EAM_WORK_ORDERS",
   "rule_name": "raised_ts parses",
   "rule_category": "technical",
   "check_type": "not_null",
   "column_name": "raised_ts",
   "params": "{}",
   "severity": "fail",
   "fail_threshold_pct": 5,
   "rule_owner": "Data engineering",
   "description": "If more than 5% of timestamps fail to parse, the extract format has changed - stop the load",
   "active": true
  },
  {
   "rule_id": "EN-RDG-01",
   "object_id": "EN_SCADA_TRANSFORMER_TELEMETRY",
   "rule_name": "Oil temperature plausible",
   "rule_category": "technical",
   "check_type": "range",
   "column_name": "oil_temp_c",
   "params": "{\"min\": -10, \"max\": 140}",
   "severity": "quarantine",
   "fail_threshold_pct": null,
   "rule_owner": "Data engineering",
   "description": "Sensor fault values (e.g. 999.9) are quarantined, never averaged into Gold",
   "active": true
  },
  {
   "rule_id": "EN-RDG-02",
   "object_id": "EN_SCADA_TRANSFORMER_TELEMETRY",
   "rule_name": "Asset known",
   "rule_category": "technical",
   "check_type": "referential",
   "column_name": "asset_id",
   "params": "{\"ref_table\": \"silver.asset\", \"ref_column\": \"asset_id\"}",
   "severity": "warn",
   "fail_threshold_pct": null,
   "rule_owner": "Data engineering",
   "description": "Readings for unknown tags are flagged",
   "active": true
  },
  {
   "rule_id": "EN-RDG-03",
   "object_id": "EN_SCADA_TRANSFORMER_TELEMETRY",
   "rule_name": "Reading time parses",
   "rule_category": "technical",
   "check_type": "not_null",
   "column_name": "reading_ts",
   "params": "{}",
   "severity": "fail",
   "fail_threshold_pct": 5,
   "rule_owner": "Data engineering",
   "description": "Timestamp format change stops the load",
   "active": true
  },
  {
   "rule_id": "EN-PTY-01",
   "object_id": "EN_SFDC_LANDHOLDER_CONTACTS",
   "rule_name": "Landholder id present",
   "rule_category": "technical",
   "check_type": "not_null",
   "column_name": "landholder_id",
   "params": "{}",
   "severity": "fail",
   "fail_threshold_pct": 0,
   "rule_owner": "Data engineering",
   "description": "Primary key must never be null",
