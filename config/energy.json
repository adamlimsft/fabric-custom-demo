 "gold_transform": [
  {
   "transform_id": "EN-G01",
   "industry": "energy",
   "gold_table": "dim_date",
   "run_order": 100,
   "sql_text": "SELECT CAST(date_format(d, 'yyyyMMdd') AS INT) AS date_key, d AS calendar_date, year(d) AS calendar_year, quarter(d) AS calendar_quarter, month(d) AS month_number, date_format(d, 'MMM') AS month_name, date_format(d, 'yyyy-MM') AS year_month, dayofmonth(d) AS day_of_month, date_format(d, 'EEE') AS day_name, CASE WHEN month(d) >= 7 THEN year(d) + 1 ELSE year(d) END AS fy_year, concat('FY', substring(CAST(CASE WHEN month(d) >= 7 THEN year(d) + 1 ELSE year(d) END AS STRING), 3, 2)) AS fy_label, CASE WHEN dayofweek(d) IN (1, 7) THEN true ELSE false END AS is_weekend FROM (SELECT explode(sequence(to_date('2020-01-01'), to_date('2028-12-31'), interval 1 day)) AS d) dates",
   "description": "Calendar with Australian financial year",
   "business_owner": "Data engineering",
   "consumers": "Power BI / Direct Lake, data agent",
   "active": true
  },
  {
   "transform_id": "EN-G02",
   "industry": "energy",
   "gold_table": "dim_asset",
   "run_order": 110,
   "sql_text": "SELECT asset_id, asset_tag, asset_name, asset_class, region, status, criticality, rating_mva, install_date, CAST(floor(months_between(current_date(), install_date) / 12) AS INT) AS age_years, _valid_from AS version_valid_from FROM silver.asset WHERE _is_current = true",
   "description": "Current view of the asset register (history stays in Silver SCD2)",
   "business_owner": "Asset Management",
   "consumers": "Power BI / Direct Lake, data agent",
   "active": true
  },
  {
   "transform_id": "EN-G03",
   "industry": "energy",
   "gold_table": "fact_work_order",
   "run_order": 120,
   "sql_text": "SELECT v.wo_id, v.asset_id, v.wo_type, v.priority, v.status, v.raised_ts, v.completed_ts, to_date(v.raised_ts) AS opened_date, CAST(date_format(v.raised_ts, 'yyyyMMdd') AS INT) AS opened_date_key, ROUND((unix_timestamp(v.completed_ts) - unix_timestamp(v.raised_ts)) / 3600.0, 2) AS hours_to_close, CASE WHEN v.status IN ('OPEN', 'IN_PROGRESS') THEN 1 ELSE 0 END AS is_open, v.cost_aud, v.labour_hours, d.region, d.asset_class, d.criticality FROM silver.work_order v LEFT JOIN silver.asset d ON d.asset_id = v.asset_id AND d._is_current = true WHERE v._is_deleted = false",
   "description": "Work orders with duration and asset attributes",
   "business_owner": "Asset Management",
   "consumers": "Power BI / Direct Lake, data agent",
   "active": true
  },
  {
   "transform_id": "EN-G04",
   "industry": "energy",
   "gold_table": "fact_tx_load_hourly",
   "run_order": 130,
   "sql_text": "SELECT asset_id, date_trunc('HOUR', reading_ts) AS reading_hour, to_date(reading_ts) AS reading_date, CAST(date_format(reading_ts, 'yyyyMMdd') AS INT) AS reading_date_key, COUNT(*) AS readings, ROUND(AVG(oil_temp_c), 2) AS avg_oil_temp_c, ROUND(MAX(oil_temp_c), 2) AS max_oil_temp_c, ROUND(AVG(load_mw), 2) AS avg_load_mw, ROUND(AVG(ambient_temp_c), 2) AS avg_ambient_temp_c, SUM(CASE WHEN oil_temp_c > 95 THEN 1 ELSE 0 END) AS breach_readings FROM silver.tx_telemetry GROUP BY asset_id, date_trunc('HOUR', reading_ts), to_date(reading_ts), CAST(date_format(reading_ts, 'yyyyMMdd') AS INT)",
   "description": "Hourly transformer telemetry with threshold breaches",
   "business_owner": "Network Operations",
   "consumers": "Power BI / Direct Lake, data agent",
   "active": true
  },
  {
   "transform_id": "EN-G05",
   "industry": "energy",
   "gold_table": "asset_health_scorecard",
   "run_order": 200,
   "sql_text": "WITH asat AS (SELECT MAX(to_date(raised_ts)) AS as_at FROM silver.work_order), ev AS (SELECT v.asset_id, COUNT(*) AS work_orders_12m, SUM(CASE WHEN v.status IN ('OPEN', 'IN_PROGRESS') THEN 1 ELSE 0 END) AS open_work_orders, SUM(CASE WHEN v.wo_type = 'EMERG' THEN 1 ELSE 0 END) AS urgent_work_orders_12m, ROUND(SUM(v.cost_aud), 2) AS cost_aud_12m FROM silver.work_order v CROSS JOIN asat WHERE v._is_deleted = false AND to_date(v.raised_ts) > add_months(asat.as_at, -12) GROUP BY v.asset_id), rd AS (SELECT asset_id, MAX(oil_temp_c) AS max_oil_temp_c, SUM(CASE WHEN oil_temp_c > 95 THEN 1 ELSE 0 END) AS breach_readings FROM silver.tx_telemetry GROUP BY asset_id), s AS (SELECT d.asset_id, d.asset_tag, d.asset_name, d.asset_class, d.region, d.status, d.criticality, COALESCE(ev.work_orders_12m, 0) AS work_orders_12m, COALESCE(ev.open_work_orders, 0) AS open_work_orders, COALESCE(ev.urgent_work_orders_12m, 0) AS urgent_work_orders_12m, COALESCE(ev.cost_aud_12m, 0) AS cost_aud_12m, rd.max_oil_temp_c, COALESCE(rd.breach_readings, 0) AS breach_readings, d.rating_mva FROM silver.asset d LEFT JOIN ev ON ev.asset_id = d.asset_id LEFT JOIN rd ON rd.asset_id = d.asset_id WHERE d._is_current = true) SELECT s.*, ROUND(LEAST(100, COALESCE(s.criticality, 1) * 8 + s.open_work_orders * 6 + s.urgent_work_orders_12m * 4 + LEAST(s.breach_readings, 20) * 1.5), 1) AS risk_score, CASE WHEN LEAST(100, COALESCE(s.criticality, 1) * 8 + s.open_work_orders * 6 + s.urgent_work_orders_12m * 4 + LEAST(s.breach_readings, 20) * 1.5) >= 60 THEN 'High' WHEN LEAST(100, COALESCE(s.criticality, 1) * 8 + s.open_work_orders * 6 + s.urgent_work_orders_12m * 4 + LEAST(s.breach_readings, 20) * 1.5) >= 35 THEN 'Medium' ELSE 'Low' END AS risk_band, ROUND(s.open_work_orders * 6000 + LEAST(s.breach_readings, 20) * 2500 + COALESCE(s.rating_mva, 0) * COALESCE(s.criticality, 1) * 20, 0) AS outage_cost_at_risk_aud FROM s",
   "description": "Asset risk score - work orders, urgent work and oil temperature breaches, plus outage cost at risk in AUD (weights and dollar rates are illustrative: $6,000 per open work order + $2,500 per 15-min window above the oil-temperature threshold + rating (MVA) x criticality x $20)",
   "business_owner": "Asset Management",
   "consumers": "Power BI / Direct Lake, data agent",
   "active": true
  },
  {
   "transform_id": "EN-G06",
   "industry": "energy",
   "gold_table": "landholder_summary",
   "run_order": 210,
   "sql_text": "SELECT region, landholder_type, COUNT(*) AS landholders, SUM(CASE WHEN status = 'Active' THEN 1 ELSE 0 END) AS active_landholders, ROUND(AVG(year(current_date()) - birth_year), 1) AS avg_age, COUNT(DISTINCT asset_id) AS linked_assets FROM silver.landholder WHERE _is_deleted = false GROUP BY region, landholder_type",
   "description": "Landholders by region and landholder_type",
   "business_owner": "Stakeholder Engagement",
   "consumers": "Power BI / Direct Lake, data agent",
   "active": true
  }
 ],
